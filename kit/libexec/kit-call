#!/usr/bin/env bash
# kit-call - runs one kit call in this release: checks bash, runs bin/kit-<verb>, and logs the call (executed entrypoint)
# ----------------------------------------------------------------------------------------------------------------------
# kit-call <verb> [<argument>…] is what bin/kit, the loader, runs once it has chosen this release; nothing else runs
# it. The loader has read the kit options already, so the first word is the verb. With none, it runs kit tui, the
# interactive terminal UI, on the welcome guide. It runs bin/kit-<verb> in this release, with the remaining
# arguments. Each verb sets up its own process through modules/bash/1st.sh, so it runs the same when called directly.
# kit help reads each verb's usage from its header; kit <verb> --help is the verb's page, which guard:arguments in
# modules/bash/1st.sh answers. A verb that does not exist is refused with a pointer to kit help, in the words every
# verb uses for one.
#
# The loader runs this file with the bash on PATH, which may be older than the kit needs; macOS has bash 3.2. So its
# first lines run on any bash, and refuse one older than 4.4 with the command that installs a newer one.
#
# It runs the verb as its child, not in its place, so it can write the call to .kit/logs/kit-YYYY-MMDD.log when the
# verb ends, with its exit status, which it then exits with. modules/bash/log.sh says what a line holds. The loader
# execs this file, so this process is the one timeout, a supervisor, or a closed terminal signals: it sends a TERM or
# HUP on to the verb, and the call is logged with the verb's status, 143 or 129 where the signal ended it. Ctrl-C
# reaches the verb from the terminal, which ends with it, and the call is logged with status 130.
#
# see: bin/kit, .kit/1st.md

set -o errexit -o nounset -o pipefail

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) ))
then
  install='install bash 4.4 or later'
  if command -v brew >/dev/null 2>&1
  then install='run: brew install bash'
  elif command -v apt-get >/dev/null 2>&1
  then install='run: sudo apt-get install bash'
  elif command -v dnf >/dev/null 2>&1
  then install='run: sudo dnf install bash'
  fi
  echo "❌ kit needs bash 4.4 or later; the bash on PATH, $(command -v bash), is ${BASH_VERSION}; ${install}" >&2
  exit 1
fi

# The loader names this file by its physical path, so bin/ is beside libexec/ with no link to follow.
kit_bin=$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)

verb=${1:-tui}
(( $# == 0 )) || shift
# shellcheck source=../modules/bash/log.sh
source "${kit_bin}/../modules/bash/log.sh"
started=0
log:now started
line=''
(( $# == 0 )) || printf -v line ' %q' "$@"
printf -v line 'kit %q%s' "${verb}" "${line}"
log:root root || root=${PWD}
directory=${PWD#"${root}"}
directory=${directory#/}
printf -v directory '%q' "${directory:-.}"
if [[ ! -x "${kit_bin}/kit-${verb}" ]]
then
  # The loader is sourced only to refuse: the verbs load it themselves.
  # shellcheck source=../modules/bash/1st.sh
  source "${kit_bin}/../modules/bash/1st.sh"
  guard:unknown-verb "${verb}" || true  # it always returns 2; the call is logged before the exit
  log:call kit "${started}" "pid=$$" "depth=${kit_depth:-0}" status=2 "in=${directory}" "${line}"
  exit 2
fi
# The verb runs in the background, as bash runs a trap only between commands, and a verb in the foreground would hold
# a TERM until it ended. With no job control the verb stays in this process's group, the terminal's foreground group,
# so Ctrl-C reaches it from the terminal. Its stdin is named, so it keeps the terminal rather than /dev/null. It takes
# back INT and QUIT, which bash ignores in a background child, as this process was given them: a kit started with INT
# ignored, as in the background of a script, runs a verb that ignores it too. A TERM or HUP here is sent on to the
# verb, or, when it comes before the verb has started, once it has. An INT is not, as the terminal sends it to the
# verb too. A trapped signal ends wait early, so it waits until the verb has ended, and takes its status: 128+signal
# where a signal ended it. bash keeps a child's status for each wait on it, so a wait after the verb's end, as when a
# signal comes between its end and the check, takes the same status.
verb_pid=''
pending=()
# shellcheck disable=SC2329  # the TERM and HUP traps call it
forward() {
  signaled=1
  if [[ -n "${verb_pid}" ]]
  then kill -s "$1" "${verb_pid}" 2>/dev/null || :  # the verb may have ended already
  else pending+=("$1")
  fi
}
signaled=''
trap 'forward TERM' TERM
trap 'forward HUP' HUP
trap 'signaled=1' INT
(trap - INT QUIT; exec "${kit_bin}/kit-${verb}" "$@") 0<&0 &
verb_pid=$!
for signal in "${pending[@]}"
do
  kill -s "${signal}" "${verb_pid}" 2>/dev/null || :
done
signaled=1
while [[ -n "${signaled}" ]]
do
  signaled=''
  status=0
  wait "${verb_pid}" || status=$?
done
log:call kit "${started}" "pid=$$" "depth=${kit_depth:-0}" "status=${status}" "in=${directory}" "${line}"
exit "${status}"

# ----------------------------------------------------------------------------------------------------------------------
