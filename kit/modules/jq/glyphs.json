{
  "glyphs": [
    {"name": "Workspace", "glyph": "📚", "meaning": "workspace", "more": "a group, in the workspace menu that drops down from - in kittui's title"},
    {"name": "Issue", "glyph": "🎫", "meaning": "issue", "more": "its number and title"},
    {"name": "GitHub", "glyph": "🐙", "meaning": "on GitHub",
     "more": "the forge of a remote, or the tracker that holds an issue"},
    {"name": "GitLab", "glyph": "🦊", "meaning": "on GitLab",
     "more": "the forge of a remote, or the tracker that holds an issue"},
    {"name": "Waiting", "glyph": "💤", "meaning": "backlog", "more": "an open issue no open pull request closes, nor a branch names"},
    {"name": "InFlight", "glyph": "🛫", "meaning": "underway", "more": "an issue an open pull request closes, or a branch names"},
    {"name": "Desk", "glyph": "💻", "meaning": "desk", "more": "the root checkout"},
    {"name": "Branch", "glyph": "🌿", "meaning": "branch or worktree",
     "more": "a linked worktree, a branch on a remote, or the branch a pull request is on"},
    {"name": "Sprout", "glyph": "🌱", "meaning": "local branch",
     "more": "this desk has it: under issues, and no checkout does; under branches, and no remote does"},
    {"name": "Worktree", "glyph": "🌳", "meaning": "worktree", "more": "a checkout of the repository, the desk or a linked one"},
    {"name": "Commit", "glyph": "🔘", "meaning": "commit", "more": "its short hash"},
    {"name": "Default", "glyph": "⚓", "meaning": "default branch", "more": "the one the remote's HEAD names"},
    {"name": "Change", "glyph": "🔀", "meaning": "pull request", "more": "a merge request, on GitLab"},
    {"name": "Owner", "glyph": "👤", "meaning": "assignees or author",
     "more": "an issue's assignees, a pull request's author, or who pushed last when not the author"},
    {"name": "Fork", "glyph": "🍴", "meaning": "fork owner",
     "more": "the pull request's branch is in their repository"},
    {"name": "Pushed", "glyph": "📤", "meaning": "last push", "more": "how long ago"},
    {"name": "Path", "glyph": "📂", "meaning": "desk path", "more": "above desks"},
    {"name": "Fetched", "glyph": "🛬", "meaning": "fetch", "more": "what it brought from the remotes"},
    {"name": "Remote", "glyph": "📡", "meaning": "remote", "more": "its name, its forge or no forge, and its host"},
    {"name": "Gone", "glyph": "🔖", "meaning": "branch gone", "more": "its upstream is gone; kit tidy removes it"},
    {"name": "Tag", "glyph": "📌", "meaning": "tag",
     "more": "a name on a commit; under incoming, one the fetch brought"},
    {"name": "Behind", "glyph": "📥", "meaning": "behind upstream",
     "more": "a local branch whose upstream on the remote is ahead of it; pulling or kit rebase brings it in"},
    {"name": "Detached", "glyph": "❗", "meaning": "no branch", "more": "a detached HEAD"},
    {"name": "Threads", "glyph": "💬", "meaning": "unresolved threads", "more": "review threads, with how many"},
    {"name": "Running", "glyph": "🏃", "meaning": "running", "more": "checks or a build still running or queued"},
    {"name": "Passed", "glyph": "✅", "meaning": "passed", "more": "every check, or a build"},
    {"name": "Failed", "glyph": "❌", "meaning": "failed",
     "more": "a check, a build, or a fetch, or kit could not read the forge"},
    {"name": "Cancelled", "glyph": "🛑", "meaning": "cancelled or skipped", "more": "a build"},
    {"name": "Build", "glyph": "🏭", "meaning": "build", "more": "a workflow run not owned by any pull request"},
    {"name": "Release", "glyph": "📦", "meaning": "release"},
    {"name": "Pre", "glyph": "🧪", "meaning": "pre-release"},
    {"name": "Draft", "glyph": "📝", "meaning": "draft release"},
    {"name": "Latest", "glyph": "⭐", "meaning": "latest release"},
    {"name": "Asset", "glyph": "📎", "meaning": "asset", "more": "a file a release offers, and where it downloads"},
    {"name": "Package", "glyph": "🧩", "meaning": "package",
     "more": "what kit delivers, in reach of the release or here"},
    {"name": "Active", "glyph": "🟢", "meaning": "active",
     "more": "a package kit.yml declares, whose files kit placed"},
    {"name": "Excluded", "glyph": "⛔", "meaning": "excluded",
     "more": "a bundle's member removed, which kit update leaves out"},
    {"name": "Milestone", "glyph": "⛳", "meaning": "milestone",
     "more": "a goal the forge gathers issues under, with its due day"},
    {"name": "Iteration", "glyph": "📅", "meaning": "iteration", "more": "a span of days the forge plans work in"},
    {"name": "Swimlane", "glyph": "🏊", "meaning": "swimlane",
     "more": "the lane an issue runs in: the forge's own, or what kit.yml's stand-in reads"},
    {"name": "Review", "glyph": "🧐", "meaning": "review",
     "more": "a reviewer's answer on an open pull request, or a request for one"},
    {"name": "Check", "glyph": "🩺", "meaning": "check", "more": "the latest run of a check on an open pull request"},
    {"name": "Merged", "glyph": "🤝", "meaning": "merged",
     "more": "a pull request merged into its base, and who merged it"},
    {"name": "Artifact", "glyph": "📀", "meaning": "artifact", "more": "a file a build kept, until it expires"},
    {"name": "Environment", "glyph": "🏢", "meaning": "environment",
     "more": "where a deployment goes, and the rules that guard it"},
    {"name": "Deployment", "glyph": "🚀", "meaning": "deployment",
     "more": "a commit deployed to an environment, and by whom"},
    {"name": "Person", "glyph": "🧑", "meaning": "person", "more": "one with access to the repository, and their role"},
    {"name": "Team", "glyph": "👪", "meaning": "team", "more": "a team with access to the repository, and its members"},
    {"name": "Agent", "glyph": "🤖", "meaning": "agent",
     "more": "a bot that acts on the repository, what it did, and when last"},
    {"name": "Evidence", "glyph": "🧾", "meaning": "evidence",
     "more": "an attestation of what was built, and who signed it"},
    {"name": "Finding", "glyph": "🐛", "meaning": "finding", "more": "a scanner's alert, and its severity"},
    {"name": "Control", "glyph": "🔒", "meaning": "control",
     "more": "a ruleset or a branch protection, and what it enforces"},
    {"name": "Waiver", "glyph": "🔓", "meaning": "waiver",
     "more": "a control bypassed or an alert dismissed, by whom and why"},
    {"name": "Policy", "glyph": "📏", "meaning": "policy rule", "more": "a rule kit policy holds the files to"},
    {"name": "Enforcement", "glyph": "🔐", "meaning": "enforcement",
     "more": "a mechanism that holds an agent to the rules, its tier, and whether it binds"},
    {"name": "Service", "glyph": "🔌", "meaning": "service", "more": "a capability kit uses, and what answers it"},
    {"name": "Toolchain", "glyph": "🧰", "meaning": "toolchain",
     "more": "what installs the tools, the system's or the project's"},
    {"name": "Usable", "glyph": "✅", "meaning": "usable here",
     "more": "its tool is installed here, and for the project, its file is too"},
    {"name": "Inside", "glyph": "⚡", "meaning": "inside now", "more": "the run is already inside it"},
    {"name": "InUse", "glyph": "📌", "meaning": "kit uses it", "more": "the one kit uses for its role"},
    {"name": "Adds", "glyph": "➕", "meaning": "adds the rest",
     "more": "brew, installing the Brewfile's tools the chosen toolchain does not pin"},
    {"name": "Tool", "glyph": "🔩", "meaning": "tool", "more": "a tool kit pins, and the version installed"},
    {"name": "Setting", "glyph": "🔧", "meaning": "setting",
     "more": "a key of kit.yml, its value set there or its default"},
    {"name": "Other", "glyph": "🔳", "meaning": "other state"}
  ],
