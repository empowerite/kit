# «name» - see: https://just.systems/man/en/
# ----------------------------------------------------------------------------------------------------------------------
«about»
set dotenv-load := true
set fallback := true
«settings»
set positional-arguments := true
«settings»
set script-interpreter := ['bash']
«settings»
# This file's own path, assigned at parse time so the body below needs no interpolation.
export «stem»_justfile := source_file()

# Default recipe: list this justfile's recipes.
_: help

# List recipes in this justfile.
[no-exit-message]
@help *options:
  just --justfile "${«stem»_justfile}" --list
«recipes»
# ----------------------------------------------------------------------------------------------------------------------
