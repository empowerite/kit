#!/usr/bin/env bash
# kit-tui - runs the interactive terminal UI (kit verb: interfaces)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit tui [<verb> [<argument>…]]
#
# Opens the palette of verbs, or with a verb that verb's form, filled from the arguments given, asking only for the
# rest. The form shows the command line it builds, and Enter on it runs the verb, after a transcript of the answers.
# kit tui is the kit CLI's default verb: kit with no verb runs it. A verb short of a required argument, run with a
# terminal on stdin, stdout, and stderr, hands off to it as kit tui -- <verb> <argument>…: the words follow a --, so
# kit reads none of them as its own.
#
#   <verb>        the verb whose form to open; with none, the palette of every verb
#   <argument>…   the arguments given so far, which fill the form
#
# kit tui runs kittui, which each release carries for linux and macos on x64 and arm64, so whatever installs the kit
# installs it at the same version; else kittui on PATH; and in a checkout of the kit, one built from tui/ with go,
# once for each change to its sources. kittui needs a terminal on stdin, stdout, and stderr.
#
# Exits as the verb it runs exits; 1 when the form is cancelled or kittui is missing, 2 without a terminal, and 130
# on ctrl-c.
#
# see: bin/kit, modules/bash/1st.sh, modules/bash/tui.sh, tui/

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"

use tui

guard:arguments tui "$@" || exit $?
binary=$(tui:binary) || exit 1
exec "${binary}" "$@"

# ----------------------------------------------------------------------------------------------------------------------
