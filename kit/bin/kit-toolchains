#!/usr/bin/env bash
# kit-toolchains - lists, installs, and updates the toolchains (kit verb: installation)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit toolchains [--json | --jq]
#
# kit toolchains (install | outdated [--check] | update | path | run <command>…)
#
# Alone, it lists each toolchain usable for the project and the file it reads, one per line. A toolchain is mise,
# brew, or docker, and it manages the tools the gate runs with. It is usable where its tool is on PATH and its file
# is here: mise.toml, Brewfile, or toolchain.Dockerfile. With a verb, it acts on every usable toolchain, in order.
# The same verbs run at the desk and in the delivered CI job.
#
#   --json              one JSON object per toolchain: provider and file
#   --jq                the same JSON, formatted by jq for a person
#   install             installs every toolchain's pinned tools
#   outdated [--check]  prints one line per tool behind its latest version
#   --check             with outdated: fails when any tool is behind
#   update              updates every tool, and rewrites the pins and the lock
#   path                prints the directories that put the tools first on PATH
#   run <command>…      runs the command with the tools on PATH, or in docker
#   <command>…          the command and its arguments, as typed, dash-words included
#
# Exits 0 when it did it, 1 when a verb fails, and 2 on a usage error; run exits with the command's status.
#
# see: modules/bash/toolchain.sh, docs/toolchains.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use toolchain settings
guard:arguments toolchains "$@" || exit $?
# kit.yml selects no toolchain, and a key it does not know, as toolchains now is, is refused.
settings:validate || exit 1

# Every verb reads the toolchains usable for the project once, here.
providers=$(toolchain:usable project) || exit 1

verb=${1:-}
[[ -n "${verb}" ]] && shift
case "${verb}" in
  (install)
    if [[ -z "${providers}" ]]
    then
      ok "no toolchain is usable here; the gate runs with the tools already on PATH"
      exit 0
    fi
    for provider in ${providers}
    do
      step "${provider}: installing from $(toolchain:call "${provider}" file)"
      if ! toolchain:call "${provider}" install
      then
        error "${provider}: the tools could not be installed; see above"
        exit 1
      fi
    done
    ok "toolchains installed: ${providers//$'\n'/ }"
    summary "✅ Toolchains installed: ${providers//$'\n'/ }."
    ;;
  (outdated)
    check=false
    [[ "${1:-}" == --check ]] && check=true
    behind=0
    for provider in ${providers}
    do
      while IFS=$'\t' read -r name installed latest
      do
        [[ -n "${name}" ]] || continue
        printf '%-8s %-32s %-16s → %s\n' "${provider}" "${name}" "${installed}" "${latest}"
        behind=$(( behind + 1 ))
      done < <(toolchain:call "${provider}" outdated)
    done
    if (( behind == 0 ))
    then
      ok "every tool is at its latest"
    elif [[ "${check}" == true ]]
    then
      error "${behind} tool(s) are behind; run: kit toolchains update"
      exit 1
    else
      warn "${behind} tool(s) are behind; run: kit toolchains update"
    fi
    ;;
  (update)
    for provider in ${providers}
    do
      toolchain:call "${provider}" update || exit 1
    done
    ok "every toolchain is updated; commit the pins and the locks it rewrote"
    ;;
  (path)
    toolchain:path
    ;;
  (run)
    toolchain:run "$@"
    ;;
  (*)
    for provider in ${providers}
    do
      file=$(toolchain:call "${provider}" file)
      if [[ "${verb}" == --json ]]
      then
        jq --null-input --compact-output --arg provider "${provider}" --arg file "${file}" \
          '{provider: $provider, file: $file}'
      else
        printf '%-8s %s\n' "${provider}" "${file}"
      fi
    done
esac

# ----------------------------------------------------------------------------------------------------------------------
