#!/usr/bin/env bash
# kit-todo - lists the forge's open issues, oldest first, and what is already in flight for each (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit todo [--json] [--today] [--mine | --all | --owner=<login>…]
#
# Lists every open issue of the repository on its forge, oldest first, each drawn as kit status draws a pull request:
# the issue with its title, its assignees, its state with its age, then what is already in flight for it, the open
# change that closes it and the branch for it on origin. An issue with nothing in flight is idle: one to pick up with
# kit issue <N>. The title is clipped to the terminal's width. NO_COLOR turns the color off; CLICOLOR_FORCE turns it
# on without a terminal.
#
#   --json            prints the same facts as one JSON array; each issue carries inflight: {change, branch}, or null
#   --today           only the issues opened in the last 24 hours; combines with the flags below
#   --mine            the issues assigned to the caller, without the assignee column
#   --all             every open issue (the default)
#   --owner=<login>   the issues assigned to the named login; give it once or more
#
# see: modules/bash/todo.sh, modules/bash/forge.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use todo

guard:require tool:git tool:jq
todo:render "$@"

# ----------------------------------------------------------------------------------------------------------------------
