#!/usr/bin/env bash
# kit-help - prints kit's overview, a verb's page, or a group's verbs (kit verb: help)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit help [<verb> | <group>]…
#
# Prints the help each verb's header holds. kit <verb> --help, or -h, prints the same page as kit help <verb>, and
# kit --help the same as kit help.
#
#   <verb>    a verb's name, or its start: re matches rebase and region
#   <group>   a group's name, as kit help heads them
#
#   - With no argument, it prints what kit is, and every verb's purpose under its group. The plumbing, the verbs
#     that scripts, hooks, and the TUI call, is summed up in one line; kit help plumbing lists them.
#   - A name that matches one verb prints that verb's page: its usage, its description, and the verbs beside it.
#   - A name that matches several verbs prints each one's usage and purpose.
#   - A group's name, when no verb starts with it, prints the group's verbs with their purposes.
#
# The answers follow one another in the order named, a blank line between them.
#
# Exits 0 on success, and 2 when a name matches no verb and no group; it prints nothing then.
#
# see: modules/bash/help.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
use help
guard:arguments help "$@" || exit $?

if (( $# == 0 ))
then
  help:overview
  exit 0
fi

# Every name is judged first, so a name that matches nothing is refused before anything is printed. A name is a verb's,
# the start of one, or a group's, in that order, so a verb named as a group is, as help, wins.
for word in "$@"
do
  # shellcheck disable=SC2154  # help_groups is set by modules/bash/help.sh
  if [[ -z "$(help:verbs "${word}")" && " ${help_groups[*]} " != *" ${word} "* ]]
  then
    error "unknown verb '${word}'; run: kit help"
    exit 2
  fi
done
first=true
for word in "$@"
do
  [[ "${first}" == true ]] || printf '\n'
  first=false
  readarray -t verbs < <(help:verbs "${word}")
  if (( ${#verbs[@]} == 1 ))
  then
    help:page "${verbs[0]}"
  elif (( ${#verbs[@]} > 1 ))
  then
    printf 'usage: kit <verb> [<argument>…]\n\n'
    help:summary "${verbs[@]}"
    printf '\nRun kit help <verb> for a verb'"'"'s page.\n'
  else
    readarray -t verbs < <(help:members "${word}")
    help:listing "${word}" "${verbs[@]}"
  fi
done

# ----------------------------------------------------------------------------------------------------------------------
