#!/usr/bin/env bash
# kit-help - prints what kit is and its verbs by group, or one verb's help page (kit verb: help)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit help [<verb>]
#
# Prints the help each verb's header holds.
#
#   <verb>   a verb's name, or the start of one: kit help re matches rebase and region
#
#   - With no <verb>, it prints what kit is, and every verb's name and purpose under the verb's group, as gh help
#     lays itself out; kit usage prints the usage lines.
#   - With a <verb> that matches several verbs, it prints each one's usage and purpose.
#   - With a <verb> that matches one verb, it prints that verb's page: its usage, its description, and the other
#     verbs of its group.
#
# Exits 0 on success, and 2 when no verb matches.
#
# see: modules/bash/help.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
use help
guard:arguments help "$@" || exit $?

readarray -t verbs < <(help:verbs "${1:-}")
case "${#verbs[@]}" in
  (0)
    error "no kit verb matches '$1'; run: kit help"
    exit 2
    ;;
  (1)
    help:page "${verbs[0]}"
    ;;
  (*)
    if [[ -z "${1:-}" ]]
    then
      help:overview
      exit 0
    fi
    printf 'usage: kit <verb> [<argument>…]\n\n'
    help:summary "${verbs[@]}"
    printf '\nRun kit help <verb> for a verb'"'"'s page.\n'
esac

# ----------------------------------------------------------------------------------------------------------------------
