#!/usr/bin/env bash
# kit-check - fail when a delivered file differs from the pinned release (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit check takes no arguments. It compares the repository with the release pinned in .kit/manifest, and reports
# a finding when:
#
#   - .kit/manifest records a kit version other than the pinned release
#   - a delivered file is missing, or differs from the release's copy
#   - a merged JSON file is missing an entry the kit writes, or jq is not on PATH to read it
#   - a file that should contain a kit region has none
#   - a file the repository owns is missing a line a module expects in it
#   - a generated region differs from what its command makes
#
# Files delivered to the home directory are checked only when ~/.kit/manifest exists, that is, on a machine where
# kit install ran. On a machine without it, such as a CI runner, kit check prints a note and skips them.
#
# Exits 0 when there are no findings, and 1 otherwise.
#
# see: bash/release.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../bash/1st.sh"
kit:enter
use release generate

if [[ "${1:-}" == --help ]]
then
  echo "usage: kit check" >&2
  exit 0
fi

release:require-manifest
readarray -t modules < <(release:manifest-modules)
version=$(release:manifest-version)
release:render-all "${kit_root}" "${modules[@]}"
findings=0
if [[ "${version}" != "$(release:version)" ]]
then
  error ".kit/manifest records kit ${version}, and the pinned release is $(release:version); run: kit update"
  findings=$(( findings + 1 ))
fi
for base in $(release:bases)
do
  delivered=$(release:delivered "${kit_root}" "${base}" "${modules[@]}")
  [[ -n "${delivered}" ]] || continue
  if [[ "${base}" != repo && ! -f "$(release:manifest "${base}")" ]]
  then
    info "${base}: nothing is installed under $(release:base-root "${base}") on this machine; not checked"
    continue
  fi
  while IFS=$'\t' read -r path src
  do
    dest=$(release:dest "${base}" "${path}")
    kind=$(release:kind "${src}" "${dest}")
    if [[ ! -f "${dest}" ]]
    then
      error "${dest} is missing"
      findings=$(( findings + 1 ))
    elif [[ "${kind}" == merge ]] && ! command -v jq >/dev/null 2>&1
    then
      error "run: mise install (jq is not on PATH, so ${dest} could not be read)"
      findings=$(( findings + 1 ))
    elif [[ "${kind}" == region ]]
    then
      # Only the directive is checked here. Its content is checked below, with every other generated region.
      if ! release:installed "${src}" "${dest}" >/dev/null
      then
        error "${dest} has no kit region; run: kit update"
        findings=$(( findings + 1 ))
      fi
    elif ! release:holds "${src}" "${dest}"
    then
      case "${kind}" in
        (merge) error "${dest} is missing an entry the kit writes; run: kit update" ;;
        (*) error "${dest} differs from the pinned release" ;;
      esac
      findings=$(( findings + 1 ))
    fi
  done <<<"${delivered}"
done
# Report each line a module expects in a file the repository owns that is missing. The kit never writes these lines.
while IFS= read -r unmet
do
  [[ -n "${unmet}" ]] || continue
  error "${unmet}"
  findings=$(( findings + 1 ))
done < <(release:unmet "${kit_root}" "${modules[@]}")
# Check that every generated region, the kit's and the repository's own, matches what its command makes.
generate:run --check || findings=$(( findings + 1 ))
if (( findings > 0 ))
then
  error "${findings} finding(s). A delivered file changes by a new release and kit update, never in place;" \
    "a generated region by kit generate."
  exit 1
fi
ok "kit ${version}, modules ${modules[*]:-none}: every delivered file matches the pinned release."

# ----------------------------------------------------------------------------------------------------------------------
