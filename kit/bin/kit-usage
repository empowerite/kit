#!/usr/bin/env bash
# kit-usage - prints the usage lines of the verbs (kit verb: plumbing)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit usage [<verb>…]
#
# Prints each verb's usage lines, as its header writes them, one per line and nothing else. A verb that takes no
# arguments prints kit <verb>. kit help prints a verb's whole page, and kit syntax its grammar as JSON.
#
# Arguments:
#   <verb>…   the verbs, by whole name; default: every verb, in name order
#
# Exits 0 on success, and 2 when a name is not a verb.
#
# see: modules/bash/help.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
use help

guard:arguments usage "$@" || exit $?

verbs=("$@")
(( ${#verbs[@]} )) || readarray -t verbs < <(help:verbs)
for verb in "${verbs[@]}"
do
  if [[ ! -x "${kit_root}/bin/kit-${verb}" ]]
  then
    guard:unknown-verb "${verb}" || exit $?
  fi
done
# every header named is read first, so one that leaves the verb template is refused before anything prints
help:values "${verbs[@]}" || exit 1
for verb in "${verbs[@]}"
do
  help:usage "${verb}"
done

# ----------------------------------------------------------------------------------------------------------------------
