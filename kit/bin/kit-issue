#!/usr/bin/env bash
# kit-issue - starts or resumes an issue (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit issue (<reference>… | --title <text>)
#
# Starts work on an issue, or resumes it. kit issue makes each of these, and reuses any that already exists:
#
#   - a branch linked to the issue
#   - a worktree for the branch, hydrated: what the kit delivers under .kit/ is in place
#   - a start commit
#   - a draft pull request
#
#   <reference>…     the issues, each named with its tracker: 7, #7, or AB#4521
#   --title <text>   creates an issue with that title, then starts it
#
# 7 and #7 name an issue on the forge, the service that hosts the repository: GitHub or GitLab. AB#4521 names an
# Azure DevOps work item, when kit.yml declares that tracker. kit issue asks nothing itself; kit tui asks for the
# title when kit issue is given neither.
#
# Exits 0 when the work is started or resumed, 1 on a refusal, and 2 on a usage error or a reference no declared
# tracker reads.
#
# see: modules/bash/issue.sh, modules/bash/forge.sh, modules/bash/tracker.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use issue

guard:arguments issue "$@" || exit $?
# shellcheck disable=SC2154  # syntax_operands and syntax_options are set by guard:arguments
if [[ -n "${syntax_options[--title]+x}" ]]
then
  issue:start --title "${syntax_options[--title]}"
else
  issue:start "${syntax_operands[@]}"
fi

# ----------------------------------------------------------------------------------------------------------------------
