#!/usr/bin/env bash
# kit-issue - starts or resumes an issue (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit issue (<reference>… | --title <text>)
#
# Starts work on an issue, or resumes it. kit issue makes each of these, and reuses any that already exists:
#
#   - a branch linked to the issue
#   - a worktree for the branch, hydrated: what the kit delivers under .kit/ is in place
#   - a start commit
#   - a draft pull request (a merge request on GitLab)
#
#   <reference>…   the issues, each named with its tracker: 7 or #7 for an issue on the forge (the service that
#                  hosts the repository, GitHub or GitLab), AB#4521 for an Azure DevOps work item, when that tracker
#                  is declared in .kit/settings.yml
#   --title <text>   creates an issue with that title in the forge's tracker, then starts it, in one step
#
# kit issue asks nothing itself: with --title it creates the issue and starts it; kit tui asks for the title when
# kit issue is given neither.
#
# see: modules/bash/issue.sh, modules/bash/forge.sh, modules/bash/tracker.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use issue

guard:arguments issue "$@" || exit $?
# shellcheck disable=SC2154  # syntax_operands is set by guard:arguments

issue:start "${syntax_operands[@]}"

# ----------------------------------------------------------------------------------------------------------------------
