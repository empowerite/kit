#!/usr/bin/env bash
# kit-submit - commits what is staged, then pushes the branch (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
# kit submit [--all] [--message <text>… | --file <path>] [<path>…]
#
# Runs in a worktree, never on the desk or the default branch. When something is staged, or --all or <path>… say
# what to take, it commits as kit commit does, with the same checks and options. Then it pushes the branch to its own
# name on origin, whatever git's push configuration and the branch's upstream say, and sets that as the upstream on
# the first push. With nothing to commit and nothing to push, it says so.
#
#   --all              stages every tracked change first, as git commit --all does
#   --message <text>   the message; the first is the subject, the rest are paragraphs
#   --file <path>      the message from a file; its first line is the subject
#   <path>…            commits these paths alone; each must be known to git
#
# kit submit never forces. When origin has commits this branch lacks, the push is refused and the remedy is kit
# rebase. A conflict with the default branch never blocks sharing the work that was done.
#
# Exits 0 when the branch is at origin, 1 on a refusal, and 2 on a usage error.
#
# see: modules/bash/commit.sh, kit-commit, kit-rebase

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use commit
guard:arguments submit "$@" || exit $?

guard:require tool:git tool:jq
commit:submit "$@"

# ----------------------------------------------------------------------------------------------------------------------
