#!/usr/bin/env bash
# kit-workspaces - lists, shows, and edits your workspaces, and says which one kit starts on (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
# kit workspaces [--text | --json | --jq]
#
# kit workspaces --show <workspace> [--text | --json | --jq]
#
# kit workspaces --current [--workspace <workspace>] [--text | --json | --jq]
#
# kit workspaces --use <workspace>
#
# kit workspaces --new <name> [<repository>…]
#
# kit workspaces (--add | --remove) <name> <repository>…
#
# kit workspaces (--favorite | --unfavorite) <workspace>
#
# A workspace is what kit looks at: one repository, or a named group of them, as a group of repositories that move
# together. Groups are yours alone, kept in kit/workspaces.yml under XDG_CONFIG_HOME, else ~/.config, which you may
# edit by hand; kit keeps your comments when it edits the file. A repository is named by its host and its whole path,
# github.com/empowerite/edge. Its checkout is the clone under one of the file's roots, at most four levels down, whose
# primary remote points at it.
#
# With no option, it lists the groups and the favorites. Inside a repository kit starts on that repository; outside
# one, on the last group used; with none used, on none.
#
#   --text            prints as text, even on a terminal
#   --json            one JSON object, as each form below says
#   --jq              the same JSON, formatted by jq for a person
#   --show            shows a workspace's members, each with its checkout
#   --current         says which workspace kit starts on here, and why
#   --workspace       names the workspace in place of where kit runs; none names no workspace
#   --use             remembers a group as the last used, which kit starts on outside a repository
#   --new             makes a group, with the repositories given as its members
#   --add             adds the repositories to a group's members
#   --remove          takes the repositories out of a group's members
#   --favorite        adds a workspace to the favorites
#   --unfavorite      takes a workspace out of the favorites
#   <workspace>       a group's name, or a repository: github.com/empowerite/edge or a git URL
#   <name>            a group's name: lowercase letters, digits, and . _ -
#   <repository>      github.com/empowerite/edge, a git URL, or a checkout's directory
#
# The list's JSON is {file, roots, favorites, workspaces}, each group {name, members, favorite}, members a count.
# --show's is {name, kind, members}: kind is group or repository, and each member is {repository, host, path, forge,
# remotes, checkout, checkouts, by}, remotes [{name, url, forge}] the primary first, checkout a path or null, and by
# fixed for a group's member, given for a repository named. --current's is {kind, name, member, checkout, why, members,
# groups, favorites}: kind is repository, group, or none; why is given, repository, last, or none; members a group's,
# as --show gives each; groups, for a repository, each group that holds it, {name, members}, members a count; and
# favorites {name, kind, members, checkout}. Only the JSON looks for checkouts; the text names the workspace alone.
#
# Exits 0 when it printed or edited, 1 when the file does not read, holds an entry that is no repository, or a list
# it reads, such as the checkouts under the roots, cannot be read, and 2 on a usage error, or a workspace or group
# that is unknown.
#
# see: modules/bash/workspaces.sh, docs/workspaces.md, issue #89

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use workspaces
guard:arguments workspaces "$@" || exit $?

action=list target='' workspace='' form=''
args=()
while (( $# ))
do
  # --option=value is --option value, as kit syntax reads it
  [[ "$1" != --*=* ]] || set -- "${1%%=*}" "${1#*=}" "${@:2}"
  case "$1" in
    (--show | --use | --new | --add | --remove | --favorite | --unfavorite) action=${1#--} target=$2; shift ;;
    (--current) action=current ;;
    (--workspace) workspace=$2; shift ;;
    (--text | --json) form=$1 ;;
    (--jq) form=--jq ;;
    (*) args+=("$1")
  esac
  shift
done

workspaces:check || exit 1

# print <json> <text-filter> prints the JSON as the form asks: on one line, through jq for a person, or as text by the
# jq filter given.
print() {
  case "${form}" in
    (--json) printf '%s\n' "$1" ;;
    (--jq) jq . <<<"$1" ;;
    (*) jq --raw-output "$2" <<<"$1"
  esac
}

case "${action}" in
  (list)
    json=$(workspaces:list-json)
    print "${json}" 'if (.workspaces | length) == 0 then "no workspaces yet; the file is \(.file)"
      else .workspaces[] | "\(if .favorite then "★" else " " end) 📚 \(.name) \(.members)" end'
    ;;
  (show)
    json=$(workspaces:resolve "${target}") || exit $?
    print "${json}" '.members[] | "\(.repository)  \(.checkout // "☁️")"'
    ;;
  (current)
    json=$(workspaces:current "${workspace}") || exit $?
    [[ "${form}" != --json && "${form}" != --jq ]] || json=$(workspaces:menu-json "${json}")
    print "${json}" '"\(if .kind == "none" then "no workspace" else "📚 \(.name)" end) (\({given: "given",
      repository: "the repository here", last: "the last group used", none: "outside a repository, no group used yet"}
      [.why]))"'
    ;;
  (use)
    line=$(workspaces:kind "${target}") || exit $?
    read -r kind _ <<<"${line}"
    if [[ "${kind}" != group ]]
    then
      error "kit workspaces --use remembers a group; a repository is the workspace inside it"
      exit 2
    fi
    workspaces:remember "${target}"
    step "kit starts on 📚 ${target} outside a repository"
    ;;
  (new | add | remove)
    groups=$(workspaces:names)
    if [[ "${action}" == new ]]
    then
      if [[ ! "${target}" =~ ^[a-z0-9][a-z0-9._-]*$ ]]
      then
        error "'${target}' is not a workspace's name: lowercase letters, digits, and . _ -, no /"
        exit 2
      fi
      if grep --quiet --line-regexp --fixed-strings -- "${target}" <<<"${groups}"
      then
        error "📚 ${target} is a workspace already; add to it: kit workspaces --add ${target} <repository>…"
        exit 2
      fi
    elif ! grep --quiet --line-regexp --fixed-strings -- "${target}" <<<"${groups}"
    then
      error "'${target}' is no workspace in $(workspaces:file); run: kit workspaces"
      exit 2
    fi
    members=()
    for repository in "${args[@]}"
    do
      member=$(workspaces:normalize "${repository}" dirs)
      if [[ -z "${member}" ]]
      then
        error "'${repository}' names no repository; write host/owner/repo, a git URL, or a checkout's directory"
        exit 2
      fi
      [[ " ${members[*]} " == *" ${member} "* ]] || members+=("${member}")
    done
    case "${action}" in
      (new)
        workspaces:new "${target}" "${members[@]}" || exit 1
        step "📚 ${target}: a workspace of ${#members[@]}"
        ;;
      (add)
        declare -a have
        list:read have workspaces:fixed "${target}" || exit 1
        fresh=()
        for member in "${members[@]}"
        do
          [[ " ${have[*]} " == *" ${member} "* ]] || fresh+=("${member}")
        done
        if (( ${#fresh[@]} > 0 ))
        then
          workspaces:add "${target}" "${fresh[@]}" || exit 1
          step "📚 ${target}: added ${fresh[*]}"
        fi
        ;;
      (remove)
        drop=()
        declare -a entries
        list:read entries workspaces:entries "${target}" repos || exit 1
        for entry in "${entries[@]}"
        do
          [[ " ${members[*]} " != *" $(workspaces:normalize "${entry}") "* ]] || drop+=("${entry}")
        done
        if (( ${#drop[@]} > 0 ))
        then
          workspaces:drop "${target}" "${drop[@]}" || exit 1
          step "📚 ${target}: removed ${drop[*]}"
        fi
    esac
    ;;
  (favorite | unfavorite)
    line=$(workspaces:kind "${target}") || exit $?
    read -r _ name <<<"${line}"
    declare -a favorites
    list:read favorites workspaces:favorites || exit 1
    if [[ "${action}" == favorite ]] && ! list:among "${name}" "${favorites[@]}"
    then
      workspaces:favor "${name}" || exit 1
      step "★ 📚 ${name} is a favorite"
    elif [[ "${action}" == unfavorite ]] && list:among "${name}" "${favorites[@]}"
    then
      workspaces:disfavor "${name}" || exit 1
      step "📚 ${name} is no longer a favorite"
    fi
esac

# ----------------------------------------------------------------------------------------------------------------------
