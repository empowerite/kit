#!/usr/bin/env bash
# kit-workspaces - lists, shows, and edits your workspaces, and says which one kit starts on (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
# kit workspaces [--text | --json | --jq]
#
# kit workspaces --show=<workspace> [--text | --json | --jq]
#
# kit workspaces --current [--text | --json | --jq]
#
# kit workspaces --use=<workspace>
#
# kit workspaces --new=<name> [<repository>…]
#
# kit workspaces --add=<name> <repository>…
#
# kit workspaces --remove=<name> <repository>…
#
# kit workspaces --rename=<name> <new-name>
#
# kit workspaces --delete=<name>
#
# kit workspaces --favorite=<workspace>
#
# kit workspaces --unfavorite=<workspace>
#
# A workspace is what kit looks at: one repository, or a named group of them, as a group of repositories that move
# together. Groups are yours alone, kept in kit/workspaces.yml under XDG_CONFIG_HOME, else ~/.config, which you may
# edit by hand; kit keeps your comments when it edits the file. A repository is named by its host and its whole path,
# github.com/empowerite/edge, spelled one way: the host in lower case, and on GitHub and GitLab the path too. Its
# checkout is the clone under one of the file's roots, at most four levels down, whose primary remote points at it.
#
# With no option, it lists the groups and the favorites. Inside a repository, in its working tree, kit starts on that
# repository; outside one, a bare repository or a .git directory too, on the last group used; with none used, on none.
#
#   --text            prints as text, even on a terminal
#   --json            one JSON object, as each form below says
#   --jq              the same JSON, formatted by jq for a person
#   --show            shows a workspace's members, each with its checkout
#   --current         says which workspace kit starts on here, and why; under kit --workspace=<workspace>, the kit
#                     option before the verb, that one in place of where kit runs, none naming no workspace
#   --use             remembers a group as the last used, which kit starts on outside a repository
#   --new             makes a group, with the repositories given as its members
#   --add             adds the repositories to a group's members
#   --remove          takes the repositories out of a group's members
#   --rename          gives a group a new name, in its place in the file, and keeps it the last used if it was
#   --delete          takes a group, and its favorite, out of the file, and forgets it as the last used; its
#                     checkouts are as they were
#   --favorite        adds a workspace to the favorites
#   --unfavorite      takes a workspace out of the favorites
#   <workspace>       a group's name, or a repository: github.com/empowerite/edge or a git URL
#   <name>            a group's name: a lowercase letter or a digit, then lowercase letters, digits, and . _ -, and
#                     never none
#   <new-name>        the name --rename gives the group, as a <name> is written and no other group's
#   <repository>      github.com/empowerite/edge, a git URL, or a checkout's directory
#
# The list's JSON is {file, roots, favorites, workspaces}, each group {name, members, favorite}, members a count.
# --show's is {name, kind, members}: kind is group or repository, and each member is {repository, host, path, forge,
# remotes, checkout, checkouts, by}, remotes [{name, url, forge}] the primary first, checkout a path or null, and by
# fixed for a group's member, given for a repository named. --current's is {kind, name, member, checkout, why, members,
# groups, favorites}: kind is repository, group, or none; why is given, repository, last, or none; members a group's,
# as --show gives each; groups, for a repository, each group that holds it, {name, members}, members a count; and
# favorites {name, kind, members, checkout}. Only the JSON looks for checkouts; the text names the workspace alone.
# The forms that edit print one line, which says what changed, or that nothing needed to, and take no --json.
#
# Each form that edits, and --use, takes the file's lock first, a link in kit/workspaces/ under XDG_CACHE_HOME, else
# ~/.cache, so two commands that edit the file at once each land. A lock whose process is gone is taken over; one held
# by a live process is waited for, 30 seconds by the clock.
#
# Exits 0 when it printed or edited, 1 when the file does not read, is not a map, gives a group a key other than repos
# and exclude, holds an entry that is no repository, a list it reads, such as the checkouts under the roots, cannot be
# read, another process holds the file's lock past the wait, or kit/workspaces/ under XDG_CACHE_HOME cannot be
# written, and 2 on a usage error, a workspace or group that is unknown, or a new name --rename refuses or another
# group has.
#
# see: modules/bash/workspaces.sh, docs/workspaces.md, issue #89

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use workspaces

# The forms that name a group or a workspace are written --option=<value>; given as the next word, the value is joined
# to its option first, so --add w reads as --add=w. The list below names every option the usage lines write as
# --option=<value>, so an option given that form joins the list too.
workspaces:misplaced workspaces "$@" || exit $?
words=()
while (( $# ))
do
  if [[ "$1" == -- ]]
  then
    words+=("$@")
    break
  fi
  case "$1" in
    (--show | --use | --new | --add | --remove | --rename | --delete | --favorite | --unfavorite)
      if (( $# > 1 )) && [[ "$2" != -* ]]
      then
        words+=("$1=$2")
        shift 2
        continue
      fi
  esac
  words+=("$1")
  shift
done
set -- "${words[@]}"
guard:arguments workspaces "$@" || exit $?

action=list target='' form=''
# The workspace --current says is the kit option's, kit --workspace=<workspace> workspaces --current, which bin/kit,
# the loader, hands on.
workspace=${KIT_WORKSPACE:-}
args=()
while (( $# ))
do
  # --option=value is --option value, as kit syntax reads it
  [[ "$1" != --*=* ]] || set -- "${1%%=*}" "${1#*=}" "${@:2}"
  case "$1" in
    (--show | --use | --new | --add | --remove | --rename | --delete | --favorite | --unfavorite)
      action=${1#--} target=$2
      shift
      ;;
    (--current) action=current ;;
    (--text | --json) form=$1 ;;
    (--jq) form=--jq ;;
    (*) args+=("$1")
  esac
  shift
done
# A workspace given before the verb names the one --current says; every other form reads or edits the file itself.
if [[ -n "${workspace}" && "${action}" != current ]]
then
  error "kit --workspace=<workspace> names the workspace kit workspaces --current says, and no other form's; see:" \
    "kit help workspaces"
  exit 2
fi

# A form that edits the file, or the last group used, takes the file's lock before it reads the file, so what it checks
# and what it writes are one turn.
case "${action}" in
  (use | new | add | remove | rename | delete | favorite | unfavorite) workspaces:lock || exit 1
esac
workspaces:check || exit 1

# print <json> <text-filter> prints the JSON as the form asks: on one line, through jq for a person, or as text by the
# jq filter given.
print() {
  case "${form}" in
    (--json) printf '%s\n' "$1" ;;
    (--jq) jq . <<<"$1" ;;
    (*) jq --raw-output "$2" <<<"$1"
  esac
}

case "${action}" in
  (list)
    json=$(workspaces:list-json)
    print "${json}" 'if (.workspaces | length) == 0 then "no workspaces yet; the file is \(.file)"
      else .workspaces[] | "\(if .favorite then "★" else " " end) 📚 \(.name) \(.members)" end'
    ;;
  (show)
    json=$(workspaces:resolve "${target}") || exit $?
    print "${json}" '.members[] | "\(.repository)  \(.checkout // "☁️")"'
    ;;
  (current)
    json=$(workspaces:current "${workspace}") || exit $?
    [[ "${form}" != --json && "${form}" != --jq ]] || json=$(workspaces:menu-json "${json}")
    print "${json}" '"\(if .kind == "none" then "no workspace" else "📚 \(.name)" end) (\({given: "given",
      repository: "the repository here", last: "the last group used", none: "outside a repository, no group used yet"}
      [.why]))"'
    ;;
  (use)
    line=$(workspaces:kind "${target}") || exit $?
    read -r kind _ <<<"${line}"
    if [[ "${kind}" != group ]]
    then
      error "kit workspaces --use remembers a group; a repository is the workspace inside it"
      exit 2
    fi
    workspaces:remember "${target}" || exit 1
    step "kit starts on 📚 ${target} outside a repository"
    ;;
  (new | add | remove | rename | delete)
    groups=$(workspaces:names)
    if [[ "${action}" == new ]]
    then
      refusal=$(workspaces:name-refusal "${target}")
      if [[ -n "${refusal}" ]]
      then
        error "${refusal}"
        exit 2
      fi
      if grep --quiet --line-regexp --fixed-strings -- "${target}" <<<"${groups}"
      then
        error "📚 ${target} is a workspace already; add to it: kit workspaces --add=${target} <repository>…"
        exit 2
      fi
    elif ! grep --quiet --line-regexp --fixed-strings -- "${target}" <<<"${groups}"
    then
      error "'${target}' is no workspace in $(workspaces:file); run: kit workspaces"
      exit 2
    fi
    if [[ "${action}" == rename ]]
    then
      name=${args[0]}
      refusal=$(workspaces:name-refusal "${name}")
      if [[ -n "${refusal}" ]]
      then
        error "${refusal}"
        exit 2
      fi
      if grep --quiet --line-regexp --fixed-strings -- "${name}" <<<"${groups}"
      then
        error "📚 ${name} is a workspace already; choose another name"
        exit 2
      fi
      last=$(workspaces:last) || exit 1
      workspaces:rename "${target}" "${name}" || exit 1
      [[ "${last}" != "${target}" ]] || workspaces:remember "${name}" || exit 1
      step "📚 ${target} is renamed 📚 ${name}"
      exit 0
    fi
    if [[ "${action}" == delete ]]
    then
      last=$(workspaces:last) || exit 1
      workspaces:delete "${target}" || exit 1
      [[ "${last}" != "${target}" ]] || workspaces:forget || exit 1
      step "📚 ${target} is deleted; its checkouts are as they were"
      exit 0
    fi
    members=()
    for repository in "${args[@]}"
    do
      member=$(workspaces:normalize "${repository}" dirs)
      if [[ -z "${member}" ]]
      then
        error "'${repository}' names no repository; write host/owner/repo, a git URL, or a checkout's directory"
        exit 2
      fi
      [[ " ${members[*]} " == *" ${member} "* ]] || members+=("${member}")
    done
    case "${action}" in
      (new)
        workspaces:new "${target}" "${members[@]}" || exit 1
        step "📚 ${target}: a workspace of ${#members[@]}"
        ;;
      (add)
        declare -a have
        list:read have workspaces:fixed "${target}" || exit 1
        fresh=()
        for member in "${members[@]}"
        do
          [[ " ${have[*]} " == *" ${member} "* ]] || fresh+=("${member}")
        done
        if (( ${#fresh[@]} > 0 ))
        then
          workspaces:add "${target}" "${fresh[@]}" || exit 1
          step "📚 ${target}: added ${fresh[*]}"
        else
          step "📚 ${target} holds them already"
        fi
        ;;
      (remove)
        drop=()
        declare -a entries
        list:read entries workspaces:entries "${target}" repos || exit 1
        for entry in "${entries[@]}"
        do
          [[ " ${members[*]} " != *" $(workspaces:normalize "${entry}") "* ]] || drop+=("${entry}")
        done
        if (( ${#drop[@]} > 0 ))
        then
          workspaces:drop "${target}" "${drop[@]}" || exit 1
          step "📚 ${target}: removed ${drop[*]}"
        else
          step "📚 ${target} holds none of them"
        fi
    esac
    ;;
  (favorite | unfavorite)
    declare -a favorites
    list:read favorites workspaces:favorites || exit 1
    # A favorite written as given is taken out before the workspace is looked up, so one that names no workspace, as a
    # deleted group's, can be.
    if [[ "${action}" == unfavorite ]] && list:among "${target}" "${favorites[@]}"
    then
      workspaces:disfavor "${target}" || exit 1
      step "📚 ${target} is not a favorite"
      exit 0
    fi
    line=$(workspaces:kind "${target}") || exit $?
    read -r _ name <<<"${line}"
    if [[ "${action}" == favorite ]] && list:among "${name}" "${favorites[@]}"
    then
      step "📚 ${name} is a favorite already"
    elif [[ "${action}" == favorite ]]
    then
      workspaces:favor "${name}" || exit 1
      step "★ 📚 ${name} is a favorite"
    else
      ! list:among "${name}" "${favorites[@]}" || workspaces:disfavor "${name}" || exit 1
      step "📚 ${name} is not a favorite"
    fi
esac

# ----------------------------------------------------------------------------------------------------------------------
