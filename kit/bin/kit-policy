#!/usr/bin/env bash
# kit-policy - refuses a branch, a commit subject, or a change title the repository's policy does not allow (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit policy [--input]
#
# Fails when a name breaks the repository's policy. kit policy collects these facts once:
#
#   - the branch name
#   - the subject of each commit since the branch forked from the default branch
#   - the open pull request's title
#
# The policy engine then reports every refusal. The engine is patterns (the default) or Open Policy Agent. With
# --input, kit policy prints the facts as JSON instead: the document a rule is written against.
#
# kit ci runs kit policy alongside the gate. On a CI runner, refusals are also written to the step summary.
#
# Exits 0 when the policy allows every name, 1 on any refusal, and 2 on a usage error.
#
# see: modules/bash/policy.sh, docs/policy.md

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use policy release
release:hydrate

case "${1:-}" in
  (--input)
    policy:input
    exit 0
    ;;
  ('') ;;
  (*)
    error "unknown argument '$1'; run: kit help policy"
    exit 2
esac

input=$(mktemp)
trap 'rm -f "${input}"' EXIT
policy:input > "${input}"
engine=$(policy:engine)
refusals=$(policy:deny "${input}") || exit 1
if [[ -n "${refusals}" ]]
then
  while IFS= read -r refusal
  do
    error "${refusal}"
  done <<<"${refusals}"
  count=$(wc -l <<<"${refusals}" | tr -d ' ')
  error "${count} refusal(s) by the ${engine} policy; .kit/settings.yml holds the patterns, docs/policy.md says how"
  summary "### ❌ ${count} refusal(s) by the policy" "" "- ${refusals//$'\n'/$'\n'- }"
  exit 1
fi
subjects=$(jq --raw-output '[if .branch then "the branch" else empty end,
  "\(.commits | length) commit(s)", if .change then "the change title" else empty end] | join(", ")' "${input}")
ok "the ${engine} policy allows ${subjects}"
summary "✅ The policy allows ${subjects}."

# ----------------------------------------------------------------------------------------------------------------------
