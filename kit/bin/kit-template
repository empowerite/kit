#!/usr/bin/env bash
# kit-template - rewrites a template's ASCII holes into guillemets (kit verb: plumbing)
# ----------------------------------------------------------------------------------------------------------------------
# kit template fix <path>…
#
# A template's holes are written «name», «name…», and «name=default». On a US Mac keyboard, « is Option-\, » is
# Shift-Option-\, and … is Option-;. Anyone without them types <<name>>, <<name...>>, and <<name=default>>, and kit
# template fix rewrites those in place to the one spelling the language has. It changes nothing else, and says how
# many holes it rewrote in each file.
#
#   fix       rewrites the ASCII holes in each file
#   <path>…   the template files to rewrite
#
# Exits 0 on success, 1 when a path is not a file, and 2 on a usage error.
#
# see: modules/jq/template.jq, docs/templates.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
guard:arguments template "$@" || exit $?
shift

status=0
for path in "$@"
do
  [[ "${path}" == /* ]] || path=${kit_invoked_in}/${path}
  if [[ ! -f "${path}" ]]
  then
    error "${path}: no such file"
    status=1
    continue
  fi
  count=$(grep --only-matching --extended-regexp '<<[a-z_.]+(\.\.\.)?(=[^>]*)?>>' "${path}" | wc -l | tr -d ' ')
  if (( count > 0 ))
  then
    sed -E -i.kit-fix 's/<<([a-z_.]*[a-z_])\.\.\.(=[^>]*)?>>/«\1…\2»/g; s/<<([a-z_.]+)(=[^>]*)?>>/«\1\2»/g' "${path}"
    rm -f "${path}.kit-fix"
  fi
  ok "${path#"${kit_invoked_in}"/}: ${count} hole(s) rewritten"
done
exit "${status}"

# ----------------------------------------------------------------------------------------------------------------------
