#!/usr/bin/env bash
# kit-region - prints the content the active packages deliver as the region at a path (kit verb: plumbing)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit region [--home] [<path>]
#
# Prints the content an active package delivers as the region at <path>. Every region the kit delivers is filled
# this way: kit install writes a bare directive, such as `kit:generate AGENTS.md`, and kit generate fills it by
# running `kit region` with the region's name in KIT_GENERATE_REGION.
#
#   <path>    the region's path, relative to the repository root. Default: KIT_GENERATE_REGION.
#   --home    makes the path relative to the home directory instead.
#
# Only one active package delivers a region at a given path, so kit region prints that package's
# regions/<base>/<path>.
#
# Exits 0 when it prints the region, 1 when no active package delivers a region at <path>, and 2 on a usage error.
#
# see: modules/bash/generate.sh, modules/bash/render.sh, modules/bash/place.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use settings render place materialize
guard:arguments region "$@" || exit $?
materialize:hydrate

base=repo
path=''
for arg in "$@"
do
  case "${arg}" in
    (--) ;;
    (--home) base=home ;;
    (*) path=${arg}
  esac
done
path=${path:-${KIT_GENERATE_REGION:-}}
if [[ -z "${path}" ]]
then
  error "kit region needs a path, or KIT_GENERATE_REGION; run: kit help region"
  exit 2
fi
settings:require
readarray -t packages < <(settings:packages)
render:all "${kit_root}" "${packages[@]}"
src=$(place:source-of "${kit_root}" "${base}" "${path}" "${packages[@]}")
if [[ -z "${src}" ]] || [[ "$(place:kind "${src}" "${path}")" != region ]]
then
  error "no active package delivers a region at ${path} (packages: ${packages[*]}); see kit.yml"
  exit 1
fi
cat "${src}"

# ----------------------------------------------------------------------------------------------------------------------
