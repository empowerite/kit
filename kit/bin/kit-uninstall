#!/usr/bin/env bash
# kit-uninstall - takes everything the kit placed out of the repository, and out of the home directory (kit verb: installation)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit uninstall [--dry-run]
#
# Undoes kit install, and every kit package add since. For every path the active packages deliver:
#
#   - a file copied outside .kit/ is removed when it is still as the kit placed it; one the repository edited is
#     named and left as it is
#   - the kit's entries are taken out of a merged .json file, and the rest of the file stays
#   - the kit's region is taken out of a file the repository owns, and a file left with nothing but what the kit made
#     is removed
#   - everything kit placed under .kit/ is removed, with .kit/manifest and .kit/.gitignore; the repository's own
#     packages under .kit/packages/ stay, and so does .kit/ while they are there
#   - under the home directory, what these packages delivered is taken out the same way, and ~/.kit/manifest is
#     written without them, or removed when no line is left
#
# Then it drops version, packages, and excludes from kit.yml, and removes kit.yml when nothing else is in it.
# worktrees/ and every other file of the repository's own stay. Commit what changed; kit install takes the kit again.
#
#   --dry-run   prints what it would take out, one line per path, and changes nothing
#
# Exits 0 on success, 1 when kit.yml declares no kit version, so there is nothing to take out, and 2 on a usage error.
#
# see: modules/bash/uninstall.sh, modules/bash/place.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use uninstall settings

guard:arguments uninstall "$@" || exit $?

guard:require tool:jq
if [[ -z "$(settings:version)" ]]
then
  error "nothing to uninstall: kit.yml declares no kit version here"
  exit 1
fi
uninstall:run "$@"

# ----------------------------------------------------------------------------------------------------------------------
