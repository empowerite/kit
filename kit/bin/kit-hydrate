#!/usr/bin/env bash
# kit-hydrate - places what the active packages deliver under .kit/, from the declaration alone (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit hydrate [--quick]
#
# Reads the packages .kit/settings.yml declares and brings every path they deliver under .kit/ to its state: a link to
# its source when the source is inside the worktree, and otherwise a copy without the write bit. It writes
# .kit/.gitignore, which names those paths and itself, and .kit/manifest when it is missing. It chooses nothing; kit
# install chooses. It prints one line per path it placed or replaced, and says nothing about a path already in its
# state. It warns about a delivered path git still tracks, and about a file under a delivered directory that no active
# package delivers, both of which a person settles.
#
# Every verb that reads a delivered file hydrates first, so this verb is for a fresh clone or worktree before any
# other command. With --quick, for a shell hook such as mise's [hooks] enter = "kit hydrate --quick", it starts
# nothing and says nothing when everything is in place, or outside a repository that declares a kit version, and does
# the whole job otherwise.
#
#   --quick   for a shell hook, such as mise's enter hook: starts nothing and says nothing when everything is in place,
#             or outside a repository that declares a kit version
#
# Exits 0 on success, and 1 in a repository that declares no kit version, unless --quick.
#
# see: modules/bash/release.sh, docs/toolchains.md

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use release
guard:arguments hydrate "$@" || exit $?

if [[ "${1:-}" == --quick ]]
then
  [[ -n "$(release:declared-version)" ]] || exit 0
  release:hydrated && exit 0
else
  release:require-declaration
fi
release:hydrate --full
ok "kit $(release:version) hydrated .kit/, packages: $(release:declared-packages | paste -s -d ' ' -)"

# ----------------------------------------------------------------------------------------------------------------------
