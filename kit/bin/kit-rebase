#!/usr/bin/env bash
# kit-rebase - rebases a worktree's branch onto the default branch and pushes it (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit rebase [<path>]
#
# Rebases the branch checked out at <path> (default: the current checkout) onto the default branch at origin, and
# pushes it with --force-with-lease. kit rebase refuses:
#
#   - a checkout with no branch checked out
#   - the root checkout (the desk), which belongs to the human, whatever branch it has
#   - the default branch, in any checkout
#   - a worktree with uncommitted changes
#
#   <path>   the checkout whose branch to rebase; default: the current checkout
#
# On a conflict, kit rebase aborts and leaves the worktree as it was.
#
# see: modules/bash/git.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use git

guard:no-flags rebase "$@" || exit 2

guard:require tool:git
git:rebase "$@"

# ----------------------------------------------------------------------------------------------------------------------
