#!/usr/bin/env bash
# kit-rebase - rebases a branch onto the default branch and pushes it (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit rebase [<path>]
#
# Rebases the branch checked out at <path> onto the default branch at origin, and pushes it with
# --force-with-lease. kit rebase refuses:
#
#   - a checkout with no branch checked out
#   - the root checkout, the desk, which belongs to the human, whatever branch it has
#   - the default branch, in any checkout
#   - a worktree with uncommitted changes
#
#   <path>   the checkout whose branch to rebase; default: the current one
#
# On a conflict, kit rebase aborts and leaves the worktree as it was.
#
# Exits 0 when the branch is rebased and pushed, 1 on a refusal or a conflict, and 2 on a usage error.
#
# see: modules/bash/git.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use git

guard:arguments rebase "$@" || exit $?

guard:require tool:git
git:rebase "$@"

# ----------------------------------------------------------------------------------------------------------------------
