#!/usr/bin/env bash
# kit-commit - commits what is staged, after the kit's checks (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit commit [--all] (--message <text>… | --file <path>) [<path>…]
#
# Commits in a worktree, never on the desk or the default branch. Before the commit exists, kit commit:
#
#   - refuses when nothing is staged, and refuses a staged path the kit placed under .kit/
#   - runs kit lint and kit generate --check over the staged paths; no hook manager is needed
#   - puts the branch's issue in front of a subject that names none: 7-fix-the-thing gives #7
#   - judges the subject by the repository's policy, as kit policy does in CI
#   - warns when commits here are not signed
#
#   --all              stages every tracked change first, as git commit --all does
#   --message <text>   the message; the first is the subject, the rest are paragraphs
#   --file <path>      the message from a file; its first line is the subject
#   <path>…            commits these paths alone; each must be known to git
#
# A subject that names another issue attaches it to the branch's pull request: kit commit adds a Closes line for it
# to the pull request's body, and assigns the caller to it when no one is assigned.
#
# kit commit opens no editor.
#
# Exits 0 on a commit, 1 on a refusal, and 2 on a usage error.
#
# see: modules/bash/commit.sh, kit-submit

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use commit
guard:arguments commit "$@" || exit $?

guard:require tool:git tool:jq
commit:commit "$@"

# ----------------------------------------------------------------------------------------------------------------------
