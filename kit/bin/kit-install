#!/usr/bin/env bash
# kit-install - mirror the release into the repository, and into the home directory (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit install [<package>…]
#
# Sets up kit in a repository that does not have it yet:
#
#   1. Activates the default packages, the named packages, and the packages they depend on.
#   2. Places the files those packages deliver, in the repository and in the home directory.
#   3. Writes .kit/manifest, and ~/.kit/manifest when the packages deliver files to the home directory.
#
# When a different file is already at a delivered path, kit install names it and leaves it alone. It writes no
# manifest until every path is clear. A repository that already has .kit/manifest is refused: run kit update.
#
# Exits 0 on success, 2 for a package the release does not have, and 1 for any other failure.
#
# see: bash/release.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../bash/1st.sh"
kit:enter
use release

if [[ "${1:-}" == --help ]]
then
  echo "usage: kit install [<package>…]" >&2
  exit 0
fi

guard:require tool:jq
release:require-packages "${kit_root}" "$@"
if [[ -f .kit/manifest ]]
then
  error "run: kit update (this repository already carries kit $(release:manifest-version))"
  exit 1
fi
readarray -t defaults < <(release:default-packages "${kit_root}")
readarray -t packages < <(release:resolve "${kit_root}" "${defaults[@]}" "$@")
release:render-all "${kit_root}" "${packages[@]}"
section "kit install $(release:version), packages: ${packages[*]}"
refused=0
for base in $(release:bases)
do
  release:place-all "${kit_root}" "${base}" "${packages[@]}" || refused=$(( refused + $? ))
done
if (( refused > 0 ))
then
  error "${refused} path(s) already hold a different file; move each aside, then run: kit install"
  exit 1
fi
release:write-manifests "${packages[@]}"
release:finish "${packages[@]}"

# ----------------------------------------------------------------------------------------------------------------------
