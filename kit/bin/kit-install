#!/usr/bin/env bash
# kit-install - mirrors the release into the repository, and into the home directory (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit install [<package>…]
#
# Sets up kit in a repository that does not have it yet:
#
#   1. Activates the default packages, the named packages, and the packages they depend on and include.
#   2. Places the files those packages deliver, in the repository and in the home directory.
#   3. Declares the version and the packages in .kit/settings.yml, and writes .kit/manifest, and ~/.kit/manifest
#      when the packages deliver files to the home directory.
#
#   <package>…   packages to activate beside the default ones, by name or by a glob such as 'style/*'; each must
#                be in the release or under .kit/packages/
#
# When a different file is already at a delivered path, kit install names it and leaves it alone. It writes no
# manifest until every path is clear. A repository whose .kit/settings.yml already declares a kit version is
# refused: run kit update.
#
# Exits 0 on success, 2 for a package that is neither in the release nor under .kit/packages/, and 1 for any
# other failure.
#
# see: modules/bash/release.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use release

guard:no-flags install "$@" || exit 2

guard:require tool:jq
# A glob such as style/* stands for every package it matches.
expanded=$(release:expand "${kit_root}" "$@") || exit 2
readarray -t named < <(awk 'NF' <<<"${expanded}")
set -- "${named[@]}"
release:require-packages "${kit_root}" "$@"
if [[ -n "$(release:declared-version)" ]]
then
  error "run: kit update (this repository already declares kit $(release:declared-version))"
  exit 1
fi
readarray -t defaults < <(release:default-packages "${kit_root}")
readarray -t packages < <(release:resolve "${kit_root}" '' "${defaults[@]}" "$@")
release:render-all "${kit_root}" "${packages[@]}"
section "kit install $(release:version), packages: ${packages[*]}"
refused=0
for base in $(release:bases)
do
  release:place-all "${kit_root}" "${base}" "${packages[@]}" || refused=$(( refused + $? ))
done
if (( refused > 0 ))
then
  error "${refused} path(s) already hold a different file; move each aside, then run: kit install"
  exit 1
fi
release:write-manifests '' "${packages[@]}"
release:materialize "${packages[@]}"
release:finish "${packages[@]}"

# ----------------------------------------------------------------------------------------------------------------------
