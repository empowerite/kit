#!/usr/bin/env bash
# kit-gate - run the repository's gate, and refuse when there is none (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit gate takes no arguments. It runs the repository's gate, the repository's own CI command. The gate is the
# first of:
#
#   1. the `gate` setting in .kit/settings.yml
#   2. `just ci`, when the root justfile has a ci recipe
#   3. `make ci`, when the Makefile has a ci target
#   4. `npm run ci`, when package.json has a ci script
#
# The gate runs with the declared toolchains' tools, inside the container when the toolchain is docker.
#
# kit gate fails, and prints the remedy, when the repository has no gate or the root justfile cannot be read. A
# gate that cannot run never counts as a pass. On a CI runner, each outcome is also written to the step summary.
#
# Exits 0 when the gate passes, and 1 otherwise.
#
# see: bash/toolchain.sh, packages/ci-github/templates/repo/.github/workflows/kit-ci.yml

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../bash/1st.sh"
kit:enter
use release toolchain

if [[ "${1:-}" == --help ]]
then
  echo "usage: kit gate" >&2
  exit 0
fi

# detect-gate prints the command of the first gate found, or nothing. It fails when the root justfile cannot be read.
detect-gate() {
  local recipes
  if [[ -f justfile || -f Justfile || -f .justfile ]]
  then
    if ! recipes=$(just --summary 2>&1)
    then
      error "the root justfile could not be read: ${recipes}"
      summary "### ❌ The root justfile could not be read" "" "${recipes}"
      return 1
    fi
    tr ' ' '\n' <<<"${recipes}" | grep --quiet --line-regexp ci && printf 'just ci\n' && return 0
  fi
  if [[ -f Makefile ]] && grep --quiet '^ci:' Makefile
  then
    printf 'make ci\n'
    return 0
  fi
  if [[ -f package.json ]] && jq --exit-status '.scripts.ci' package.json >/dev/null 2>&1
  then
    printf 'npm run ci\n'
    return 0
  fi
  return 0
}

gate=$(release:setting gate)
[[ -n "${gate}" ]] || gate=$(detect-gate) || exit 1
if [[ -z "${gate}" ]]
then
  error "set gate in .kit/settings.yml, or give the root justfile a ci recipe; there is no gate to run"
  # shellcheck disable=SC2016  # markdown code spans, not expansions
  summary "### ❌ The gate cannot run: the repository has none" "" \
    'Set `gate` in `.kit/settings.yml`, or give the root justfile a `ci` recipe.'
  exit 1
fi
step "the gate: ${gate}"
if ! toolchain:run bash -c "${gate}"
then
  error "the gate failed: ${gate}"
  summary "### ❌ The gate failed: \`${gate}\`"
  exit 1
fi
summary "✅ The gate passed: \`${gate}\`."

# ----------------------------------------------------------------------------------------------------------------------
