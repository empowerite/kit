#!/usr/bin/env bash
# kit-package - lists, activates, or deactivates the packages this repository takes (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit package [list | select <package>… | add <package>… | remove <package>…]
#
#   list                 prints every package in reach, with a ✅ beside the active ones and a ❌ beside the
#                        excluded ones, its origin (release or repository), and its description. This is the default.
#   select <package>…    makes exactly the named packages, with the packages they depend on and the members they
#                        include, the active set: it removes what the set omits, adds what it lacks, and says which
#                        active package it kept for another's sake; with nothing to change it says the set
#   add <package>…       activates the packages, the packages they depend on, and the members they include, places
#                        the files they deliver, and rewrites the manifests. When a different file is already at a
#                        delivered path, it is named and left alone, and no manifest is written. A package named
#                        here is no longer excluded.
#   remove <package>…    takes out what the packages delivered (files, the kit's JSON entries, and the kit's
#                        regions) and rewrites the manifests. A package that an active package depends on is refused.
#                        A member of a bundle that stays active is recorded as excluded, so that kit update does not
#                        bring it back.
#   <package>…           a package's name, such as style/bash, or a glob over names, such as 'style/*'; each must
#                        be in the release or under .kit/packages/
#
# Exits 0 on success, 2 on a usage error or a package that is neither in the release nor under .kit/packages/, and
# 1 for any other failure.
#
# see: modules/bash/package.sh, modules/bash/release.sh, docs/packages.md

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use release package
guard:arguments package "$@" || exit $?

verb=${1:-list}
shift || true
release:require-declaration

case "${verb}" in
  (list)
    readarray -t active < <(release:declared-packages)
    readarray -t excluded < <(release:declared-excludes)
    width=$(release:packages | awk 'length > w { w = length } END { print w }')
    for package in $(release:packages)
    do
      if release:among "${package}" "${active[@]}"
      then mark='✅'
      elif release:among "${package}" "${excluded[@]}"
      then mark='❌'
      else mark='  '
      fi
      printf '%s %-*s %-10s %s\n' "${mark}" "${width}" "${package}" "$(release:origin "${kit_root}" "${package}")" \
        "$(release:description "${kit_root}" "${package}")"
    done
    ;;
  (select) package:select "$@" ;;
  (add) package:add "$@" ;;
  (remove) package:remove "$@"
esac

# ----------------------------------------------------------------------------------------------------------------------
