#!/usr/bin/env bash
# kit-package - list, activate, or deactivate the packages this repository takes (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit package list | add <package>… | remove <package>…
#
#   list                 prints every package in reach, with a ✅ beside the active ones, its origin (release or
#                        repository), and its description. This is the default.
#   add <package>…       activates the packages and the packages they depend on, places the files they deliver,
#                        and rewrites the manifests. When a different file is already at a delivered path, it is
#                        named and left alone, and no manifest is written.
#   remove <package>…    takes out what the packages delivered (files, the kit's JSON entries, and the kit's
#                        regions) and rewrites the manifests. A package that an active package depends on is refused.
#
# Exits 0 on success, 2 on a usage error or a package the release does not have, and 1 for any other failure.
#
# see: bash/release.sh, docs/packages.md

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../bash/1st.sh"
kit:enter
use release

usage() { echo "usage: kit package list | kit package add <package>… | kit package remove <package>…" >&2; }

verb=${1:-list}
shift || true
case "${verb}" in
  (--help) usage; exit 0 ;;
  (list | add | remove) ;;
  (*) usage; exit 2
esac
release:require-manifest
readarray -t active < <(release:manifest-packages)

case "${verb}" in
  (list)
    for package in $(release:packages)
    do
      if release:among "${package}" "${active[@]}"
      then mark='✅'
      else mark='  '
      fi
      printf '%s %-10s %-10s %s\n' "${mark}" "${package}" "$(release:origin "${kit_root}" "${package}")" \
        "$(release:description "${kit_root}" "${package}")"
    done
    ;;
  (add)
    (( $# > 0 )) || { usage; exit 2; }
    guard:require tool:jq
    release:require-packages "${kit_root}" "$@"
    readarray -t wanted < <(release:resolve "${kit_root}" "${active[@]}" "$@")
    release:render-all "${kit_root}" "${wanted[@]}"
    section "kit package add $*"
    refused=0
    for base in $(release:bases)
    do
      while IFS= read -r path
      do
        [[ -n "${path}" ]] || continue
        release:place-new "$(release:source-of "${kit_root}" "${base}" "${path}" "${wanted[@]}")" \
          "$(release:dest "${base}" "${path}")" "placed" || refused=$(( refused + 1 ))
      done < <(release:paths-beyond "${kit_root}" "${base}" "${active[*]}" "${wanted[*]}")
    done
    if (( refused > 0 ))
    then
      error "${refused} path(s) already hold a different file; move each aside, then run: kit package add $*"
      exit 1
    fi
    release:write-manifests "${wanted[@]}"
    ok "packages: ${wanted[*]}"
    release:say-unmet "${wanted[@]}"
    ;;
  (remove)
    (( $# > 0 )) || { usage; exit 2; }
    guard:require tool:jq
    release:require-packages "${kit_root}" "$@"
    remaining=("${active[@]}")
    for package in "$@"
    do
      release:among "${package}" "${active[@]}" || step "${package}: not active"
      readarray -t remaining < <(release:without "${package}" "${remaining[@]}")
    done
    # Dependents are checked against the packages that remain, so the order of the named packages does not matter.
    for package in "$@"
    do
      readarray -t dependents < <(release:dependents "${kit_root}" "${package}" "${remaining[@]}")
      if (( ${#dependents[@]} > 0 ))
      then
        error "${package} cannot be removed while ${dependents[*]} depend(s) on it"
        exit 1
      fi
    done
    release:render-all "${kit_root}" "${active[@]}"
    section "kit package remove $*"
    for base in $(release:bases)
    do
      while IFS= read -r path
      do
        [[ -n "${path}" ]] || continue
        release:unplace "$(release:source-of "${kit_root}" "${base}" "${path}" "${active[@]}")" \
          "$(release:dest "${base}" "${path}")"
      done < <(release:paths-beyond "${kit_root}" "${base}" "${remaining[*]}" "${active[*]}")
    done
    release:write-manifests "${remaining[@]}"
    ok "packages: ${remaining[*]:-none}"
esac

# ----------------------------------------------------------------------------------------------------------------------
