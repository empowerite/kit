#!/usr/bin/env bash
# kit-root - prints the directory of the release that runs (kit verb: plumbing)
# ----------------------------------------------------------------------------------------------------------------------
# kit root takes no arguments. It prints the release's directory, the one that holds bin/ and modules/. A script
# outside the kit can load its modules that way, without being a verb: source "$(kit root)/modules/bash/1st.sh", or
# in a justfile, export BASH_ENV := `kit root` / "modules/bash/1st.sh". It reads nothing from the repository, so it
# runs outside one.
#
# Exits 0, and 2 on a usage error.
#
# see: modules/bash/1st.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"

guard:arguments root "$@" || exit $?

printf '%s\n' "${kit_root}"

# ----------------------------------------------------------------------------------------------------------------------
