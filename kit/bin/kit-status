#!/usr/bin/env bash
# kit-status - shows where the work stands, from backlog to releases (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit status [--no-fetch] [--text | --json | --jq] [--all | [--mine] [--others] [--owner=<login>…]]
#
# Draws the picture of the work. It changes nothing. Work moves left to right through five stages:
#
#   backlog → incoming → worktrees → changes → releases
#
# The status setting in kit.yml names the stages drawn, in order. On a terminal, kit status opens the picture in
# kittui. Without one, or with --text, it prints the stages as text. Where it runs decides what worktrees and
# changes draw:
#
#   - at a desk: the desk, every linked worktree, and every open pull request
#   - in a worktree: that worktree, and the pull request its branch holds
#   - above desks, in a directory inside no repository: each desk below it, under its path, four levels down
#
# backlog, incoming, and releases draw the same anywhere. A repository with no origin draws its checkouts, fetches
# nothing, and says so once.
#
#   --no-fetch          skips the git fetch; incoming says so
#   --text              prints the picture as text, even on a terminal
#   --json              the picture as one JSON object, each stage under its name
#   --jq                the same JSON, formatted by jq for a person
#   --mine              only the caller's: assigned issues, and opened pull requests
#   --others            everyone else's; unassigned issues included
#   --all               every issue and pull request (the default); it stands alone
#   --owner=<login>     only the named login's; give it once or more
#   --stages            prints the stages the picture draws, one per line, in order
#   --today             only the issues opened in the last 24 hours
#   <number>…           only these pull requests, by number or issue closed: #7
#   backlog             the open issues no pull request closes, oldest first
#   incoming            what the fetch brought: default-branch commits, branches new and gone
#   worktrees           the desk and every worktree: branch, ahead and behind, uncommitted paths
#   changes             the open pull requests, each with the issues it closes
#   releases            the releases on the forge, newest first
#
# The filters combine: --mine --owner=bob. --mine alone leaves out the owner column.
#
# kit status --stages
#
# kit status backlog [--json | --jq] [--today] [--all | [--mine] [--others] [--owner=<login>…]]
#
# kit status incoming [--no-fetch] [--json | --jq]
#
# kit status worktrees [--json | --jq]
#
# kit status changes [--json | --jq] [--all | [--mine] [--others] [--owner=<login>…]] [<number>…]
#
# kit status releases [--json | --jq]
#
# One stage prints without its heading. With --json, a stage prints what the picture holds under its name: an array
# for backlog, changes, and releases; an object for incoming and worktrees.
#
# Legend
#
# The glyphs every stage draws. NO_COLOR removes the colors and keeps the glyphs.
#
#   🏠  the desk, the root checkout
#   🌿  a linked worktree, or a branch: a pull request's checked-out one, or the one started for an issue
#   📂  a desk's path, above desks
#   📥  what the fetch brought from origin
#   🔀  a pull request, or a merge request on GitLab
#   👤  its author, or an issue's assignees
#   🎫  an issue
#   🛫  an issue in flight: the pull request above it closes it
#   🔖  a branch whose upstream is gone
#   📌  a new tag the fetch brought, in the incoming stage
#   ❗  a checkout on no branch, a detached HEAD
#   🏃  checks still running, ✅ every check passed, ❌ a check failed, each with passed / total
#   💬  unresolved review threads
#   📦  a release, 🧪 a pre-release, 📝 a draft, and ⭐ the latest, in the releases stage
#
# A pull request's state is one glyph, the first of these that holds:
#
#   🔨  draft
#   🚦  queued: a check is still running
#   💥  conflicted with its base
#   🔥  failing:gate: a check failed
#   📭  no-check: no check has reported
#   💬  comments:open: a review thread is unresolved
#   👀  blocked:approval: a review blocks the merge
#   🛬  ready: nothing is left to decide
#   🔳  any other state
#
# Exits 0 when the picture is drawn, 1 when the forge or the fetch cannot be read, and 2 on a usage error or a
# status setting that is not a list of distinct stages.
#
# see: modules/bash/status.sh, modules/bash/backlog.sh, modules/bash/changes.sh, modules/bash/releases.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use status tui
guard:arguments status "$@" || exit $?
guard:require tool:git

if [[ -n "${syntax_options[--stages]+x}" ]]
then
  settings:stages
  exit 0
fi

# On a terminal inside a repository, with no stage asked for and no form chosen, the picture is kittui's, which
# runs this kit. Without a kittui, or above desks, the text picture prints, as it does without a terminal.
if [[ -z "${syntax_literals[0]:-}${syntax_options[--text]+x}${syntax_options[--json]+x}" && -t 0 && -t 1 && -t 2 ]] \
  && git rev-parse --git-dir >/dev/null 2>&1 && tui:binary --probe >/dev/null 2>&1
then
  binary=$(tui:binary) || exit 1
  export KIT="${kit_root}/bin/kit"
  exec "${binary}" status "$@"
fi

status:render "$@"

# ----------------------------------------------------------------------------------------------------------------------
