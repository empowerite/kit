#!/usr/bin/env bash
# kit-incoming - fetches origin and says what came in, as kit status opens (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit incoming takes no arguments. It fetches origin, pruning the branches gone from it, and prints one line, the one
# kit status opens with: 📥 origin: unchanged, or what the fetch brought, such as 2 new commits on main · 1 new branch.
#
# Exits 0 when origin was fetched, and 1 when the fetch fails.
#
# see: modules/bash/status.sh, kit-status

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use status
guard:arguments incoming "$@" || exit $?

guard:require tool:git
status:incoming

# ----------------------------------------------------------------------------------------------------------------------
