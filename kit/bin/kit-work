#!/usr/bin/env bash
# kit-work - starts or resumes work on issues (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
# kit work <reference>…
#
# kit work --title <text> [<reference>…]
#
# kit work --pr <number> <reference>…
#
# Starts work on issues, or resumes it. kit work makes each of these, and reuses any that already exists:
#
#   - a branch linked to the issue
#   - a worktree for the branch, hydrated: what the kit delivers under .kit/ is in place
#   - a start commit
#   - a draft pull request, so the team sees the work at once
#
# Every issue it starts is assigned to the caller, whose worktree it is.
#
# The desk, the root checkout, is the human's. kit work refuses an issue whose branch the desk has checked out,
# before it assigns, stashes, or commits anything. Uncommitted work on the desk is swept into the new worktree. When
# the swept work conflicts there, it stays in the stash, kit work names the command that applies it, and stops. When
# kit work stops before the worktree has that work otherwise, the work goes back to the desk, staged work staged.
# When another session's stash lands on top of the sweep's, kit work sweeps nothing, and names the stash that holds
# the desk's work.
#
#   <reference>…     the issues, each named with its tracker: 7, #7, or AB#4521; the first is the primary, and the
#                    one pull request closes them all
#   --title <text>   creates an issue with that title and starts it; with references, creates it as their parent,
#                    as kit gather does, and starts it with them
#   --pr <number>    adds the issues to one of the caller's own open pull requests instead: each is assigned to the
#                    caller and closed by it
#
# 7 and #7 name an issue on the forge, the service that hosts the repository: GitHub or GitLab. AB#4521 names an
# Azure DevOps work item, when kit.yml declares that tracker. kit work asks nothing itself; kit tui asks for the
# title when kit work is given neither.
#
# Exits 0 when the work is started or resumed, 1 on a refusal or when the forge or the trackers in kit.yml cannot be
# read, and 2 on a usage error or a reference no declared tracker reads.
#
# see: modules/bash/issue.sh, modules/bash/forge.sh, modules/bash/tracker.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use issue

guard:arguments work "$@" || exit $?
# shellcheck disable=SC2154  # syntax_operands and syntax_options are set by guard:arguments
if [[ -n "${syntax_options[--pr]+x}" ]]
then
  issue:start --pr "${syntax_options[--pr]}" "${syntax_operands[@]}"
elif [[ -n "${syntax_options[--title]+x}" ]]
then
  issue:start --title "${syntax_options[--title]}" "${syntax_operands[@]}"
else
  issue:start "${syntax_operands[@]}"
fi

# ----------------------------------------------------------------------------------------------------------------------
