#!/usr/bin/env bash
# kit-context - prints the rules that govern a file (kit verb: files)
# ----------------------------------------------------------------------------------------------------------------------
# kit context <path>… [--json | --jq]
#
# Prints the path of each rule that governs the given paths, once each. The rules come first, then the styles, of
# the path's kinds. Then come the rules of the kinds those kinds embed, so a justfile brings the bash rule. Each
# request is logged to kit/context.log in git's common directory.
#
#   <path>…    the files, relative to the current directory; need not exist
#   --json     one JSON object per path: path, kinds, and rules
#   --jq       the same JSON, formatted by jq for a person
#   --claude   runs as Claude Code's PreToolUse hook
#
# kit context --claude
#
# Runs as Claude Code's PreToolUse hook. It reads the hook's input on stdin, and answers with the rules that govern
# the file the tool is about to write, as additional context.
#
# Exits 0 when the rules are printed, 1 when a kind under .kit/kinds/ cannot be read, as one with no name: or one
# defined twice, and 2 on a usage error.
#
# see: modules/bash/context.sh, docs/context.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use context materialize
guard:arguments context "$@" || exit $?
materialize:hydrate

case "${1:-}" in
  (--claude)
    context:claude
    ;;
  (*)
    context:render "$@"
esac

# ----------------------------------------------------------------------------------------------------------------------
