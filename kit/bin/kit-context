#!/usr/bin/env bash
# kit-context - prints the rules that govern a file, and logs the request (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit context <path>… [--json]
#
# Prints the path of each rule that governs the given paths, once each: the rules, then the styles, of the kinds
# the path is of, and then the rules of the kinds those kinds embed, so a justfile brings the bash rule. With
# --json, it prints one JSON object per path with that path's kinds and rules. Each request is logged to
# kit/context.log in git's common directory.
#
#   <path>…    the files whose rules to print, relative to the current directory; a path need not exist yet
#   --json     prints one JSON object per path, with the path, its kinds, and its rules
#   --claude   runs as Claude Code's PreToolUse hook: reads the hook's input on stdin, and answers with the rules that
#              govern the file the tool is about to write
#
# kit context --claude
#
# Runs as Claude Code's PreToolUse hook. It reads the hook's input on stdin, and returns the rules that govern the
# file the tool is about to write, as additional context.
#
# Exits 2 on a usage error.
#
# see: modules/bash/context.sh, docs/context.md

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use context release
release:hydrate

case "${1:-}" in
  (--claude)
    context:claude
    ;;
  (*)
    context:render "$@"
esac

# ----------------------------------------------------------------------------------------------------------------------
