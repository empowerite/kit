#!/usr/bin/env bash
# kit-bots - lists, adopts, and forgets the bots that act for you (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit bots [--text | --json | --jq]
#   kit bots --add=<name> --app=<id> --key=<source> [--jobs=<job>…]
#   kit bots --remove=<name>
#   kit bots --check [--bot=<name>] [--text | --json | --jq]
#   kit bots [--bot=<name>] token
#
# A bot is a GitHub App you have set up to act for you. Its public facts are in kit/bots.yml under XDG_CONFIG_HOME, else
# ~/.config, which you may edit by hand; kit keeps your comments when it edits the file. Its private key is in the
# operating system's secret store, the macOS keychain or the Linux Secret Service, never in the file, and no form
# prints it. Where neither store exists, kit bots refuses, and names the one to install.
#
# With no option, it lists the bots. The list's JSON is {file, bots: [{name, host, app, owner, jobs, key}]}, key true
# where the store holds the bot's key. The bot a repository uses is the one kit.yml names as bot:, else the only one on
# its primary remote's host.
#
# --add adopts an App that exists, and proves its key before it stores anything: it signs for the App, reads it, finds
# an installation, this repository's where the App reaches it, else the App's first, mints an installation token, and
# revokes it. The name is the App's slug, so the bot's login is <name>[bot]. The host is the primary remote's,
# github.com outside a repository, which works as well as inside one. An App that is installed nowhere is refused, with
# the page to install it at. Adding a bot that is there replaces its entry and its key.
#
# --remove forgets a bot and deletes its key from the store; the App stays on the forge.
#
# --check compares the App's permissions with its jobs: what a job lacks, and what no job needs. It says whether the
# App's installation reaches this repository, and where not, the installation's page to add it on. The JSON is {name,
# installation, page, repository, reached, lacks, extra}. Outside a repository it judges the App's permissions alone,
# reached null. It exits 1 where the installation does not reach this repository.
#
# token prints an installation token narrowed to this repository, and only the token, for a pipe. It is good for an
# hour, and kit does not revoke it; it refuses outside a repository.
#
# Arguments:
#   --text            prints the bots as text, even on a terminal
#   --json            one JSON object, as above
#   --jq              the same JSON, formatted by jq for a person
#   --add             adopts the App that <name> is the slug of, with --app and --key
#   --app             the App's ID, a number
#   --key             the App's private key, a <source>
#   --jobs            what the bot is set up to do, one or more <job>, repeated or joined with :, as --jobs=work:review;
#                     work and review without it
#   --remove          forgets a bot and deletes its key
#   --check           compares the App's permissions with its jobs and its installation with this repository
#   --bot             the bot --check or token is for, a <name>; the one kit.yml names, else the only one on the
#                     primary remote's host, without it
#   token             prints an installation token for this repository
#   <name>            a bot's name, which is its App's slug: letters, digits, and -
#   <id>              a GitHub App's ID, as its settings page shows it
#   <source>          a PEM file, or keychain:<service>/<account>, an item another tool stored in the keychain; the
#                     key is read as is, CRLF line ends and PKCS#8 included, and kept with LF line ends
#   <job>             work, review, or workflows
#
# Exits 0 when it printed or edited, 1 when the file does not read, the App did not accept the key or is installed
# nowhere or does not reach this repository, or a store or a write failed, and 2 on a usage error, a key source that
# names nothing, or a name that is not the App's slug or a bot's.
#
# see: modules/bash/bots.sh, modules/bash/secrets.sh, issue #258

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use bots
guard:arguments bots "$@" || exit $?

action=list form=text formed='' name='' app='' key='' bot='' forms=0
jobs=()
for word in "$@"
do
  case "${word}" in
    (--text | --json | --jq) form=${word#--} formed=1 ;;
    (--add=* | --remove=*)
      action=${word%%=*} name=${word#*=}
      action=${action#--}
      forms=$(( forms + 1 ))
      ;;
    (--check | token)
      action=${word#--}
      forms=$(( forms + 1 ))
      ;;
    (--bot=)
      error "--bot names a bot: --bot=<name>"
      exit 2
      ;;
    (--bot=*) bot=${word#--bot=} ;;
    (--app=*) app=${word#--app=} ;;
    (--key=*) key=${word#--key=} ;;
    (--jobs=)
      error "--jobs names jobs: --jobs=work:review"
      exit 2
      ;;
    (--jobs=*)
      IFS=: read -r -a more <<<"${word#--jobs=}"
      jobs+=("${more[@]}")
      ;;
    (*)
      error "'${word}' is no option of kit bots; see: kit help bots"
      exit 2
  esac
done
if (( forms > 1 ))
then
  error "--add, --remove, --check, and token are forms of their own; run one: kit help bots"
  exit 2
fi
if [[ "${action}" == @(add|remove) && -z "${name}" ]]
then
  error "--${action} names a bot: --${action}=<name>"
  exit 2
fi
if [[ "${action}" != add && ( -n "${app}" || -n "${key}" || ${#jobs[@]} -gt 0 ) ]]
then
  error "--app, --key, and --jobs go with --add; see: kit help bots"
  exit 2
fi
if [[ "${action}" != @(list|check) && -n "${formed}" ]]
then
  error "--text, --json, and --jq are the forms of the list and --check; ${action} prints one line"
  exit 2
fi

if [[ -n "${bot}" && "${action}" != @(check|token) ]]
then
  error "--bot goes with --check and token; see: kit help bots"
  exit 2
fi

case "${action}" in
  (check)
    bot_json=$(bots:choose "${bot}") || exit $?
    check=$(bots:check "${bot_json}") || exit $?
    case "${form}" in
      (json) printf '%s\n' "${check}" ;;
      (jq) jq . <<<"${check}" ;;
      (text) bots:check-text "${check}" ;;
    esac
    [[ "$(jq --raw-output .reached <<<"${check}")" != false ]] || exit 1
    ;;
  (token)
    bot_json=$(bots:choose "${bot}") || exit $?
    token=$(bots:token "${bot_json}") || exit $?
    jq --raw-output .token <<<"${token}"
    ;;
  (add)
    [[ -n "${app}" ]] || { error "--add needs --app=<id>, the App's ID"; exit 2; }
    [[ -n "${key}" ]] || { error "--add needs --key=<source>, a PEM file or keychain:<service>/<account>"; exit 2; }
    bots:add "${name}" "${app}" "${key}" "${jobs[@]}"
    ;;
  (remove) bots:remove "${name}" ;;
  (list)
    list=$(bots:list)
    case "${form}" in
      (json) printf '%s\n' "${list}" ;;
      (jq) jq . <<<"${list}" ;;
      (text) bots:text "${list}" ;;
    esac
esac

# ----------------------------------------------------------------------------------------------------------------------
