#!/usr/bin/env bash
# kit-update - move the repository, and the home directory, to the pinned release (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit update takes no arguments. It moves the repository and the home directory from the release .kit/settings.yml
# declares (the previous release) to the pinned release. The active packages are resolved again from the pinned
# release: a package that an active one now depends on or includes comes in, and so does a new default package. A
# package .kit/settings.yml declares as excluded stays out, unless a package depends on it. For each delivered file:
#
#   - a file new in this release is written when nothing, or the same content, is there, and refused otherwise
#   - a merged JSON file is merged by key
#   - a region is regenerated
#   - a missing file is written
#   - a path under .kit/ is brought to its state: a link to its source, or a readonly copy (see release:owned)
#   - any other file unchanged since the previous release is replaced
#   - any other file edited since the previous release gets a three-way merge, which leaves conflict markers on a
#     conflict
#
# A merge by key, or a three-way merge, needs the previous release as its base. The base is the first of:
#
#   1. the directory KIT_BASE names
#   2. this release, when the previous release is the same version
#   3. the previous release, from the kit's cache, from mise, or downloaded from its public tarball (never for an
#      unreleased previous version)
#
# kit update checks that every merge has its base before it writes anything. When a base is missing, it writes
# nothing and the declared version stays the previous one, so the next run starts from the same place.
#
# Exits 0 when the update is complete, and 1 when a base is missing or a file needs to be resolved by hand.
#
# see: modules/bash/release.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use release

if [[ "${1:-}" == --help ]]
then
  echo "usage: kit update" >&2
  exit 0
fi

guard:require tool:jq
release:require-declaration
readarray -t recorded < <(release:declared-packages)
readarray -t excluded < <(release:declared-excludes)
readarray -t defaults < <(release:default-packages "${kit_root}")
release:require-packages "${kit_root}" "${recorded[@]}"
# The active set is resolved again from this release; the header says what comes in and what stays out.
readarray -t packages < <(release:resolve "${kit_root}" "${excluded[*]}" "${defaults[@]}" "${recorded[@]}")
for package in "${excluded[@]}"
do
  if release:among "${package}" "${packages[@]}"
  then
    needed=$(release:dependents "${kit_root}" "${package}" "${packages[@]}" | paste -s -d ' ' -)
    warn "${package} was excluded, but ${needed} depends on it, so it is back"
  fi
done
readarray -t excluded < <(release:exclusions "${excluded[*]}" "${packages[@]}")
previous=$(release:declared-version)
current=$(release:version)
release:render-all "${kit_root}" "${packages[@]}"
section "kit update ${previous} → ${current}, packages: ${packages[*]}"

base_root=""
if [[ -n "${KIT_BASE:-}" ]]
then
  base_root=${KIT_BASE}
elif [[ "${previous}" == "${current}" ]]
then
  base_root=${kit_root}
elif [[ "${previous}" != "$(release:unreleased)" ]]
then
  base_root=$(release:fetch "${previous}" || true)
fi
# The base is read, not validated: the current release was validated above, and a package the base predates renders
# nothing from it.
if [[ -n "${base_root}" ]] && ! release:render-packages "${base_root}" "${packages[@]}"
then
  error "the base release at ${base_root} could not be read; see above"
  exit 1
fi

# recorded-digest <base> <path> prints the digest the manifest records for the path. When it records none, as in a
# fresh clone or bin/refresh's export, where the manifest is not committed, it prints the base release's digest of
# the path, read from base_delivered, when that release delivers it. A path with neither is new in this release.
recorded-digest() {
  local recorded src
  recorded=$(release:recorded "$1" "$2")
  if [[ -z "${recorded}" && -n "${base_delivered}" ]]
  then
    src=$(awk -F '\t' -v p="$2" '$1 == p { print $2 }' <<<"${base_delivered}")
    [[ -z "${src}" ]] || recorded=$(release:digest < "${src}")
  fi
  printf '%s\n' "${recorded}"
}

# lacks-base <base> <path> <src> is true when updating the path needs the base release, and the base release is
# missing.
lacks-base() {
  local base=$1 path=$2 src=$3 dest recorded kind
  dest=$(release:dest "${base}" "${path}")
  recorded=$(recorded-digest "${base}" "${path}")
  [[ -n "${recorded}" ]] || return 1
  # A materialized path is brought to its state from this release alone.
  if release:owned "${base}" "${path}" && [[ "$(release:kind "${src}" "${dest}")" == copy ]]
  then
    return 1
  fi
  [[ -z "${base_root}" || -z "$(release:source-of "${base_root}" "${base}" "${path}" "${packages[@]}")" ]] || return 1
  kind=$(release:kind "${src}" "${dest}")
  [[ "${kind}" == merge ]] && return 0
  [[ "${kind}" != region ]] && release:installed "${src}" "${dest}" >/dev/null 2>&1 \
    && [[ "${recorded}" != "$(release:installed "${src}" "${dest}" | release:digest)" ]]
}

# Find every path that lacks its base before writing anything, so an update is all or nothing.
skipped=0
base_delivered=""
for base in $(release:bases)
do
  [[ -z "${base_root}" ]] || base_delivered=$(release:delivered "${base_root}" "${base}" "${packages[@]}")
  while IFS=$'\t' read -r path src
  do
    [[ -n "${path}" ]] || continue
    if lacks-base "${base}" "${path}" "${src}"
    then
      error "$(release:dest "${base}" "${path}") cannot be updated without the base release ${previous};" \
        "set KIT_BASE to a copy of it"
      skipped=$(( skipped + 1 ))
    fi
  done < <(release:delivered "${kit_root}" "${base}" "${packages[@]}")
done
if (( skipped > 0 ))
then
  error "${skipped} path(s) stay at ${previous}, and so does the manifest; set KIT_BASE, then run: kit update"
  exit 1
fi

conflicts=0
for base in $(release:bases)
do
  [[ -z "${base_root}" ]] || base_delivered=$(release:delivered "${base_root}" "${base}" "${packages[@]}")
  while IFS=$'\t' read -r path src
  do
    [[ -n "${path}" ]] || continue
    dest=$(release:dest "${base}" "${path}")
    recorded=$(recorded-digest "${base}" "${path}")
    if [[ -z "${recorded}" ]]
    then
      release:place-new "${src}" "${dest}" "new in ${current}" || conflicts=$(( conflicts + 1 ))
      continue
    fi
    previous_src=""
    [[ -n "${base_root}" ]] && previous_src=$(release:source-of "${base_root}" "${base}" "${path}" "${packages[@]}")
    kind=$(release:kind "${src}" "${dest}")
    if release:owned "${base}" "${path}" && [[ "${kind}" == copy ]]
    then
      # A materialized path is a link to its source or a copy of the release's file, brought to that state, never
      # merged: an edit under .kit/ is nobody's to keep.
      case "$(release:materialize-one "${src}" "${dest}")" in
        (kept) step "${dest}: as ${current} has it" ;;
        (placed) step "${dest}: placed from ${current}" ;;
        (replaced) step "${dest}: replaced from ${current}"
      esac
      continue
    fi
    if [[ "${kind}" == merge ]]
    then
      step "${dest}: merged by key"
      release:place "${src}" "${dest}" "${previous_src}"
    elif [[ "${kind}" == region ]]
    then
      # A region's content comes from its command, so it is regenerated, never merged.
      step "${dest}: the region regenerated"
      release:place "${src}" "${dest}"
    elif ! release:installed "${src}" "${dest}" >/dev/null 2>&1
    then
      step "${dest}: missing, written"
      release:place "${src}" "${dest}"
    elif [[ "${recorded}" == "$(release:installed "${src}" "${dest}" | release:digest)" ]]
    then
      step "${dest}: unchanged since ${previous}, replaced"
      release:place "${src}" "${dest}"
    else
      step "${dest}: edited since ${previous}, three-way merged"
      if ! git merge-file --marker-size 7 "${dest}" "${previous_src}" "${src}"
      then
        warn "${dest}: conflict markers are left in the file; resolve them, then run: kit check"
        conflicts=$(( conflicts + 1 ))
      fi
    fi
  done < <(release:delivered "${kit_root}" "${base}" "${packages[@]}")
  release:retire "${base_root}" "${base}" "${previous}" "${current}" "${packages[@]}"
done

# Before the manifest is rewritten, so a path the loop refused to overwrite is still unrecorded, and stays as it is.
release:materialize "${packages[@]}"
release:write-manifests "${excluded[*]}" "${packages[@]}"
if (( conflicts > 0 ))
then
  error "${conflicts} file(s) need a hand; see above."
  exit 1
fi
release:finish "${packages[@]}"

# ----------------------------------------------------------------------------------------------------------------------
