#!/usr/bin/env bash
# kit-lint - run each rule's linter over the paths it governs (kit verb)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit lint [--all-files] [<path>…]
#
# Runs each rule's checks over the files the rule governs. The files are:
#
#   - the paths given, relative to the current directory; a directory stands for the tracked files under it
#   - with no paths, the staged files
#   - with no paths and --all-files, every tracked file
#
# Each file is matched to the rules that govern it, the same way kit context matches. Then, for each rule:
#
#   - When the rule's frontmatter has a `lint:` command, kit lint runs it once over all the rule's files. A linter
#     that is not on PATH is a failure, not a skip.
#   - When the rule's frontmatter lists names under `checks:`, kit lint runs each of the kit's own checks so named
#     over the rule's files. This release has one, `pinned`: every `uses:` in a workflow names a local action, a
#     docker image, or an action pinned to a full commit SHA with the version as a trailing comment.
#   - When the rule has templates, each of its files must have the shape of one of them.
#
# Files under .kit/templates/ are templates, not files of their kind, and are not linted.
#
# kit lint needs no hook manager. The hooks/lefthook package runs it from a pre-commit hook.
#
# Exits 0 when every rule passes, and 2 on an unknown flag. Otherwise the exit status is the number of rules that
# failed.
#
# see: bash/context.sh, bash/lint.sh, bash/template.sh, docs/context.md, docs/templates.md

set -o errexit -o nounset -o pipefail
# shellcheck source=SCRIPTDIR/../bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../bash/1st.sh"
kit:enter
use context lint template yaml release
[[ "${1:-}" == --help ]] || release:hydrate

all=false
paths=()
for arg in "$@"
do
  case "${arg}" in
    (--help)
      echo "usage: kit lint [--all-files] [<path>…]" >&2
      exit 0
      ;;
    (--all-files) all=true ;;
    (-*)
      error "unknown flag '${arg}' (usage: kit lint [--all-files] [<path>…])"
      exit 2
      ;;
    (*) paths+=("${arg}")
  esac
done
# git's lists are root-relative already, and NUL-separated so that a name with a space or a non-ASCII character
# survives.
if (( ${#paths[@]} == 0 ))
then
  if [[ "${all}" == true ]]
  then
    readarray -d '' -t paths < <(git ls-files -z)
  else
    readarray -d '' -t paths < <(git diff --cached --name-only --diff-filter=ACMR -z)
  fi
else
  named=("${paths[@]}")
  paths=()
  for path in "${named[@]}"
  do
    path=$(context:relative "${path}")
    if [[ -d "${path}" ]]
    then
      readarray -d '' -t under < <(git ls-files -z -- "${path}")
      paths+=("${under[@]}")
    else
      paths+=("${path}")
    fi
  done
fi
if (( ${#paths[@]} == 0 ))
then
  ok "nothing to lint"
  exit 0
fi

# The paths each rule governs, newline-separated, keyed by the rule file.
declare -A governed=()
for path in "${paths[@]}"
do
  [[ -f "${path}" && ! "${path}" =~ (^|/)\.kit/templates/ ]] || continue
  while IFS= read -r rule
  do
    [[ -n "${rule}" ]] || continue
    governed[${rule}]+="${path}"$'\n'
  done < <(context:rules "${path}")
done

refused=0
for rule in $(printf '%s\n' "${!governed[@]}" | LC_ALL=C sort)
do
  readarray -t targets < <(printf '%s' "${governed[${rule}]}")
  if [[ -n "$(template:variants "${rule}")" ]]
  then
    held=()
    while IFS= read -r path
    do
      [[ -n "${path}" ]] && ! template:exempt "${path}" && held+=("${path}")
    done < <(printf '%s' "${governed[${rule}]}")
    step "${rule}: the shape of its templates over ${#held[@]} path(s)"
    if (( ${#held[@]} > 0 )) && ! template:check "${rule}" "${held[@]}"
    then
      refused=$(( refused + 1 ))
    fi
  fi
  for name in $(yaml:list "${rule}" checks)
  do
    if ! declare -F "lint:${name}" >/dev/null
    then
      error "${rule} names a check the kit does not have: ${name}; the checks are: $(lint:names | paste -s -d ' ' -)"
      refused=$(( refused + 1 ))
      continue
    fi
    step "${rule}: the ${name} check over ${#targets[@]} path(s)"
    "lint:${name}" "${targets[@]}" || refused=$(( refused + 1 ))
  done
  linter=$(yaml:value "${rule}" lint)
  [[ -n "${linter}" ]] || continue
  read -r -a command <<<"${linter}"
  step "${rule}: ${linter} over ${#targets[@]} path(s)"
  if ! guard:require "tool:${command[0]}"
  then
    refused=$(( refused + 1 ))
    continue
  fi
  "${command[@]}" "${targets[@]}" || refused=$(( refused + 1 ))
done
if (( refused > 0 ))
then
  error "${refused} rule(s) refused; see above"
  exit "${refused}"
fi
ok "every governed path passes its rule's linter"

# ----------------------------------------------------------------------------------------------------------------------
