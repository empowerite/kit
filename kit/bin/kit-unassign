#!/usr/bin/env bash
# kit-unassign - takes the caller, or everyone, off issues (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
# kit unassign [--all] <reference>…
#
# Takes the caller off each issue's assignees, as each issue's tracker identifies the caller; with --all, takes every
# assignee off. An issue the caller is not assigned to is left as it is, and said.
#
#   --all            takes every assignee off, not only the caller
#   <reference>…     the issues, each named with its tracker: 7, #7, or AB#4521
#
# Exits 0 when every issue is unassigned, 1 when one could not be, and 2 on a usage error or a reference no declared
# tracker reads.
#
# see: modules/bash/issue.sh, modules/bash/tracker.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use issue

guard:arguments unassign "$@" || exit $?
declare -a refs=()
# shellcheck disable=SC2154  # syntax_operands and syntax_options are set by guard:arguments
for ref in "${syntax_operands[@]}"
do
  refs+=("$(tracker:normal "${ref}")") || exit 2
done
if [[ -n "${syntax_options[--all]+x}" ]]
then
  issue:unassign --all "${refs[@]}"
else
  issue:unassign "${refs[@]}"
fi

# ----------------------------------------------------------------------------------------------------------------------
