#!/usr/bin/env bash
# kit-new - makes a new file from the template of the rule that governs it (kit verb: files)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit new file <path> [--rule=<rule>] [--variant=<variant>] [--<hole>=<value>]…
#
# Makes a new file from a rule's template. Then it prints the rules to read before writing the rest of the file,
# as kit context does.
#
# kit new kind <name> [--path=<glob>…] [--content=<regex>…] [--kinds=<kind>…] [--embeds=<kind>…] [--package=<name>]
#
# Makes a kind of file in a package of the repository's own, at .kit/packages/<package>/files/repo/.kit/kinds/, as
# <name>.yml. It makes the package too when there is none. When the package is active it places the kind, so kit
# kind and kit context know it at once; otherwise it names the command that activates the package.
#
#   file                  makes a file from a template
#   kind                  makes a kind of file
#   <path>                the new file, relative to the repository root wherever the command runs. An absolute
#                         path inside the repository is accepted. A path outside it is refused.
#   --rule=<rule>         the rule whose template to use. Default: the most specific rule that governs the path
#                         and has templates. A script with no extension needs this flag.
#   --variant=<variant>   the template to use. Default: the first variant the rule lists that the path allows.
#   --<hole>=<value>      the value of a hole («name») within a line of the template. The holes path, name, and
#                         stem default to values taken from the path. Every other hole needs its flag.
#   <name>                the kind's name: a lowercase letter, then lowercase letters, digits, and dashes
#   --package=<name>      the package to put the kind in. Default: the repository's one package under
#                         .kit/packages/, or else local
#   --path=<glob>         a glob a path of the kind matches; ** matches any depth
#   --content=<regex>     an extended regular expression the first line of a file of the kind matches
#   --kinds=<kind>        a kind this kind is made of
#   --embeds=<kind>       a kind whose text appears inside this kind's files
#
# A kind needs at least one --path, --content, or --kinds.
#
# kit new never overwrites a file: an existing path, or a kind's name already defined, is refused.
#
# Exits 0 when the file is made, 1 when the path exists or the template is missing, and 2 on a usage error.
#
# see: modules/bash/template.sh, docs/templates.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use context template release new
guard:arguments new "$@" || exit $?
release:hydrate

if [[ "$1" == kind ]]
then
  shift
  new:kind "$@"
  exit $?
fi
shift

path='' rule_name='' variant=''
declare -A values=()
for arg in "$@"
do
  case "${arg}" in
    (--) ;;
    (--rule=?*) rule_name=${arg#--rule=} ;;
    (--variant=?*) variant=${arg#--variant=} ;;
    (--?*=*)
      key=${arg%%=*}
      key=${key#--}
      values[${key}]=${arg#*=}
      ;;
    (*) path=${arg}
  esac
done
# An absolute path inside the repository is made relative to the root. A path outside the repository is refused.
root=$(pwd -P)
if [[ "${path}" == /* ]]
then
  path=$(context:relative "${path}")
  if [[ "${path}" == /* ]]
  then
    error "${path} is outside the repository at ${root}"
    exit 2
  fi
fi
path=${path#./}
if [[ "${path}" == ../* || "${path}" == */../* ]]
then
  error "${path} climbs out of the repository; name it from the root"
  exit 2
fi
if [[ -e "${path}" ]]
then
  error "${path} is there already; kit new makes a file, it never overwrites one"
  exit 1
fi

resolved=$(new:resolve "${path}" "${rule_name}" "${variant}") || exit $?
IFS=$'\x1f' read -r rule chosen executable template <<<"${resolved}"

name=${path##*/}
values[path]=${values[path]:-${path}}
values[name]=${values[name]:-${name}}
values[stem]=${values[stem]:-${name%.*}}
missing=()
while IFS= read -r hole
do
  [[ -n "${hole}" && -z "${values[${hole}]+x}" ]] && missing+=("--${hole}=<…>")
done < <(template:holes "${template}")
if (( ${#missing[@]} > 0 ))
then
  error "the ${chosen} template of the $(template:rule-name "${rule}") rule needs ${missing[*]}"
  exit 2
fi

json='{}'
for key in "${!values[@]}"
do
  json=$(jq --compact-output --arg k "${key}" --arg v "${values[${key}]}" '.[$k] = $v' <<<"${json}")
done
mkdir -p "$(dirname "${path}")"
template:render "${template}" "${json}" > "${path}"
[[ "${executable}" == true ]] && chmod +x "${path}"
context:log "${path}"
ok "made ${path} from ${template}; read the rules below before writing the rest"
context:rules "${path}"

# ----------------------------------------------------------------------------------------------------------------------
