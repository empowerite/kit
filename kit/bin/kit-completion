#!/usr/bin/env bash
# kit-completion - prints the shell completion for kit, and the words it offers (kit verb: plumbing)
# ----------------------------------------------------------------------------------------------------------------------
#
# kit completion zsh
#
# Prints the zsh completion for kit. Put it on zsh's fpath as _kit, or evaluate it from .zshrc:
# eval "$(kit completion zsh)". It completes the verbs, each with its purpose, and each verb's flags, literal words,
# and the values a verb lists for an argument, such as the packages for kit package add, from the verbs themselves.
# A kit-<verb> command called directly completes the same way.
#
# kit completion candidates <word>…
#
# Prints what the last word may be, after the words before it, for the completion script: one candidate per line,
# the word, a tab, and its description, and :files when files fit as well.
#
#   zsh          prints the zsh completion script
#   candidates   prints the candidates for the last of the words
#   <word>…      the words typed so far, the first of them kit itself and the last the one being completed
#
# Exits 0, and 2 on a usage error.
#
# see: modules/bash/completion.sh, docs/completion.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use completion

guard:arguments completion "$@" || exit $?

case "$1" in
  (zsh) completion:zsh ;;
  (candidates)
    shift
    completion:candidates "$@"
esac

# ----------------------------------------------------------------------------------------------------------------------
