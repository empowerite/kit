#!/usr/bin/env bash
# kit-close - closes issues as not planned, or as a duplicate of another (kit verb: workflow)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit close (--not-planned | --duplicate-of <original>) <reference>…
#
# Closes each open issue with a reason. Work that is done closes its issues itself, when its pull request merges;
# kit close is for the issues no work will close.
#
# Each tracker closes as it can: GitHub keeps the reason, and links a duplicate to its original; GitLab keeps no
# reason, and links a duplicate by its /duplicate quick action; Azure DevOps sets the tracker's removed_state. A
# duplicate of an issue in another tracker gets a comment naming the original, and is closed as not planned. An issue
# already closed is left as it is.
#
# Arguments:
#   --not-planned              closes them as not planned
#   --duplicate-of <original>  closes them as duplicates of the original issue
#   <reference>…               the issues, each named with its tracker: 7, #7, or AB#4521
#
# Exits 0 when every issue is closed, 1 when one could not be or the trackers in kit.yml cannot be read, and 2 on a
# usage error or a reference no declared tracker reads.
#
# see: modules/bash/issue.sh, modules/bash/tracker.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use issue

guard:arguments close "$@" || exit $?
# shellcheck disable=SC2154  # syntax_operands and syntax_options are set by guard:arguments
if [[ -n "${syntax_options[--duplicate-of]+x}" ]]
then
  issue:close --duplicate-of "${syntax_options[--duplicate-of]}" "${syntax_operands[@]}"
else
  issue:close --not-planned "${syntax_operands[@]}"
fi

# ----------------------------------------------------------------------------------------------------------------------
