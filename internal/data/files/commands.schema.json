{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kit's commands",
  "type": "object",
  "properties": {
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "words": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z-]*$"}},
          "summary": {"type": "string", "minLength": 1},
          "help": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z-]*$"},
                "value": {"type": "string"},
                "help": {"type": "string", "minLength": 1},
                "many": {"type": "boolean"}
              },
              "required": ["name", "help"],
              "additionalProperties": false
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "many": {"type": "boolean"},
                "optional": {"type": "boolean"}
              },
              "required": ["name"],
              "additionalProperties": false
            }
          }
        },
        "required": ["words", "summary", "help"],
        "additionalProperties": false
      }
    }
  },
  "required": ["commands"],
  "additionalProperties": false
}
