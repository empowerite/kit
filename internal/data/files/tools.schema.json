{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kit's list of tools",
  "type": "object",
  "properties": {
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "tools"
  ],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "\\{version\\}"
        },
        "files": {
          "type": "object",
          "properties": {
            "darwin/arm64": {
              "$ref": "#/$defs/file"
            },
            "darwin/amd64": {
              "$ref": "#/$defs/file"
            },
            "linux/arm64": {
              "$ref": "#/$defs/file"
            },
            "linux/amd64": {
              "$ref": "#/$defs/file"
            }
          },
          "required": [
            "darwin/arm64",
            "darwin/amd64",
            "linux/arm64",
            "linux/amd64"
          ],
          "additionalProperties": false
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "checksums": {
          "type": "string",
          "pattern": "\\{file\\}"
        }
      },
      "required": [
        "github",
        "tag",
        "files",
        "program"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "string",
      "pattern": "\\.(tar\\.gz|zip)$"
    }
  }
}
