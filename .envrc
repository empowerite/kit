# shellcheck shell=bash
# .envrc - direnv entrypoint: put kit/bin on PATH, then hydrate .kit/
# ----------------------------------------------------------------------------------------------------------------------
# direnv runs this on cd. It does the kit's part only: kit/bin on PATH, and what the kit places under .kit/.
#
# Tools come from the project toolchain. One that activates through direnv adds its own line, as nix does with
# `use flake`.

PATH_add kit/bin
kit hydrate --quick

# ----------------------------------------------------------------------------------------------------------------------
