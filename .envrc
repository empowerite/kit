# shellcheck shell=bash
# .envrc - direnv entrypoint: put kit/bin and the kit toolchain's tools on PATH, then hydrate .kit/
# ----------------------------------------------------------------------------------------------------------------------
# direnv runs this on cd. It puts kit/bin on PATH, then each directory of the tools tools.lock pins for this platform,
# and places what the kit places under .kit/. kit tools path reads the lock alone, so a cd stays fast, and direnv runs
# this again when the lock changes. kit tools install puts the tools there; see: docs/toolchains/using-kit.md
#
# A toolchain that activates through direnv adds its own line instead, as nix does with `use flake`.

PATH_add kit/bin
watch_file tools.lock
# PATH_add keeps the order of the directories it is given at once: the toolchain's first, then those of the tools that
# fill in for it, such as brew's, then node_modules/.bin.
if dirs=$(kit tools path --toolchain kit) && [[ -n "${dirs}" ]]
then
  readarray -t dirs <<<"${dirs}"
  PATH_add "${dirs[@]}"
fi
kit hydrate --quick

# ----------------------------------------------------------------------------------------------------------------------
