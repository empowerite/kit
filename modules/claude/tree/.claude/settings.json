{
  "permissions": {
    "deny": [
      "Bash(git checkout main *)",
      "Bash(git switch main *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git worktree remove --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "kit context --claude"
          }
        ]
      }
    ]
  }
}
