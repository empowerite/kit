# issues.test - the issues jq module, run by jq -L kit/modules/jq --run-tests
#
# Each case is a program, an input, and the outputs it gives, one JSON value per line, then a blank line. The input
# is the open issues.

# An issue a change closes is underway, a row per change, with the change's branch; one no change closes is underway
# too when a branch is named for it, with that branch and no change, and else in the backlog; the oldest issue first.
import "issues" as issues; issues::rows([{"number": 3, "branch": "7-fix", "closes": [{"number": 7, "age": 100}]}, {"number": 4, "branch": "x", "closes": [{"number": 7, "age": 100}]}]; ["9-other", "main"]; {}; []) | map([.number, .status, .branch, .pr.number])
[{"number": 7, "age": 100}, {"number": 9, "age": 300}, {"number": 11, "age": 50}]
[[9,"underway","9-other",null],[7,"underway","7-fix",3],[7,"underway","x",4],[11,"backlog",null,null]]

# The branch named for an issue no change closes is the desk's before the primary's, a checked-out one first, and says
# where it is: here, in a checkout, or local, on the desk alone. Only a number and a dash name an issue: 90-x is not 9's.
import "issues" as issues; issues::rows([]; ["8-remote", "9-remote", "90-x"]; {"8-here": "/desk/worktrees/8-here"}; ["8-local", "8-here", "10-local"]) | map([.number, .status, .branch, .here, .local, .worktree])
[{"number": 8, "age": 300}, {"number": 9, "age": 200}, {"number": 10, "age": 100}, {"number": 11, "age": 50}]
[[8,"underway","8-here",true,false,"/desk/worktrees/8-here"],[9,"underway","9-remote",false,false,null],[10,"underway","10-local",false,true,null],[11,"backlog",null,null,null,null]]

# A backlog row has no change: pr, here, local, and worktree are null.
import "issues" as issues; issues::rows([]; []; {}; []) | map([.pr, .here, .local, .worktree])
[{"number": 9, "age": 300}]
[[null,null,null,null]]

# An issue underway takes its milestone, iteration, and swimlane from the open issue of its number, and none when no
# open issue has its number.
import "issues" as issues; issues::rows([{"number": 3, "branch": "b", "closes": [{"number": 7, "age": 100}, {"number": 8, "age": 90}]}]; []; {}; []) | map([.number, .milestone, .iteration, .swimlane])
[{"number": 7, "age": 100, "milestone": "v1", "iteration": "Sprint 4", "swimlane": "ops"}]
[[7,"v1","Sprint 4","ops"],[8,null,null,null]]

# Every row's keys start in one order, whatever its status, any other the issue holds after them.
import "issues" as issues; issues::rows([{"number": 3, "branch": "b", "closes": [{"number": 7, "age": 100}]}]; []; {}; []) | map(keys_unsorted)
[{"number": 7, "age": 100}, {"ref": "#9", "number": 9, "age": 300}]
[["number","title","assignees","labels","age","source","organization","repository","milestone","iteration","swimlane","status","branch","pr","here","local","worktree","ref"],["number","title","assignees","labels","age","source","organization","repository","milestone","iteration","swimlane","status","branch","pr","here","local","worktree"]]

# The owners keep the rows of an issue one of them is assigned, or with except, none of them; none keeps every row.
import "issues" as issues; [issues::by_owners(["ada"]; false), issues::by_owners(["ada"]; true), issues::by_owners([]; false)] | map(map(.number))
[{"number": 7, "assignees": ["ada"]}, {"number": 9, "assignees": []}, {"number": 11, "assignees": null}]
[[7],[9,11],[7,9,11]]
