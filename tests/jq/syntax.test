# syntax.test - the syntax jq module, run by jq -L kit/modules/jq --run-tests
#
# Each case is a program, an input, and the outputs it gives, one JSON value per line, then a blank line.

# The key of each kind of node, as the arguments object is keyed: a wildcard option keeps its angle brackets.
import "syntax" as syntax; map(syntax::key)
[{"kind":"flag","name":"all"},{"kind":"option","name":"message","value":"text","inline":false,"repeat":true},{"kind":"option","name":"hole","value":"value","inline":true,"wildcard":true},{"kind":"operand","name":"path","repeat":true},{"kind":"literal","name":"list","repeat":false}]
["--all","--message","--<hole>","<path>","list"]

# A sequence renders as the usage line it was read from: brackets, alternatives, values inline or apart, and ….
import "syntax" as syntax; syntax::render
[{"kind":"group","optional":true,"alternatives":[[{"kind":"flag","name":"all","repeat":false}]],"repeat":false},{"kind":"group","optional":false,"alternatives":[[{"kind":"option","name":"message","value":"text","inline":false,"repeat":true}],[{"kind":"option","name":"file","value":"path","inline":false,"repeat":false}]],"repeat":false},{"kind":"group","optional":true,"alternatives":[[{"kind":"operand","name":"path","repeat":true}]],"repeat":false}]
"[--all] (--message <text>… | --file <path>) [<path>…]"

# A literal, an inline option, and a wildcard in a group that repeats.
import "syntax" as syntax; syntax::render
[{"kind":"literal","name":"file","repeat":false},{"kind":"option","name":"rule","value":"rule","inline":true,"repeat":false},{"kind":"group","optional":true,"alternatives":[[{"kind":"option","name":"hole","value":"value","inline":true,"wildcard":true,"repeat":false}]],"repeat":true}]
"file --rule=<rule> [--<hole>=<value>]…"

# One node renders alone too.
import "syntax" as syntax; syntax::render
{"kind":"operand","name":"path","repeat":true}
"<path>…"

# undescribed lists the keys the syntax names and the arguments object lacks, once each, in order of appearance.
import "syntax" as syntax; syntax::undescribed
{"syntax":[[{"kind":"literal","name":"list","repeat":false}],[{"kind":"literal","name":"add","repeat":false},{"kind":"operand","name":"package","repeat":true}],[{"kind":"literal","name":"remove","repeat":false},{"kind":"operand","name":"package","repeat":true}]],"arguments":{"list":{"description":"x"}}}
["add","<package>","remove"]

# A verb that takes nothing has nothing undescribed.
import "syntax" as syntax; syntax::undescribed
{"syntax":[[]],"arguments":{}}
[]

# match sorts a complete line: the literal that selected the alternative, the operands with the dash-words a trailing
# operand takes, and the options given.
import "syntax" as syntax; syntax::match(["run","bash","-c","echo hi"])
{"verb":"toolchain","syntax":[[{"kind":"group","optional":false,"alternatives":[[{"kind":"literal","name":"list","repeat":false}],[{"kind":"literal","name":"run","repeat":false},{"kind":"operand","name":"command","repeat":true}]],"repeat":false}]]}
{"status":0,"literals":["run"],"operands":["bash","-c","echo hi"],"options":{},"values":{"<command>":["bash","-c","echo hi"]}}

# A required group with nothing given is what is missing, named by the first key of each alternative.
import "syntax" as syntax; syntax::match(["--all"])
{"verb":"commit","syntax":[[{"kind":"group","optional":true,"alternatives":[[{"kind":"flag","name":"all","repeat":false}]],"repeat":false},{"kind":"group","optional":false,"alternatives":[[{"kind":"option","inline":false,"name":"message","value":"text","repeat":true}],[{"kind":"option","inline":false,"name":"file","value":"path","repeat":false}]],"repeat":false},{"kind":"group","optional":true,"alternatives":[[{"kind":"operand","name":"path","repeat":true}]],"repeat":false}]]}
{"status":1,"missing":"--message or --file","literals":[],"operands":[],"options":{"--all":["1"]},"values":{"--all":["1"]}}

# Two alternatives of one group together, an option without its value, a word no alternative takes, and a flag given
# with a value are each refused in the CLI's words.
import "syntax" as syntax; [syntax::match(["--message","m","--file","f"]), syntax::match(["--message"]), syntax::match(["--bogus"]), syntax::match(["--all=1"])] | map(.refusal)
{"verb":"commit","syntax":[[{"kind":"group","optional":true,"alternatives":[[{"kind":"flag","name":"all","repeat":false}]],"repeat":false},{"kind":"group","optional":false,"alternatives":[[{"kind":"option","inline":false,"name":"message","value":"text","repeat":true}],[{"kind":"option","inline":false,"name":"file","value":"path","repeat":false}]],"repeat":false},{"kind":"group","optional":true,"alternatives":[[{"kind":"operand","name":"path","repeat":true}]],"repeat":false}]]}
["--message cannot be combined with --file; run: kit help commit","--message needs a value; run: kit help commit","unknown flag '--bogus'; run: kit help commit","unknown flag '--all=1'; run: kit help commit"]

# -- ends the flags, an option given twice keeps both values, and a flag given twice counts once.
import "syntax" as syntax; syntax::match(["--message","a b","--message=c","--all","--all","--","--weird"])
{"verb":"commit","syntax":[[{"kind":"group","optional":true,"alternatives":[[{"kind":"flag","name":"all","repeat":false}]],"repeat":false},{"kind":"group","optional":false,"alternatives":[[{"kind":"option","inline":false,"name":"message","value":"text","repeat":true}],[{"kind":"option","inline":false,"name":"file","value":"path","repeat":false}]],"repeat":false},{"kind":"group","optional":true,"alternatives":[[{"kind":"operand","name":"path","repeat":true}]],"repeat":false}]]}
{"status":0,"literals":[],"operands":["--weird"],"options":{"--message":["a b","c"],"--all":["1"]},"values":{"--message":["a b","c"],"--all":["1"],"<path>":["--weird"]}}

# A verb that takes nothing refuses any word, and a wildcard option takes any --x=y no named option took.
import "syntax" as syntax; [syntax::match(["--json"]), ({"verb":"new","syntax":[[{"kind":"literal","name":"file","repeat":false},{"kind":"operand","name":"path","repeat":false},{"kind":"group","optional":true,"alternatives":[[{"kind":"option","wildcard":true,"inline":true,"name":"hole","value":"value","repeat":false}]],"repeat":true}]]} | syntax::match(["file","p","--purpose=x"]))]
{"verb":"version","syntax":[[]]}
[{"status":2,"refusal":"kit version takes no arguments; run: kit help version"},{"status":0,"literals":["file"],"operands":["p"],"options":{"--purpose":["x"]},"values":{"--purpose":["x"],"<path>":["p"]}}]

# A word for an operand that opens one alternative cannot go with a flag that selects another.
import "syntax" as syntax; [syntax::match(["7","--title","x"]), syntax::match(["--title","x"]), syntax::match(["7"])] | map(.refusal // .status)
{"verb":"issue","syntax":[[{"kind":"group","optional":false,"alternatives":[[{"kind":"operand","name":"reference","repeat":true}],[{"kind":"option","inline":false,"name":"title","value":"text","repeat":false}]],"repeat":false}]]}
["<reference> cannot be combined with --title; run: kit help issue",0,0]
