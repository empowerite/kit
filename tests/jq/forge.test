# forge.test - the forge jq module, run by jq -L kit/modules/jq --run-tests
#
# Each case is a program, an input, and the outputs it gives, one JSON value per line, then a blank line. Every case
# fixes the time as $now, 1000000 seconds after the epoch.

# A time reads the same with or without fractional seconds.
import "forge" as forge; map(forge::epoch)
["1970-01-12T13:46:40Z", "1970-01-12T13:46:40.123Z"]
[1000000,1000000]

# A time with an offset, as az prints one, microseconds and all, reads as the same instant in UTC.
import "forge" as forge; map(forge::epoch)
["1970-01-12T13:46:40.123000+00:00", "1970-01-12T14:46:40+01:00", "1970-01-12T08:16:40.5-05:30", "1970-01-12T13:46:40+0000"]
[1000000,1000000,1000000,1000000]

# A time that is no ISO 8601 time is an error, not nothing.
import "forge" as forge; [.[] | try forge::epoch catch "error"]
["yesterday"]
["error"]

# A label is a name and a color, #rrggbb in lower case: a name alone, as GitLab gives one without its details, has a
# null color, as has one whose color is empty; GitHub's, without a #, gains one.
import "forge" as forge; forge::labels
["bug", {"name": "priority=high", "color": "B60205", "description": "x"}, {"name": "area::tui", "color": "#6699CC"}, {"name": "plain", "color": ""}]
[{"name":"bug","color":null},{"name":"priority=high","color":"#b60205"},{"name":"area::tui","color":"#6699cc"},{"name":"plain","color":null}]

# No labels, or none given, are none.
import "forge" as forge; [.[] | forge::labels]
[[], null]
[[],[]]

# A change's labels without a color, and those of the issues it closes, take the one a project's labels give their
# name, in lower case after a #; one that has a color keeps it, and a name the project does not give stays without one.
import "forge" as forge; forge::colored({"bug": "#D73A4A", "kind=fix": "0e8a16"}) | [.labels, .closes[].labels]
{"labels": [{"name": "bug", "color": null}, {"name": "other", "color": null}], "closes": [{"labels": [{"name": "kind=fix", "color": null}, {"name": "bug", "color": "#000000"}]}]}
[[{"name":"bug","color":"#d73a4a"},{"name":"other","color":null}],[{"name":"kind=fix","color":"#0e8a16"},{"name":"bug","color":"#000000"}]]

# A GitLab merge request names its labels, and those of the issues it closes, by name alone.
import "forge" as forge; forge::gitlab_pr(1000000; []; []; [{"iid": 7, "title": "Seven", "created_at": "1970-01-12T13:40:00Z", "labels": ["bug"]}]; null; {}) | [.labels, .closes[].labels]
{"iid": 3, "source_branch": "7-fix", "title": "Fix it", "author": {"username": "ada"}, "created_at": "1970-01-12T13:30:00Z", "draft": true, "labels": ["kind=fix", "area::tui"]}
[[{"name":"kind=fix","color":null},{"name":"area::tui","color":null}],[{"name":"bug","color":null}]]

# A GitHub pull request's labels, and those of each issue it closes, are the answer's under each.
import "forge" as forge; forge::github_prs(1000000) | [.labels, .closes[].labels]
{"data": {"repository": {"nameWithOwner": "empowerite/example", "pullRequests": {"nodes": [{"number": 3, "title": "Fix", "isDraft": true, "headRefName": "7-fix", "createdAt": "1970-01-12T13:30:00Z", "author": {"login": "ada"}, "labels": {"nodes": [{"name": "kind:fix", "color": "0E8A16"}]}, "closingIssuesReferences": {"nodes": [{"number": 7, "title": "Seven", "createdAt": "1970-01-12T13:30:00Z", "repository": {"nameWithOwner": "empowerite/example"}, "labels": {"nodes": [{"name": "bug", "color": "D73A4A"}]}}, {"number": 8, "title": "Eight", "createdAt": "1970-01-12T13:30:00Z", "repository": {"nameWithOwner": "empowerite/example"}}]}, "commits": {"nodes": [{"commit": {"statusCheckRollup": null}}]}}]}}}}
[[{"name":"kind:fix","color":"#0e8a16"}],[{"name":"bug","color":"#d73a4a"}],[]]

# Of two runs of one name, the later counts, so a rerun that passed supersedes the run that failed.
import "forge" as forge; forge::checks(1000000)
[{"name": "test", "verdict": "failed", "at": "a", "since": 1, "took": 5}, {"name": "test", "verdict": "passed", "at": "b", "since": 2, "took": 50}, {"name": "lint", "verdict": "passed", "at": "a", "since": 1, "took": 9}]
{"state":"SUCCESS","passed":2,"total":2,"failing":"","took":50}

# A failed check makes the state FAILURE, and failing names the first, by name.
import "forge" as forge; forge::checks(1000000)
[{"name": "zeta", "verdict": "failed", "at": "", "since": null, "took": 3}, {"name": "beta", "verdict": "failed", "at": "", "since": null, "took": 4}]
{"state":"FAILURE","passed":0,"total":2,"failing":"beta","took":4}

# While a check is pending, took is the wait since the earliest pending run started.
import "forge" as forge; forge::checks(1000000)
[{"name": "a", "verdict": "pending", "at": "", "since": 999900, "took": null}, {"name": "b", "verdict": "pending", "at": "", "since": 999990, "took": null}]
{"state":"PENDING","passed":0,"total":2,"failing":"","took":100}

# With no runs, the state is NONE and took is null.
import "forge" as forge; forge::checks(1000000)
[]
{"state":"NONE","passed":0,"total":0,"failing":"","took":null}

# The first state that holds wins: a draft is a draft, whatever its checks.
import "forge" as forge; map(forge::state)
[{"draft": true, "checks": {"state": "FAILURE"}}, {"draft": false, "checks": {"state": "PENDING"}, "conflicted": true}, {"draft": false, "checks": {"state": "SUCCESS"}, "conflicted": true}, {"draft": false, "checks": {"state": "SUCCESS"}, "conflicted": false, "unresolved": 1, "approval": true}, {"draft": false, "checks": {"state": "SUCCESS"}, "conflicted": false, "unresolved": 0, "approval": true}, {"draft": false, "checks": {"state": "SUCCESS"}, "conflicted": false, "unresolved": 0, "approval": false}]
["draft","queued","conflicted","comments:open","blocked:approval","ready"]

# A GitHub check run is pending until it completes, and a status context's EXPECTED is pending too.
import "forge" as forge; forge::github_runs | map([.name, .verdict, .took])
[{"__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "SUCCESS", "startedAt": "1970-01-12T13:45:00Z", "completedAt": "1970-01-12T13:46:40Z"}, {"__typename": "CheckRun", "name": "lint", "status": "IN_PROGRESS", "conclusion": null, "startedAt": "1970-01-12T13:45:00Z", "completedAt": null}, {"__typename": "StatusContext", "context": "ci/legacy", "state": "EXPECTED", "createdAt": "1970-01-12T13:45:00Z"}, {"__typename": "CheckRun", "name": "skipped", "status": "COMPLETED", "conclusion": "SKIPPED", "startedAt": null, "completedAt": null}, {"__typename": "StatusContext", "context": "ci/other", "state": "ERROR", "createdAt": "1970-01-12T13:45:00Z"}]
[["test","passed",100],["lint","pending",null],["ci/legacy","pending",null],["skipped","passed",null],["ci/other","failed",null]]

# A GitLab job that is manual or skipped has passed, and one that is running is pending.
import "forge" as forge; forge::gitlab_runs | map([.name, .verdict, .took])
[{"name": "test", "status": "success", "started_at": "1970-01-12T13:45:00.5Z", "finished_at": "1970-01-12T13:46:40.5Z"}, {"name": "deploy", "status": "manual", "started_at": null, "finished_at": null, "created_at": "1970-01-12T13:45:00Z"}, {"name": "lint", "status": "running", "started_at": "1970-01-12T13:45:00Z", "finished_at": null}, {"name": "build", "status": "failed", "started_at": null, "finished_at": null}]
[["test","passed",100],["deploy","passed",null],["lint","pending",null],["build","failed",null]]

# A merge request folds into the document, with its ref written !<iid>; with no pipeline, its last push is unknown.
import "forge" as forge; forge::gitlab_pr(1000000; [{"name": "test", "status": "success", "started_at": "1970-01-12T13:45:00Z", "finished_at": "1970-01-12T13:46:40Z"}]; [{"notes": [{"resolvable": true, "resolved": false}, {"resolvable": false}]}]; [{"iid": 7, "title": "Fix the thing", "created_at": "1970-01-12T13:40:00Z", "assignees": [{"username": "bob"}], "references": {"full": "empowerite/tools/example#7"}}]; null; {"approved_by": null})
{"iid": 3, "source_branch": "7-fix-the-thing", "title": "Fix it", "author": {"username": "ada"}, "created_at": "1970-01-12T13:30:00Z", "draft": false, "has_conflicts": false, "detailed_merge_status": "mergeable"}
{"number":3,"ref":"!3","branch":"7-fix-the-thing","fork":null,"title":"Fix it","author":"ada","createdAt":"1970-01-12T13:30:00Z","age":1000,"pushed":null,"state":"comments:open","checks":{"state":"SUCCESS","passed":1,"total":1,"failing":"","took":100},"unresolved":1,"labels":[],"closes":[{"number":7,"title":"Fix the thing","assignees":["bob"],"labels":[],"source":"gitlab","organization":"empowerite/tools","repository":"example","age":400}],"reviewers":[],"runs":[{"name":"test","verdict":"passed","at":999900,"took":100}]}

# A merge request from a fork names the fork's owner, and its head pipeline gives the last push: its age, and who
# started it; a pipeline that names no one gives a null by.
import "forge" as forge; [forge::gitlab_pr(1000000; []; []; []; "cy"; {}), (.head_pipeline.user = null | forge::gitlab_pr(1000000; []; []; []; null; {}))] | map({fork, pushed})
{"iid": 3, "source_branch": "7-fix", "title": "Fix it", "author": {"username": "ada"}, "created_at": "1970-01-12T13:30:00Z", "draft": true, "head_pipeline": {"id": 11, "created_at": "1970-01-12T13:45:00.000Z", "user": {"username": "dee"}}}
[{"fork":"cy","pushed":{"age":100,"by":"dee"}},{"fork":null,"pushed":{"age":100,"by":null}}]

# A pull request from another repository names its owner's login, and its head commit gives the last push: its age,
# and the login of its author. A branch in the base repository is no fork, and a commit without a time is unknown.
import "forge" as forge; [forge::github_prs(1000000) | {fork, pushed}]
{"data": {"repository": {"pullRequests": {"nodes": [{"number": 3, "title": "Fix", "isDraft": true, "headRefName": "7-fix", "createdAt": "1970-01-12T13:30:00Z", "isCrossRepository": true, "headRepositoryOwner": {"login": "cy"}, "author": {"login": "ada"}, "closingIssuesReferences": {"nodes": []}, "commits": {"nodes": [{"commit": {"committedDate": "1970-01-12T13:45:00Z", "author": {"user": {"login": "dee"}}, "statusCheckRollup": null}}]}}, {"number": 4, "title": "Also", "isDraft": true, "headRefName": "8-also", "createdAt": "1970-01-12T13:30:00Z", "isCrossRepository": false, "headRepositoryOwner": {"login": "empowerite"}, "author": {"login": "ada"}, "closingIssuesReferences": {"nodes": []}, "commits": {"nodes": [{"commit": {"committedDate": "1970-01-12T13:46:00Z", "author": {"user": null}, "statusCheckRollup": null}}]}}, {"number": 5, "title": "Old", "isDraft": true, "headRefName": "9-old", "createdAt": "1970-01-12T13:30:00Z", "author": {"login": "ada"}, "closingIssuesReferences": {"nodes": []}, "commits": {"nodes": [{"commit": {"statusCheckRollup": null}}]}}]}}}}
[{"fork":"cy","pushed":{"age":100,"by":"dee"}},{"fork":null,"pushed":{"age":40,"by":null}},{"fork":null,"pushed":null}]

# A closed issue's assignees come from the answer's open issues with an assignee, not from the issue itself: one they
# do not name has none, as has an issue of another repository with the same number. Each says the organization and the
# repository it is in.
import "forge" as forge; forge::github_prs(1000000) | .closes[] | [.number, .assignees, .organization, .repository]
{"data": {"repository": {"nameWithOwner": "empowerite/example", "issues": {"nodes": [{"number": 7, "assignees": {"nodes": [{"login": "bob"}, {"login": "cy"}]}}]}, "pullRequests": {"nodes": [{"number": 3, "title": "Fix", "isDraft": true, "headRefName": "7-fix", "createdAt": "1970-01-12T13:30:00Z", "author": {"login": "ada"}, "closingIssuesReferences": {"nodes": [{"number": 7, "title": "Seven", "createdAt": "1970-01-12T13:30:00Z", "repository": {"nameWithOwner": "empowerite/example"}}, {"number": 8, "title": "Eight, closed or unassigned", "createdAt": "1970-01-12T13:30:00Z", "repository": {"nameWithOwner": "empowerite/example"}}, {"number": 7, "title": "Seven elsewhere", "createdAt": "1970-01-12T13:30:00Z", "repository": {"nameWithOwner": "other/place"}}]}, "commits": {"nodes": [{"commit": {"statusCheckRollup": null}}]}}]}}}}
[7,["bob","cy"],"empowerite","example"]
[8,[],"empowerite","example"]
[7,[],"other","place"]

# A row says where it is from: the organization, repository, and source it has, even null, as an issue's own, else
# those of here; anything but an object is as it was.
import "forge" as forge; map(forge::from({organization: "o", repository: "r", source: "github"}))
[{"n": 1}, {"n": 2, "organization": "x", "repository": null}, "text"]
[{"n":1,"organization":"o","repository":"r","source":"github"},{"n":2,"organization":"x","repository":null,"source":"github"},"text"]

# A rate limit that is spent gives the wait until it resets, in local time, which the suite runs in UTC, and in
# minutes rounded up, the later of the two when both are; with neither spent, or no answer, nothing.
import "forge" as forge; [.[] | [forge::github_spent(1000000)]]
[{"resources": {"core": {"remaining": 10, "reset": 1003600}, "graphql": {"remaining": 0, "reset": 1000690}}}, {"resources": {"core": {"remaining": 0, "reset": 1001200}, "graphql": {"remaining": 0, "reset": 1000060}}}, {"resources": {"core": {"remaining": 0, "reset": 1000010}}}, {"resources": {"core": {"remaining": 1, "reset": 1000010}}}, {}]
[["wait until 13:58, in 12m, when GitHub's GraphQL rate limit resets"],["wait until 14:06, in 20m, when GitHub's REST rate limit resets"],["wait until 13:46, in 1m, when GitHub's REST rate limit resets"],[],[]]

# GitHub's rate limits are GraphQL's, first, and REST's, as rest; the others kit does not spend are left out.
import "forge" as forge; forge::github_quota
{"resources": {"core": {"limit": 5000, "remaining": 4990, "used": 10, "reset": 1000600}, "search": {"limit": 30, "remaining": 30, "reset": 1000060}, "graphql": {"limit": 5000, "remaining": 0, "used": 5000, "reset": 1000300}}}
{"forge":"github","limits":[{"name":"graphql","limit":5000,"remaining":0,"reset":1000300},{"name":"rest","limit":5000,"remaining":4990,"reset":1000600}]}

# GitLab's is the one its RateLimit headers name, whatever their case; without them, or with a limit that is no number,
# none.
import "forge" as forge; [.[] | forge::gitlab_quota]
["HTTP/2.0 200 OK\r\nRatelimit-Limit: 2000\r\nRATELIMIT-NAME: throttle_authenticated_api\r\nratelimit-remaining: 7\r\nRatelimit-Reset: 1000060\r\n\r\n{}", "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{}", "HTTP/1.1 200 OK\nRatelimit-Limit: 600\nRatelimit-Remaining: 599\n\n{}", "HTTP/1.1 200 OK\nRatelimit-Limit: lots\nRatelimit-Remaining: 9\n\n{}"]
[{"forge":"gitlab","limits":[{"name":"throttle_authenticated_api","limit":2000,"remaining":7,"reset":1000060}]},{"forge":"gitlab","limits":[]},{"forge":"gitlab","limits":[{"name":"api","limit":600,"remaining":599,"reset":null}]},{"forge":"gitlab","limits":[]}]

# GitLab's marks, a kind each, are what its newest items say of when they changed: the issue and the merge request
# updated last together, the pipelines' ids, states, and updates, the release's tag and time, the milestone's number
# and update with the newest issue's, as closing an issue moves no milestone's, the deployment updated last, and the
# environments; none says an empty list.
import "forge" as forge; . as $lists | ["issues", "runs", "releases", "milestones", "deployments", "environments"] | map({key: ., value: (. as $kind | $lists | forge::gitlab_mark($kind))}) | from_entries
{"issues": [{"iid": 7, "updated_at": "a", "title": "x"}], "mrs": [{"iid": 3, "updated_at": "b"}], "runs": [{"id": 11, "status": "running", "updated_at": "c"}], "releases": [], "milestones": [{"iid": 2, "updated_at": "d"}], "deployments": [{"id": 9, "status": "success", "updated_at": "e"}], "environments": [{"id": 1, "name": "prod", "state": "available", "updated_at": "f"}]}
{"issues":"[[7,\"a\"],[3,\"b\"]]","runs":"[[11,\"running\",\"c\"]]","releases":"[]","milestones":"[[2,\"d\"],[7,\"a\"]]","deployments":"[[9,\"success\",\"e\"]]","environments":"[[1,\"prod\",\"available\",\"f\"]]"}

# GitHub's open issues fold into one document each, oldest first, with the assignees by login, the labels by name and
# color, the age in seconds, and the organization and the repository their url names, or null without one.
import "forge" as forge; forge::github_issues(1000000)
[{"number": 9, "title": "Other thing", "assignees": [], "createdAt": "1970-01-12T13:46:30Z"}, {"number": 7, "title": "Fix the thing", "assignees": [{"login": "bob"}], "labels": [{"id": "LA_1", "name": "priority=high", "description": "", "color": "B60205"}], "createdAt": "1970-01-12T13:46:20Z", "url": "https://github.com/empowerite/kit/issues/7"}]
{"number":7,"ref":"#7","title":"Fix the thing","assignees":["bob"],"labels":[{"name":"priority=high","color":"#b60205"}],"createdAt":"1970-01-12T13:46:20Z","milestone":null,"iteration":null,"age":20,"source":"github","organization":"empowerite","repository":"kit"}
{"number":9,"ref":"#9","title":"Other thing","assignees":[],"labels":[],"createdAt":"1970-01-12T13:46:30Z","milestone":null,"iteration":null,"age":10,"source":"github","organization":null,"repository":null}

# GitLab's fold the same, from iid, username, the labels' details, and a created_at with fractional seconds; the
# organization is the group, subgroups and all, its full reference names.
import "forge" as forge; forge::gitlab_issues(1000000)
[{"iid": 7, "title": "Fix the thing", "assignees": [{"username": "bob"}], "labels": [{"id": 4, "name": "area::tui", "color": "#6699CC", "text_color": "#FFFFFF"}], "created_at": "1970-01-12T13:46:20.000Z", "references": {"full": "empowerite/tools/kit#7"}}, {"iid": 9, "title": "Other thing", "assignees": [], "created_at": "1970-01-12T13:46:30.500Z"}]
{"number":7,"ref":"#7","title":"Fix the thing","assignees":["bob"],"labels":[{"name":"area::tui","color":"#6699cc"}],"createdAt":"1970-01-12T13:46:20.000Z","milestone":null,"iteration":null,"age":20,"source":"gitlab","organization":"empowerite/tools","repository":"kit"}
{"number":9,"ref":"#9","title":"Other thing","assignees":[],"labels":[],"createdAt":"1970-01-12T13:46:30.500Z","milestone":null,"iteration":null,"age":10,"source":"gitlab","organization":null,"repository":null}

# An issue says its milestone and its iteration by title: GitHub's milestone from gh issue list, and its iteration the
# one forge/github:open-issues puts beside it; GitLab's from its own fields, an iteration with no title by its dates.
import "forge" as forge; [forge::github_issues(1000000) | {number, milestone, iteration}]
[{"number": 7, "title": "a", "assignees": [], "createdAt": "1970-01-12T13:46:20Z", "milestone": {"number": 2, "title": "v0.1"}, "iteration": "Sprint 2"}, {"number": 9, "title": "b", "assignees": [], "createdAt": "1970-01-12T13:46:30Z", "milestone": null}]
[{"number":7,"milestone":"v0.1","iteration":"Sprint 2"},{"number":9,"milestone":null,"iteration":null}]

import "forge" as forge; [forge::gitlab_issues(1000000) | {number, milestone, iteration}]
[{"iid": 7, "title": "a", "assignees": [], "created_at": "1970-01-12T13:46:20Z", "milestone": {"title": "v0.1"}, "iteration": {"title": "Sprint 2"}}, {"iid": 8, "title": "b", "assignees": [], "created_at": "1970-01-12T13:46:25Z", "milestone": null, "iteration": {"title": null, "start_date": "2026-11-02", "due_date": "2026-11-15"}}, {"iid": 9, "title": "c", "assignees": [], "created_at": "1970-01-12T13:46:30Z"}]
[{"number":7,"milestone":"v0.1","iteration":"Sprint 2"},{"number":8,"milestone":null,"iteration":"2026-11-02 to 2026-11-15"},{"number":9,"milestone":null,"iteration":null}]

# GitHub's pages of the open issues' project items give each issue in an iteration the first iteration's title, by
# its number; a value of another kind of field is no iteration, and an issue in none is left out.
import "forge" as forge; forge::github_issue_iterations
[{"data": {"repository": {"issues": {"nodes": [{"number": 7, "projectItems": {"nodes": [{"fieldValues": {"nodes": [{}, {"title": "Sprint 2"}]}}, {"fieldValues": {"nodes": [{"title": "Sprint 9"}]}}]}}, {"number": 8, "projectItems": {"nodes": [{"fieldValues": {"nodes": [{}]}}]}}]}}}}, {"data": {"repository": {"issues": {"nodes": [{"number": 9, "projectItems": {"nodes": []}}, {"number": 10, "projectItems": {"nodes": [{"fieldValues": {"nodes": [{"title": "Sprint 1"}]}}]}}]}}}}]
{"7":"Sprint 2","10":"Sprint 1"}

# An Azure Boards work item's iteration is the last name of its iteration path; the project's root alone is none, and
# it has no milestone.
import "forge" as forge; [forge::ado_issues(1000000; "p/r") | {number, milestone, iteration}]
[{"id": 7, "fields": {"System.Title": "a", "System.CreatedDate": "1970-01-12T13:46:20Z", "System.IterationPath": "Claims\\Release 1\\Sprint 4"}}, {"id": 8, "fields": {"System.Title": "b", "System.CreatedDate": "1970-01-12T13:46:30Z", "System.IterationPath": "Claims"}}]
[{"number":7,"milestone":null,"iteration":"Sprint 4"},{"number":8,"milestone":null,"iteration":null}]

# An issue's milestone, iteration, and swimlane are the stand-in's where the repository chose one: the rest of its
# first label with the prefix, past one that holds the prefix alone, else the default; null where the forge lacks the
# feature; else the forge's own, or null.
import "forge" as forge; [.[] | forge::issue_fields({swimlanes: {label_prefix: "swimlane:", default: "none"}, milestones: {default: "later"}}; ["iterations"]) | {milestone, iteration, swimlane}]
[{"labels": [{"name": "bug"}, {"name": "swimlane:"}, {"name": "swimlane:ops"}, {"name": "swimlane:dev"}], "milestone": "v1", "iteration": "Sprint 1"}, {"labels": []}]
[{"milestone":"later","iteration":null,"swimlane":"ops"},{"milestone":"later","iteration":null,"swimlane":"none"}]

import "forge" as forge; [.[] | forge::issue_fields({iterations: {label_prefix: "sprint/"}}; []) | {milestone, iteration, swimlane}]
[{"labels": [{"name": "sprint/12"}], "milestone": "v1", "iteration": "Sprint 1"}, {"labels": [], "iteration": "Sprint 1"}]
[{"milestone":"v1","iteration":"12","swimlane":null},{"milestone":null,"iteration":null,"swimlane":null}]

# A draft has no publishing time and is dated by when it was made; releases come newest first.
import "forge" as forge; [forge::github_releases(1800000000) | "\(.version) \(.kind) \(.at) \(.latest)"]
[[{"tag_name": "release/0.0.9", "name": "a", "prerelease": false, "draft": false, "published_at": "2026-10-20T07:30:14Z", "created_at": "2026-10-20T07:30:14Z"}, {"tag_name": "release/0.1.0-rc.7", "name": "b", "prerelease": true, "draft": true, "published_at": null, "created_at": "2026-10-30T07:30:14Z"}]]
["0.1.0-rc.7 draft 2026-10-30T07:30:14Z false","0.0.9 release 2026-10-20T07:30:14Z true"]

# The pages join, and the latest is the newest release by when it was made, neither a draft nor a pre-release, as
# GitHub names it: not the one published last, nor a newer pre-release.
import "forge" as forge; [forge::github_releases(1800000000) | "\(.version) \(.kind) \(.latest)"]
[[{"tag_name": "release/0.1.0", "name": "c", "prerelease": false, "draft": false, "published_at": "2026-10-27T07:30:14Z", "created_at": "2026-10-27T07:30:14Z"}, {"tag_name": "release/0.2.0-rc.1", "name": "d", "prerelease": true, "draft": false, "published_at": "2026-10-29T07:30:14Z", "created_at": "2026-10-29T07:30:14Z"}], [{"tag_name": "release/0.0.9", "name": "a", "prerelease": false, "draft": false, "published_at": "2026-10-28T07:30:14Z", "created_at": "2026-10-20T07:30:14Z"}]]
["0.2.0-rc.1 pre-release false","0.0.9 release false","0.1.0 release true"]

# GitLab: the branch for an issue starts with its number and a dash, and a merge request's state is said as GitHub says it.
import "forge" as forge; [forge::gitlab_branch_for_issue(7)]
[{"source_branch": "70-other"}, {"source_branch": "7-start"}]
["7-start"]

import "forge" as forge; [.[] | [.] | forge::gitlab_pr_state]
[{"state": "merged"}, {"state": "locked"}, {"state": "opened"}]
["MERGED","CLOSED","OPEN"]

# A pull request's review threads or checks with a next page are named, with the cursor and the head commit; a list
# held whole is not.
import "forge" as forge; [forge::github_partial]
{"data": {"repository": {"pullRequests": {"nodes": [{"number": 3, "reviewThreads": {"pageInfo": {"hasNextPage": true, "endCursor": "t1"}, "nodes": [{}]}, "commits": {"nodes": [{"commit": {"oid": "abc", "statusCheckRollup": null}}]}}, {"number": 4, "reviewThreads": {"pageInfo": {"hasNextPage": false}, "nodes": []}, "commits": {"nodes": [{"commit": {"oid": "def", "statusCheckRollup": {"contexts": {"pageInfo": {"hasNextPage": true, "endCursor": "c1"}, "nodes": [{}]}}}}]}}, {"number": 5, "reviewThreads": {"nodes": []}, "commits": {"nodes": []}}]}}}}
["3\tthreads\tt1\tabc","4\tchecks\tc1\tdef"]

# A merge request's head pipeline is one job, pipeline, of its own status, where its jobs cannot be read.
import "forge" as forge; forge::gitlab_pipeline_jobs | map({name, status})
{"head_pipeline": {"id": 11, "project_id": 99, "status": "failed"}}
[{"name":"pipeline","status":"failed"}]

# GitHub's milestone pages, each an array, fold into one document each, by number, the due date, a time at midnight, in
# seconds since the epoch, or null for none.
import "forge" as forge; forge::github_milestones
[[{"number": 2, "title": "v0.1", "state": "open", "due_on": "2026-12-01T00:00:00Z", "open_issues": 3, "closed_issues": 2, "html_url": "u2"}], [{"number": 1, "title": "v0.0.9", "state": "closed", "due_on": null, "open_issues": 0, "closed_issues": 7, "html_url": "u1"}]]
{"number":1,"title":"v0.0.9","state":"closed","due":null,"open":0,"closed":7,"url":"u1"}
{"number":2,"title":"v0.1","state":"open","due":1796083200,"open":3,"closed":2,"url":"u2"}

# GitLab's, from GraphQL, by iid, a string there: its dueDate a day, its active state open, those open the total less
# those closed, and its page the host and its webPath.
import "forge" as forge; forge::gitlab_milestones("https://gitlab.com")
[{"iid": "2", "title": "v0.1", "state": "active", "dueDate": "2026-12-01", "webPath": "/o/r/-/milestones/2", "stats": {"totalIssuesCount": 5, "closedIssuesCount": 2}}, {"iid": "1", "title": "v0.0.9", "state": "closed", "dueDate": null, "webPath": "/o/r/-/milestones/1", "stats": {"totalIssuesCount": 0, "closedIssuesCount": 0}}]
{"number":1,"title":"v0.0.9","state":"closed","due":null,"open":0,"closed":0,"url":"https://gitlab.com/o/r/-/milestones/1"}
{"number":2,"title":"v0.1","state":"open","due":1796083200,"open":3,"closed":2,"url":"https://gitlab.com/o/r/-/milestones/2"}

# GitLab's sort by number, not by the text of the iid; a milestone with no stats, or null counts, has no issues.
import "forge" as forge; forge::gitlab_milestones("h") | [.number, .open, .closed]
[{"iid": "10", "title": "c", "state": "active", "webPath": "/10", "stats": null}, {"iid": "2", "title": "a", "state": "active", "webPath": "/2", "stats": {"totalIssuesCount": null, "closedIssuesCount": null}}, {"iid": "9", "title": "b", "state": "closed", "webPath": "/9", "stats": {"totalIssuesCount": 4, "closedIssuesCount": 1}}]
[2,0,0]
[9,3,1]
[10,0,0]

# GitHub's iterations are those of each iteration field of each project, the running and the completed, by start, each
# lasting its duration in days to the last second before the next day; a field that is no iteration field, and a project
# with none, add none.
import "forge" as forge; forge::github_iterations
{"data": {"repository": {"projectsV2": {"nodes": [{"url": "p", "fields": {"nodes": [{}, {"configuration": {"iterations": [{"id": "b", "title": "Sprint 2", "startDate": "2026-11-16", "duration": 14}], "completedIterations": [{"id": "a", "title": "Sprint 1", "startDate": "2026-11-02", "duration": 14}]}}]}}, {"url": "q", "fields": {"nodes": []}}]}}}}
{"id":"a","title":"Sprint 1","start":1793577600,"end":1794787199,"url":"p"}
{"id":"b","title":"Sprint 2","start":1794787200,"end":1795996799,"url":"p"}

# GitHub with no project linked has none.
import "forge" as forge; [forge::github_iterations]
{"data": {"repository": {"projectsV2": {"nodes": []}}}}
[]

# GitLab's last day is the iteration's due_date, so it ends with that day; a cadence's iteration with no title is named
# by its dates.
import "forge" as forge; forge::gitlab_iterations
[{"id": 32, "title": null, "start_date": "2026-11-16", "due_date": "2026-11-29", "web_url": "u"}, {"id": 31, "title": "Sprint 1", "start_date": "2026-11-02", "due_date": "2026-11-15", "web_url": "u"}]
{"id":31,"title":"Sprint 1","start":1793577600,"end":1794787199,"url":"u"}
{"id":32,"title":"2026-11-16 to 2026-11-29","start":1794787200,"end":1795996799,"url":"u"}

# Azure DevOps' team iterations are by start, one with no dates, as the project's root has, first with none.
import "forge" as forge; forge::ado_iterations("u")
[{"id": "a1", "name": "Sprint 1", "attributes": {"startDate": "2026-11-02T00:00:00Z", "finishDate": "2026-11-15T00:00:00Z"}}, {"id": "a0", "name": "Backlog", "attributes": null}]
{"id":"a0","title":"Backlog","start":null,"end":null,"url":"u"}
{"id":"a1","title":"Sprint 1","start":1793577600,"end":1794787199,"url":"u"}

# A change's reviewers are each named once, as the first that names them says, by login: one asked again is asked,
# whatever they said before. The author's own comments are no review, and a reviewer the forge names no login for, as
# a deleted account, is none. A time comes out in seconds since the epoch.
import "forge" as forge; forge::reviewers("ada")
[{"login": "dee", "state": "requested", "at": null}, {"login": "ada", "state": "commented", "at": "1970-01-12T13:40:00Z"}, {"login": null, "state": "approved", "at": null}, {"login": "dee", "state": "approved", "at": "1970-01-12T13:40:00Z"}, {"login": "bob", "state": "changes", "at": "1970-01-12T13:41:40.5Z"}]
[{"login":"bob","state":"changes","at":999700},{"login":"dee","state":"requested","at":null}]

# GitHub asks a person or a team, and a reviewer's latest review approves, asks for changes, or comments; a dismissed
# review stands as a comment, and a pending one, which only its author sees, is none.
import "forge" as forge; forge::github_prs(1000000) | .reviewers
{"data": {"repository": {"pullRequests": {"nodes": [{"number": 3, "title": "Fix", "isDraft": false, "headRefName": "7-fix", "createdAt": "1970-01-12T13:30:00Z", "author": {"login": "ada"}, "closingIssuesReferences": {"nodes": []}, "commits": {"nodes": [{"commit": {"statusCheckRollup": null}}]}, "reviewRequests": {"nodes": [{"requestedReviewer": {"slug": "core"}}, {"requestedReviewer": null}]}, "latestReviews": {"nodes": [{"author": {"login": "bob"}, "state": "CHANGES_REQUESTED", "submittedAt": "1970-01-12T13:40:00Z"}, {"author": {"login": "cy"}, "state": "DISMISSED", "submittedAt": "1970-01-12T13:40:00Z"}, {"author": {"login": "dee"}, "state": "PENDING", "submittedAt": null}, {"author": null, "state": "APPROVED", "submittedAt": "1970-01-12T13:40:00Z"}]}}]}}}}
[{"login":"bob","state":"changes","at":999600},{"login":"core","state":"requested","at":null},{"login":"cy","state":"commented","at":999600}]

# A GitLab merge request's approvers have approved, at the time each did, and a reviewer without an approval is asked.
import "forge" as forge; forge::gitlab_pr(1000000; []; []; []; null; {"approved_by": [{"user": {"username": "carol"}, "approved_at": "1970-01-12T13:40:00.000Z"}, {"user": null}]}) | .reviewers
{"iid": 3, "source_branch": "7-fix", "title": "Fix it", "author": {"username": "ada"}, "created_at": "1970-01-12T13:30:00Z", "draft": false, "reviewers": [{"username": "bob"}, {"username": "carol"}]}
[{"login":"bob","state":"requested","at":null},{"login":"carol","state":"approved","at":999600}]

# Azure DevOps' votes of 10 and 5 approve, -5 and -10 ask for changes, and 0 is a reviewer asked; one who declined is
# none, and a team is named by its display name. A vote has no time.
import "forge" as forge; [.[] | {vote, isContainer, hasDeclined, uniqueName, displayName}] | {reviewers: .} | forge::ado_reviewers
[{"uniqueName": "a", "vote": 10}, {"uniqueName": "b", "vote": 5}, {"uniqueName": "c", "vote": -5}, {"uniqueName": "d", "vote": -10}, {"uniqueName": "e", "vote": 0}, {"uniqueName": "f", "vote": 0, "hasDeclined": true}, {"uniqueName": "vstfs:///x", "displayName": "Core Team", "isContainer": true, "vote": 0}]
[{"login":"a","state":"approved","at":null},{"login":"b","state":"approved","at":null},{"login":"c","state":"changes","at":null},{"login":"d","state":"changes","at":null},{"login":"e","state":"requested","at":null},{"login":"Core Team","state":"requested","at":null}]

