# An Azure DevOps team with no members read has none, and a member with no identity is no one; an administrator of
# one team is an admin, a member of another.
import "forge" as forge; [forge::ado_teams({b: [{"identity": {"uniqueName": "ada"}}]}; "u"; 20)], [forge::ado_collaborators({a: [{"isTeamAdmin": true, "identity": {"uniqueName": "ada", "displayName": "Ada"}}, {"identity": null}], b: [{"identity": {"uniqueName": "ada"}}, {"identity": {"id": "g", "isContainer": true}}]}; 20)]
[{"id": "a", "name": "A"}, {"id": "b", "name": "B"}]
[{"team":"A","name":"A","role":null,"members":[],"url":"u/_settings/teams"},{"team":"B","name":"B","role":null,"members":["ada"],"url":"u/_settings/teams"}]
[{"login":"ada","name":"Ada","role":"admin","kind":"user"},{"login":"g","name":null,"role":"member","kind":"group"}]

# A GitHub alert with no rule, severity, location, or dismisser shown has none of them; code scanning's state is its
# own, and a secret resolved is dismissed, its resolution the reason; an alert on two pages is drawn once, as the
# last page gives it, the newest number first.
import "forge" as forge; [forge::github_code_scanning(100)], [forge::github_secret_scanning(100)]
[[{"number": 3, "state": "open", "created_at": null, "html_url": "u", "rule": null, "most_recent_instance": null}], [{"number": 4, "state": "resolved", "html_url": "v", "resolution": "revoked"}, {"number": 3, "state": "dismissed", "html_url": "u", "dismissed_by": null, "dismissed_reason": "won't fix", "dismissed_comment": ""}]]
