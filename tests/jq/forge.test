# A pattern names a branch as fnmatch does: * within a path segment, ** across them, and a character that is a
# regular expression's own is itself.
import "forge" as forge; [("refs/heads/ma*", "refs/heads/**", "refs/heads/*", "refs/heads/m.in") | forge::fnmatch("refs/heads/main")], ("refs/heads/*" | forge::fnmatch("refs/heads/a/b"))
