[{"accessLevel": null, "user": {"username": "a", "bot": false}}, {"accessLevel": {"integerValue": 35}, "user": {"username": "b", "name": "B", "bot": true, "lastActivityOn": null, "webUrl": null}}, {"accessLevel": {"integerValue": 10}, "user": null}]
[{"login":"a","name":null,"role":null,"kind":"user"},{"login":"b","name":"B","role":"35","kind":"bot"}]
[{"login":"b","acted":null,"last":null,"url":null}]

