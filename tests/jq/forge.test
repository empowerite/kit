# A GitHub collaborator with no name shown, or no role, has them null, and a bot account is a bot; a team's permission
# is the role a collaborator's would name, a custom role its own name.
import "forge" as forge; [forge::github_collaborators], [("pull", "push", "maintain", "custom", null) | forge::github_role]
[[{"login": "ada", "type": "User"}, null, {"login": "app[bot]", "type": "Bot", "name": "App", "role_name": "write"}]]
[{"login":"ada","name":null,"role":null,"kind":"user"},{"login":"app[bot]","name":"App","role":"write","kind":"bot"}]
["read","write","maintain","custom",null]

# A GitHub team the caller cannot see has its members null, a team cut past its members says the list stopped at the
# teams drawn, and more teams than read say it stopped at the limit.
import "forge" as forge; [forge::github_teams({t0: {members: {totalCount: 3, nodes: [{"login": "ada"}, null]}}}; 2)], [forge::github_teams({}; 1)]
[{"slug": "a", "name": "A", "permission": "admin"}, {"slug": "b", "name": "B"}]
[{"team":"a","name":"A","role":"admin","members":["ada"],"url":null},{"team":"b","name":"B","role":null,"members":null,"url":null},{"limited":2}]
[{"team":"a","name":"A","role":"admin","members":null,"url":null},{"limited":1}]

# A GitHub bot's acts merge under one login, a Bot's GraphQL login gaining [bot]; a pending review, which has no time,
# still says it reviewed; nodes, authors, and reviews that are null are no one's; a bot GitHub gave no page has none.
import "forge" as forge; [forge::github_bots]
{"data": {"repository": {"url": "https://ghe.example/o/r", "defaultBranchRef": {"target": {"history": {"nodes": [null, {"committedDate": "1970-01-01T00:01:40Z", "author": {"name": "x[bot]", "user": null}}]}}}, "open": {"nodes": [null, {"createdAt": "1970-01-01T00:00:50Z", "author": {"__typename": "Bot", "login": "x"}, "latestReviews": null}]}, "merged": {"nodes": [{"createdAt": "1970-01-01T00:00:10Z", "author": null, "latestReviews": {"nodes": [null, {"submittedAt": null, "author": {"__typename": "Bot", "login": "y", "url": "https://ghe.example/apps/y"}}]}}]}}}}
[{"login":"x[bot]","acted":["commit","change"],"last":100,"url":null},{"login":"y[bot]","acted":["review"],"last":null,"url":"https://ghe.example/apps/y"}]

# A repository with no default branch's commits and no changes has no bots.
import "forge" as forge; [forge::github_bots]
{"data": {"repository": {"defaultBranchRef": null, "open": null, "merged": {"nodes": []}}}}
[]

# A GitLab member with no access level shown has no role, a level GitLab adds later is its number, and a user who is no
# bot, or a bot never seen acting, has none of that.
