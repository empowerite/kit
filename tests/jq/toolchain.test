# toolchain.test - the toolchain jq module, run by jq -L kit/modules/jq --run-tests
#
# Each case is a program, an input, and the outputs it gives, one JSON value per line, then a blank line.

# Only the Brewfile's formulae and casks count, with the latest installed version beside the current one.
import "toolchain" as toolchain; [toolchain::brew_outdated("jq\nfirefox\n")]
{"formulae": [{"name": "jq", "installed_versions": ["1.7", "1.7.1"], "current_version": "1.8.2"}, {"name": "wget", "installed_versions": ["1.0"], "current_version": "1.1"}], "casks": [{"name": "firefox", "installed_versions": ["130"], "current_version": "131"}]}
["jq\t1.7.1\t1.8.2","firefox\t130\t131"]

# A Brewfile with nothing outdated gives nothing.
import "toolchain" as toolchain; [toolchain::brew_outdated("jq\n")]
{"formulae": [{"name": "wget", "installed_versions": ["1.0"], "current_version": "1.1"}], "casks": []}
[]

# mise ls --json --current gives each tool its pin, as mise.toml asks for it, and the version installed, or none.
import "toolchain" as toolchain; [toolchain::mise_pins]
{"jq": [{"version": "1.8.0", "requested_version": "1.8", "installed": true}], "just": [{"version": "1.40.0", "requested_version": "1.40", "installed": false}], "yq": [{"version": "4.45.1", "installed": true}]}
["jq\t1.8\t1.8.0","just\t1.40\t","yq\t4.45.1\t4.45.1"]

# A brew name pins a version only where it carries one after @; brew list --versions gives the newest installed.
import "toolchain" as toolchain; [toolchain::brew_pins("jq\nnode@22\nfirefox\n")]
"jq 1.7 1.7.1\nnode@22 22.11.0\nwget 1.24\n"
["jq\t\t1.7.1","node@22\t22\t22.11.0","firefox\t\t"]

# flake.lock gives each input the flake names, by its short locked revision; an input that follows another is left out.
import "toolchain" as toolchain; [toolchain::nix_pins]
{"root": "root", "nodes": {"root": {"inputs": {"nixpkgs": "nixpkgs", "tool": "tool_2", "follows": ["nixpkgs"]}}, "nixpkgs": {"locked": {"rev": "aaaaaaa1111"}}, "tool_2": {"locked": {"narHash": "sha256-abcdefghij"}}}}
["nixpkgs\taaaaaaa\taaaaaaa","tool\tabcdefg\tabcdefg"]

# Each input with a revision locked is asked at its original reference; one pinned to a revision, or from a path, is not.
import "toolchain" as toolchain; [toolchain::nix_refs]
{"root": "root", "nodes": {"root": {"inputs": {"a": "a", "b": "b", "c": "c", "d": "d", "e": "e"}}, "a": {"locked": {"rev": "r1"}, "original": {"type": "github", "owner": "NixOS", "repo": "nixpkgs", "ref": "nixos-unstable"}}, "b": {"locked": {"rev": "r2"}, "original": {"type": "github", "owner": "o", "repo": "r", "rev": "r2"}}, "c": {"locked": {"narHash": "x"}, "original": {"type": "path", "path": "./c"}}, "d": {"locked": {"rev": "r4"}, "original": {"type": "git", "url": "https://h/d.git", "ref": "main"}}, "e": {"locked": {"rev": "r5"}, "original": {"type": "indirect", "id": "nixpkgs"}}}}
["a\tgithub:NixOS/nixpkgs/nixos-unstable\tr1","d\tgit+https://h/d.git?ref=main\tr4","e\tnixpkgs\tr5"]

# An input that is not a flake is left out; dir, host, and submodules go into the reference as the lock's original has them.
import "toolchain" as toolchain; [toolchain::nix_refs]
{"root": "root", "nodes": {"root": {"inputs": {"a": "a", "b": "b", "c": "c", "d": "d"}}, "a": {"flake": false, "locked": {"rev": "r1"}, "original": {"type": "github", "owner": "o", "repo": "src"}}, "b": {"locked": {"rev": "r2"}, "original": {"type": "github", "owner": "o", "repo": "mono", "dir": "sub", "host": "git.example.com"}}, "c": {"locked": {"rev": "r3"}, "original": {"type": "git", "url": "https://h/c.git", "ref": "main", "dir": "x", "submodules": true}}, "d": {"locked": {"rev": "r4"}, "original": {"type": "tarball", "url": "https://h/d.tgz", "dir": "x"}}}}
["b\tgithub:o/mono?dir=sub&host=git.example.com\tr2","c\tgit+https://h/c.git?ref=main&dir=x&submodules=1\tr3"]

# devcontainer-lock.json gives each locked feature, by id, with its locked version as pinned and installed.
import "toolchain" as toolchain; [toolchain::devcontainer_pins]
{"features": {"ghcr.io/a/jq:1": {"version": "1.2.3", "resolved": "r", "integrity": "i"}, "ghcr.io/a/go:1": {"version": "1.0.0"}}}
["ghcr.io/a/jq:1\t1.2.3\t1.2.3","ghcr.io/a/go:1\t1.0.0\t1.0.0"]

# A lock with no features gives nothing.
import "toolchain" as toolchain; [toolchain::devcontainer_pins]
{}
[]

# devcontainer outdated lists a feature whose current version is behind the latest, and nothing for one up to date.
import "toolchain" as toolchain; [toolchain::devcontainer_outdated]
{"features": {"ghcr.io/a/jq:1": {"current": "1.2.3", "wanted": "1.2.4", "latest": "2.0.0"}, "ghcr.io/a/go:1": {"current": "1.0.0", "wanted": "1.0.0", "latest": "1.0.0"}, "ghcr.io/a/x:1": {"current": null, "wanted": null, "latest": null}}}
["ghcr.io/a/jq:1\t1.2.3\t2.0.0"]

# kit's tools are locked for every platform named, or for their own platforms:, with the url and the bin filled in, the
# url as the coordinate url:<url>.
import "toolchain" as toolchain; [toolchain::kit_wanted("linux-x64 macos-arm64")]
[{"name": "a", "version": "1.20", "url": "u/v{version}/{os}_{arch}/{platform}", "bin": "a-{version}", "profile": "both", "os": {"macos": "darwin"}, "arch": {"x64": "amd64"}, "platforms": []}, {"name": "b", "version": "3", "url": "w/{version}", "bin": ".", "profile": "desk", "os": {}, "arch": {}, "platforms": ["linux-x64"]}]
["a\t1.20\tlinux-x64\tboth\turl:u/v1.20/linux_amd64/linux-x64\ta-1.20","a\t1.20\tmacos-arm64\tboth\turl:u/v1.20/darwin_arm64/macos-arm64\ta-1.20","b\t3\tlinux-x64\tdesk\turl:w/3\t."]
