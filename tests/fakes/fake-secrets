#!/usr/bin/env bash
# fake-secrets - stands in for the macOS keychain's security and the Secret Service's secret-tool (test helper)
# ----------------------------------------------------------------------------------------------------------------------
# Linked as security and secret-tool on PATH. Every call's arguments are appended to ${FAKE_DIR}/<tool>.calls: a secret
# read from stdin is never among them, which is how a test shows the kit kept it out of argv. An item is a file under
# ${FAKE_DIR}/secrets/, named <service>@<account> with each / of the account an underscore, holding the secret as it
# was stored.
#
# security -i reads one command per line, add-generic-password -U -s <svc> -a <acct> -w <secret> or
# delete-generic-password -s <svc> -a <acct>. security find-generic-password -s <svc> -a <acct> -w prints the
# secret, as hex when it holds a newline, as the keychain does. secret-tool store --label=<label> service <svc> account
# <acct> reads the secret from stdin; lookup prints it; clear deletes it. A missing item fails: 44 for security, 1 for
# secret-tool.

set -o errexit -o nounset -o pipefail
tool=${0##*/}
printf '%s\n' "$*" >> "${FAKE_DIR}/${tool}.calls"
mkdir -p "${FAKE_DIR}/secrets"

# item <service> <account> prints the path of the item's file.
item() { printf '%s/secrets/%s@%s\n' "${FAKE_DIR}" "$1" "${2//\//_}"; }

# security_run <argument>… runs one security command.
security_run() {
  local command=$1 service='' account='' secret='' file
  shift
  while (( $# ))
  do
    case "$1" in
      (-s) service=$2; shift ;;
      (-a) account=$2; shift ;;
      (-w) if (( $# > 1 )); then secret=$2; shift; fi ;;
      (*) ;;
    esac
    shift
  done
  file=$(item "${service}" "${account}")
  case "${command}" in
    (add-generic-password) printf '%s' "${secret}" > "${file}" ;;
    (delete-generic-password) [[ -f "${file}" ]] && rm -f "${file}" || return 44 ;;
    (find-generic-password)
      [[ -f "${file}" ]] || return 44
      if [[ "$(cat "${file}")" != "$(tr -d '\n' < "${file}")" ]]
      then
        od -An -v -tx1 < "${file}" | tr -d ' \n' | tr a-f A-F
        printf '\n'
      else
        cat "${file}"
        printf '\n'
      fi
      ;;
    (*) return 1 ;;
  esac
}

case "${tool}" in
  (security)
    if [[ "${1:-}" == -i ]]
    then
      while IFS= read -r line
      do
        # the line holds no quote or space inside a word, as the kit writes it
        # shellcheck disable=SC2086  # split into words on purpose
        security_run ${line}
      done
    else
      security_run "$@"
    fi
    ;;
  (secret-tool)
    command=$1
    shift
    [[ "${1:-}" != --label=* ]] || shift
    [[ "$1" == service && "$3" == account ]] || exit 2
    file=$(item "$2" "$4")
    case "${command}" in
      (store) cat > "${file}" ;;
      (lookup) [[ -f "${file}" ]] || exit 1; cat "${file}" ;;
      (clear) rm -f "${file}" ;;
      (*) exit 2 ;;
    esac
    ;;
esac
