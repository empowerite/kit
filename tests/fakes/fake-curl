#!/usr/bin/env bash
# fake-curl - stands in for curl: serves the file named by the URL's last part from ${FAKE_RELEASES} (test helper)
# ----------------------------------------------------------------------------------------------------------------------
# Linked as curl on PATH. Every URL asked for is appended to ${FAKE_RELEASES}/curl.calls, and each --header sent with
# it to ${FAKE_RELEASES}/curl.headers. The response is the file ${FAKE_RELEASES}/<host>/<last part of the URL>, where
# there is one, so two hosts can serve one name differently, and ${FAKE_RELEASES}/<last part of the URL> otherwise,
# written to the --output file when there is one and to stdout otherwise, as curl does. A URL with no such file fails
# with 22, curl's status for an HTTP error under --fail; one whose host is ${FAKE_RELEASES}/unreachable's line fails
# with 7, curl's status when it cannot connect.

set -o errexit -o nounset -o pipefail
out='' url=''
while (( $# ))
do
  case "$1" in
    (--output | -o) out=$2; shift 2 ;;
    (--header | -H) printf '%s\n' "$2" >> "${FAKE_RELEASES}/curl.headers"; shift 2 ;;
    (-*) shift ;;
    (*) url=$1; shift
  esac
done
printf '%s\n' "${url}" >> "${FAKE_RELEASES}/curl.calls"
host=${url#*://}
host=${host%%/*}
if [[ -f "${FAKE_RELEASES}/unreachable" ]] && grep --quiet --line-regexp --fixed-strings "${host}" \
  "${FAKE_RELEASES}/unreachable"
then
  exit 7
fi
file="${FAKE_RELEASES}/${host}/${url##*/}"
[[ -f "${file}" ]] || file="${FAKE_RELEASES}/${url##*/}"
[[ -f "${file}" ]] || exit 22
if [[ -n "${out}" ]]
then cp "${file}" "${out}"
else cat "${file}"
fi

# ----------------------------------------------------------------------------------------------------------------------
