#!/usr/bin/env bash
# fake-go - stands in for go build: writes, at its -o path, a script that names the platform it was built for (test helper)
# ----------------------------------------------------------------------------------------------------------------------
#
# Linked as go on PATH. Each call is appended to ${FAKES}/go.calls with GOOS, GOARCH, and CGO_ENABLED first. The
# script it writes prints "kittui <goos>-<goarch>" and its arguments, native for an unset GOOS or GOARCH.

set -o errexit -o nounset -o pipefail
out=''
for (( i = 1; i <= $#; i++ ))
do
  if [[ "${!i}" == -o ]]
  then
    j=$(( i + 1 ))
    out=${!j}
  fi
done
printf '%s %s %s %s\n' "${GOOS:-}" "${GOARCH:-}" "${CGO_ENABLED:-}" "$*" >> "${FAKES:?}/go.calls"
mkdir -p "$(dirname "${out}")"
printf '#!/bin/sh\necho "kittui %s-%s" "$@"\n' "${GOOS:-native}" "${GOARCH:-native}" > "${out}"
chmod +x "${out}"

# ----------------------------------------------------------------------------------------------------------------------
