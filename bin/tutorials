#!/usr/bin/env bash
# tutorials - writes the catalogue of the top-level tutorials, the body of a region in kit/modules/tutorials.yml
# ----------------------------------------------------------------------------------------------------------------------
# kit tutorials lists the tutorials from kit/modules/tutorials.yml, and that file's catalogue region is this script's
# output, so the list is never typed twice: a page's front matter is the only place a tutorial is described. Run
# `kit generate kit/modules/tutorials.yml` to rewrite the region; `kit generate --check` fails when it is stale.
#
# The tutorials are of two kinds. An online tutorial is a top-level page of the site: a page with `top: true`, at
# <id>/index.mdx under the project's src/content/, listed with its path on the site. A tutorial that ships with the kit
# is a markdown page, <id>.md under kit/modules/tutorials/, which kit tutorials reads on this machine, listed with its
# file, from modules/. Each kind has the same front matter. The catalogue holds the audiences, each its id, label, and
# color, in the order projects/tutorials/audiences.yml lists them, and the tutorials of both kinds sorted by `order`
# (1000 when a page has none), then id. A file that cannot be listed is refused, naming the file and why, and the exit
# status is 1: an audience without a color shaped #rrggbb; a tutorial's page lacking a title, a summary, a glyph, or
# an audience; one with an audience that audiences.yml does not list; or a top-level page that is not at
# <id>/index.mdx.
#
#   bin/tutorials catalogue
#
# TUTORIALS_PROJECT names the project, projects/tutorials by default, and TUTORIALS_SHIPPED the directory of the pages
# that ship with the kit, kit/modules/tutorials by default, where none is no error; the tests point both at fixtures.

set -o errexit -o nounset -o pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

project=${TUTORIALS_PROJECT:-projects/tutorials}
content=${project}/src/content
shipped=${TUTORIALS_SHIPPED:-kit/modules/tutorials}

# refuse <file> <reason> says why a page cannot be listed, and stops.
refuse() {
  printf '❌ %s: %s\n' "$1" "$2" >&2
  exit 1
}

# row <file> <front> <noun> <top> <shaped> <id> <key> <value> prints the page's row of the catalogue, JSON, its
# <key> <value> the page's path on the site or its file, or refuses it, calling it <noun>. With <top> true, a page
# whose front matter, the JSON <front>, lacks top: true is skipped, printing nothing, and one that is not <shaped> at
# <id>/index.mdx is refused. Then a page is refused that lacks a title, a summary, a glyph, or an audience, or names
# an audience that audiences.yml does not list. One jq judges the page and makes its row, where a jq a question would
# start a process for each. It reads audiences.
row() {
  local file=$1 front=$2 noun=$3 said
  # shellcheck disable=SC2016  # the program is jq's, not the shell's
  said=$(jq -r --argjson audiences "${audiences}" --argjson top "$4" --argjson shaped "$5" --arg id "$6" \
    --arg key "$7" --arg value "$8" '
    def has_text($field): try (.[$field] | type == "string" and length > 0) catch false;
    if $top and ((try (.top // false) catch false) | tostring) != "true" then "skip"
    elif $top and ($shaped | not) then "refuse\ta top-level page lives at <id>/index.mdx"
    else
      . as $front
      | (first(("title", "summary", "glyph") | select(. as $field | $front | has_text($field) | not)) // null) as $lacks
      | if $lacks then "refuse\tneeds a \($lacks)"
        elif (try (.audience | type == "array" and length > 0) catch false) | not then "refuse\tneeds an audience"
        else
          (first(.audience[] | select(. as $a | $audiences | map(.id) | index($a) | not)) // null) as $unknown
          | if $unknown != null then "unknown\t\($unknown)"
            else "row\t" + ({id: $id, ($key): $value, title, summary, glyph, audience, order: (.order // 1000)}
              | tojson)
            end
        end
    end' <<< "${front}")
  case "${said}" in
    (skip) ;;
    (refuse$'\t'needs*) refuse "${file}" "${noun} ${said#*$'\t'}" ;;
    (refuse$'\t'*) refuse "${file}" "${said#*$'\t'}" ;;
    (unknown$'\t'*) refuse "${file}" "the audience '${said#*$'\t'}' is not in ${project}/audiences.yml" ;;
    (*) pages+=("${said#*$'\t'}")
  esac
}

# catalogue prints the region's body, YAML, on stdout.
catalogue() {
  local audiences pages=() file front id shaped
  audiences=$(yq -p yaml -o json '.' "${project}/audiences.yml")
  # shaped is the first audience with no color, its id after "none", or else the first whose color is not #rrggbb: its
  # id, a tab, and the color
  shaped=$(jq --raw-output '(first(.[] | select((.color // "") == "") | "none\t\(.id)")
    // first(.[] | select(.color | type != "string" or (test("^#[0-9A-Fa-f]{6}$") | not)) | "\(.id)\t\(.color)"))
    // empty' <<< "${audiences}")
  [[ "${shaped}" != none$'\t'* ]] \
    || refuse "${project}/audiences.yml" "the audience '${shaped#none$'\t'}' needs a color, as #rrggbb"
  [[ -z "${shaped}" ]] || refuse "${project}/audiences.yml" \
    "the audience '${shaped%%$'\t'*}' has the color '${shaped#*$'\t'}', not #rrggbb"

  while IFS= read -r file
  do
    front=$(yq -p yaml --front-matter=extract -o json '.' "${file}") || refuse "${file}" 'front matter that does not parse'
    id=${file#"${content}/"}
    shaped=false
    [[ ! "${id}" =~ ^[^/]+/index\.mdx$ ]] || shaped=true
    id=${id%/index.mdx}
    row "${file}" "${front}" 'a top-level page' true "${shaped}" "${id}" path "${id}/"
  done < <(find "${content}" -type f -name '*.mdx' | LC_ALL=C sort)

  # the pages that ship with the kit, each at <id>.md
  while IFS= read -r file
  do
    front=$(yq -p yaml --front-matter=extract -o json '.' "${file}") || refuse "${file}" 'front matter that does not parse'
    id=${file##*/}
    id=${id%.md}
    row "${file}" "${front}" 'a tutorial' false true "${id}" file "tutorials/${id}.md"
  done < <([[ ! -d "${shipped}" ]] || find "${shipped}" -maxdepth 1 -type f -name '*.md' | LC_ALL=C sort)

  # shellcheck disable=SC2016  # the program is jq's, not the shell's
  printf '%s\n' "${pages[@]+"${pages[@]}"}" \
    | jq -s --argjson audiences "${audiences}" \
      '{audiences: ($audiences | map({id, label, color})), tutorials: sort_by([.order, .id])}' \
    | yq -p json -o yaml -P '.'
}

case "${1:-}" in
  catalogue) catalogue ;;
  *)
    printf 'usage: bin/tutorials catalogue\n' >&2
    exit 2
    ;;
esac

# ----------------------------------------------------------------------------------------------------------------------
