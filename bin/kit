#!/usr/bin/env bash
# kit - install, update, and check the kit in a repository (executed entrypoint)
# ----------------------------------------------------------------------------------------------------------------------
#
#   kit install [<target>…]     copy this release's text into the repository, place the files each named target
#                               needs, wire this clone's hooks, and write .kit/manifest
#   kit update                  after the pin is bumped: replace unchanged files, three-way merge changed ones
#   kit check                   fail when a delivered file differs from this release
#   kit setup                   wire this clone: core.hooksPath to this release's hooks
#   kit target list             print the targets this repository takes
#   kit target add <target>…    take a target: place its files and record it
#   kit target remove <target>… drop a target: remove its files and the kit's entries from its settings
#   kit issue [<number>…]       start or resume an issue: linked branch, worktree, start commit, draft pull request
#   kit tidy [--dry-run]        remove worktrees whose pull request is merged or closed, and gone branches
#   kit status [--no-fetch]     show every worktree with its branch, pull request, and state
#   kit version                 print this release's version
#
# The repository carries the text an agent reads, .kit/1st.md and .kit/rules/, the CI workflow .kit/ci.yml placed
# as .github/workflows/kit-ci.yml, the placed files of each target taken, and .kit/manifest, which records the
# release version, the targets, and a digest per delivered path. The machinery stays in the release where mise
# installed it: this command, the bash behind issue, tidy, and status, and the hooks, which a clone reaches through
# core.hooksPath.
#
# A target is a harness that insists on files placed outside .kit/. The one this release knows is claude:
# .claude/rules/kit-<kind>.md, a copy of each rule file, whose own paths: header the harness loads it by, and the deny entries
# merged into .claude/settings.json. A repository takes only the targets it names. A shared settings file is
# merged by key: the kit owns only the entries it writes.
#
# KIT_BASE=<dir> names the previous release's root for `kit update` on a machine without mise.
#
# see: .kit/1st.md

set -o errexit -o nounset -o pipefail

kit_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
payload="${kit_root}/.kit"
# shellcheck source=.kit/bash/1st.sh
source "${payload}/bash/1st.sh"

known_targets=(claude)

usage() {
  sed -n '5,16p' "${BASH_SOURCE[0]}" | sed 's/^#//; s/^ //' >&2
}

# digest prints the sha256 of stdin, by whichever tool the machine carries.
digest() {
  if command -v sha256sum >/dev/null 2>&1
  then
    sha256sum | cut -d ' ' -f 1
  else
    shasum -a 256 | cut -d ' ' -f 1
  fi
}

# known-target <name> is true when this release knows the target.
known-target() {
  local t
  for t in "${known_targets[@]}"
  do
    [[ "$1" == "${t}" ]] && return 0
  done
  return 1
}

# require-targets <name>… refuses an unknown target, naming the known ones.
require-targets() {
  local t
  for t in "$@"
  do
    if ! known-target "${t}"
    then
      error "'${t}' is not a target this release knows; the targets are: ${known_targets[*]}"
      return 2
    fi
  done
}

# manifest-version and manifest-targets read .kit/manifest.
manifest-version() { sed -n 's/^version //p' .kit/manifest; }
manifest-targets() { sed -n 's/^targets *//p' .kit/manifest; }

# target-paths <payload> <target> prints the repository paths a target places.
target-paths() {
  local root=$1 file
  case "$2" in
    (claude)
      for file in "${root}"/rules/*.md
      do
        printf '.claude/rules/kit-%s\n' "$(basename "${file}")"
      done
  esac
}

# target-settings <target> prints the settings file a target shares with the repository, or nothing.
target-settings() {
  case "$1" in
    (claude) printf '.claude/settings.json\n'
  esac
}

# delivered-paths <payload> [<target>…] prints every repository path the release delivers for those targets.
delivered-paths() {
  local root=$1 file t
  shift
  printf '.kit/1st.md\n'
  for file in "${root}"/rules/*.md
  do
    printf '.kit/rules/%s\n' "$(basename "${file}")"
  done
  printf '.github/workflows/kit-ci.yml\n'
  for t in "$@"
  do
    target-paths "${root}" "${t}"
  done
}

# expected <payload> <path> prints the content the release at <payload> delivers at repository <path>.
expected() {
  local root=$1 path=$2 kind
  case "${path}" in
    (.kit/*)
      cat "${root}/${path#.kit/}"
      ;;
    (.claude/rules/kit-*.md)
      # The rule file as it is, its paths: header included, with a one-line notice inside the header.
      kind=${path#.claude/rules/kit-}
      kind=${kind%.md}
      printf -- '---\n# Placed by kit install from .kit/rules/%s.md, not edited by hand.\n' "${kind}"
      tail -n +2 "${root}/rules/${kind}.md"
      ;;
    (.github/workflows/kit-ci.yml)
      cat "${root}/ci.yml"
      ;;
    (*)
      error "kit: '${path}' is not a delivered path"
      return 2
  esac
}

# write-expected <payload> <path> writes the delivered content at <path>, making its directory.
write-expected() {
  mkdir -p "$(dirname "$2")"
  expected "$1" "$2" > "$2.kit-new"
  mv "$2.kit-new" "$2"
}

# merge-settings <target> <new-payload> [<base-payload>] merges the kit's deny entries into the target's settings
# file: the base release's entries go, the new release's come, and everything else in the file stays. An empty
# <new-payload> takes the kit's entries out and adds none.
merge-settings() {
  local file new_deny='[]' base_deny='[]'
  file=$(target-settings "$1")
  [[ -n "${file}" ]] || return 0
  [[ -n "$2" && -f "$2/settings.json" ]] && new_deny=$(jq '.permissions.deny // []' "$2/settings.json")
  [[ -n "${3:-}" && -f "$3/settings.json" ]] && base_deny=$(jq '.permissions.deny // []' "$3/settings.json")
  mkdir -p "$(dirname "${file}")"
  [[ -f "${file}" ]] || printf '{}\n' > "${file}"
  jq --indent 2 --argjson base "${base_deny}" --argjson new "${new_deny}" \
    '.permissions.deny = (((.permissions.deny // []) - $base) as $kept | $kept + ($new - $kept))' \
    "${file}" > "${file}.kit-new"
  mv "${file}.kit-new" "${file}"
}

# ensure-ignored makes sure worktrees/ is ignored at the root, the way the loop needs.
ensure-ignored() {
  local separator=""
  if [[ -f .gitignore ]] && grep --quiet --line-regexp --extended-regexp '/?worktrees/' .gitignore
  then
    return 0
  fi
  [[ -f .gitignore && -s .gitignore ]] && separator=$'\n'
  printf '%s# the per-issue worktrees of the loop; see: .kit/1st.md\n/worktrees/\n' "${separator}" >> .gitignore
}

# write-manifest [<target>…] records the release version, the targets taken, and, per delivered path, the
# digest of the release's own content for it, never of the file as written: a later update tells an untouched
# file from an edited one by comparing the file to this, so a merge that kept a repository's edit is not mistaken
# for the release's text.
write-manifest() {
  local path
  {
    printf '# .kit/manifest - written by kit, not by hand\n'
    printf 'version %s\n' "$(cat "${payload}/version")"
    printf 'targets%s\n' "${*:+ $*}"
    while IFS= read -r path
    do
      printf '%s  %s\n' "$(expected "${payload}" "${path}" | digest)" "${path}"
    done < <(delivered-paths "${payload}" "$@")
  } > .kit/manifest
}

# wire-hooks points this clone's core.hooksPath at the release's hooks.
wire-hooks() {
  git config core.hooksPath "${payload}/hooks"
}

# finish wires the clone and reports.
finish() {
  wire-hooks
  ok "kit $(cat "${payload}/version") is installed, targets: ${*:-none}. core.hooksPath is ${payload}/hooks, and .kit/manifest is written."
  step "Commit the delivered files. The loop is in .kit/1st.md."
}

cmd-setup() {
  guard:require tool:git
  wire-hooks
  ok "core.hooksPath is ${payload}/hooks"
  if [[ -z "$(git config user.signingkey 2>/dev/null)" ]]
  then
    warn "no signing key is configured in this clone, and the ruleset refuses an unsigned commit; see README.md § Setup"
  fi
}

# cmd-loop <verb> <args>… runs one of the loop's commands from the release's bash.
cmd-loop() {
  local verb=$1
  shift
  case "${verb}" in
    (issue)  gh:issue "$@" ;;
    (tidy)   git:tidy "$@" ;;
    (status) git:status "$@" ;;
  esac
}

cmd-install() {
  guard:require tool:jq tool:git
  require-targets "$@"
  if [[ -f .kit/manifest ]]
  then
    error "run: kit update (this repository already carries kit $(manifest-version))"
    return 1
  fi
  section "kit install $(cat "${payload}/version")${*:+, targets: $*}"
  local path t
  while IFS= read -r path
  do
    step "${path}"
    write-expected "${payload}" "${path}"
  done < <(delivered-paths "${payload}" "$@")
  for t in "$@"
  do
    merge-settings "${t}" "${payload}"
  done
  ensure-ignored
  write-manifest "$@"
  finish "$@"
}

cmd-update() {
  guard:require tool:jq tool:git
  if [[ ! -f .kit/manifest ]]
  then
    error "run: kit install (this repository carries no .kit/manifest)"
    return 1
  fi
  local previous current base_root="" path recorded actual conflicts=0 t
  local -a targets
  read -r -a targets <<<"$(manifest-targets)"
  previous=$(manifest-version)
  current=$(cat "${payload}/version")
  section "kit update ${previous} → ${current}${targets[*]:+, targets: ${targets[*]}}"

  # The previous release is the base of every three-way merge. KIT_BASE names its root directly; otherwise
  # mise keeps it where it installed it.
  if [[ -n "${KIT_BASE:-}" ]]
  then
    base_root=${KIT_BASE}
  elif [[ "${previous}" != "${current}" ]] && command -v mise >/dev/null 2>&1
  then
    base_root=$(mise where "github:empowerite/kit@${previous}" 2>/dev/null || true)
    if [[ -z "${base_root}" ]] && mise install --quiet "github:empowerite/kit@${previous}" 2>/dev/null
    then
      base_root=$(mise where "github:empowerite/kit@${previous}" 2>/dev/null || true)
    fi
  fi
  [[ -n "${base_root}" ]] && base_root="${base_root}/.kit"

  while IFS= read -r path
  do
    if [[ ! -f "${path}" ]]
    then
      step "${path}: missing, written"
      write-expected "${payload}" "${path}"
      continue
    fi
    recorded=$(awk -v p="${path}" '$2==p{print $1}' .kit/manifest)
    actual=$(digest < "${path}")
    if [[ -z "${recorded}" || "${recorded}" == "${actual}" ]]
    then
      step "${path}: unchanged since ${previous}, replaced"
      write-expected "${payload}" "${path}"
      continue
    fi
    if [[ -z "${base_root}" || ! -d "${base_root}" ]]
    then
      error "${path} was edited and the base release ${previous} is not installed; run: mise install github:empowerite/kit@${previous}"
      conflicts=$(( conflicts + 1 ))
      continue
    fi
    step "${path}: edited since ${previous}, three-way merged"
    expected "${base_root}" "${path}" > "${path}.kit-base"
    expected "${payload}" "${path}" > "${path}.kit-new"
    if ! git merge-file --marker-size 7 "${path}" "${path}.kit-base" "${path}.kit-new"
    then
      warn "${path}: conflict markers are left in the file; resolve them, then run: kit check"
      conflicts=$(( conflicts + 1 ))
    fi
    rm -f "${path}.kit-base" "${path}.kit-new"
  done < <(delivered-paths "${payload}" "${targets[@]}")

  for t in "${targets[@]}"
  do
    merge-settings "${t}" "${payload}" "${base_root}"
  done
  ensure-ignored
  write-manifest "${targets[@]}"
  if (( conflicts > 0 ))
  then
    error "${conflicts} file(s) need a hand; see above."
    return 1
  fi
  finish "${targets[@]}"
}

cmd-check() {
  local path findings=0 version t file
  local -a targets
  if [[ ! -f .kit/manifest ]]
  then
    error "run: kit install (this repository carries no .kit/manifest)"
    return 1
  fi
  read -r -a targets <<<"$(manifest-targets)"
  version=$(manifest-version)
  if [[ "${version}" != "$(cat "${payload}/version")" ]]
  then
    error ".kit/manifest records kit ${version}, and the pinned release is $(cat "${payload}/version"); run: kit update"
    findings=$(( findings + 1 ))
  fi
  while IFS= read -r path
  do
    if [[ ! -f "${path}" ]]
    then
      error "${path} is missing"
      findings=$(( findings + 1 ))
    elif ! expected "${payload}" "${path}" | cmp --silent - "${path}"
    then
      error "${path} differs from the pinned release"
      findings=$(( findings + 1 ))
    fi
  done < <(delivered-paths "${payload}" "${targets[@]}")
  for t in "${targets[@]}"
  do
    file=$(target-settings "${t}")
    [[ -n "${file}" ]] || continue
    if [[ ! -f "${file}" ]]
    then
      error "${file} is missing; run: kit update"
      findings=$(( findings + 1 ))
    elif ! command -v jq >/dev/null 2>&1
    then
      error "run: mise install (jq is not on PATH, so ${file} could not be read)"
      findings=$(( findings + 1 ))
    elif (( $(jq --argjson new "$(jq '.permissions.deny // []' "${payload}/settings.json")" \
        '($new - (.permissions.deny // [])) | length' "${file}") > 0 ))
    then
      error "${file} is missing a deny entry the kit writes; run: kit update"
      findings=$(( findings + 1 ))
    fi
  done
  if (( findings > 0 ))
  then
    error "${findings} finding(s). A delivered file is changed by pinning a new release and running kit update, not in place."
    return 1
  fi
  ok "kit ${version}, targets ${targets[*]:-none}: every delivered file matches the pinned release."
}

cmd-target() {
  local verb=${1:-list} t path
  local -a targets kept
  shift || true
  if [[ ! -f .kit/manifest ]]
  then
    error "run: kit install (this repository carries no .kit/manifest)"
    return 1
  fi
  read -r -a targets <<<"$(manifest-targets)"
  case "${verb}" in
    (list)
      printf '%s\n' "${targets[@]}"
      ;;
    (add)
      (( $# > 0 )) || { error "usage: kit target add <target>…"; return 2; }
      guard:require tool:jq tool:git
      require-targets "$@"
      for t in "$@"
      do
        if [[ " ${targets[*]} " == *" ${t} "* ]]
        then
          step "${t}: already taken"
          continue
        fi
        section "kit target add ${t}"
        while IFS= read -r path
        do
          step "${path}"
          write-expected "${payload}" "${path}"
        done < <(target-paths "${payload}" "${t}")
        merge-settings "${t}" "${payload}"
        targets+=("${t}")
      done
      write-manifest "${targets[@]}"
      ok "targets: ${targets[*]}"
      ;;
    (remove)
      (( $# > 0 )) || { error "usage: kit target remove <target>…"; return 2; }
      guard:require tool:jq tool:git
      require-targets "$@"
      for t in "$@"
      do
        if [[ " ${targets[*]} " != *" ${t} "* ]]
        then
          step "${t}: not taken"
          continue
        fi
        section "kit target remove ${t}"
        while IFS= read -r path
        do
          step "removing ${path}"
          rm -f "${path}"
        done < <(target-paths "${payload}" "${t}")
        [[ -f "$(target-settings "${t}")" ]] && merge-settings "${t}" "" "${payload}"
        kept=()
        for path in "${targets[@]}"
        do
          [[ "${path}" == "${t}" ]] || kept+=("${path}")
        done
        targets=("${kept[@]+"${kept[@]}"}")
      done
      write-manifest "${targets[@]+"${targets[@]}"}"
      ok "targets: ${targets[*]:-none}"
      ;;
    (*)
      error "kit target: unknown verb '${verb}' (list, add, remove)"
      return 2
  esac
}

case "${1:-}" in
  (install) shift; cmd-install "$@" ;;
  (update)  cmd-update ;;
  (check)   cmd-check ;;
  (setup)   cmd-setup ;;
  (target)  shift; cmd-target "$@" ;;
  (issue | tidy | status) cmd-loop "$@" ;;
  (version) cat "${payload}/version" ;;
  (-h | --help | help | "") usage; [[ -n "${1:-}" ]] ;;
  (*)
    error "kit: unknown command '$1'"
    usage
    exit 2
esac

# ----------------------------------------------------------------------------------------------------------------------
