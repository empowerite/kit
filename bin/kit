#!/usr/bin/env bash
# kit - the kit's command: each verb is the executable bin/kit-<verb>.sh beside it (executed entrypoint)
# ----------------------------------------------------------------------------------------------------------------------
#
# The release is the directory above bin/. This file resolves it, exports it as kit_root, and hands the verb its
# arguments. Everything else, the usage text included, lives with the verb.
#
# see: .kit/1st.md

set -o errexit -o nounset -o pipefail

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) ))
then
  echo "kit needs bash 4.4 or later; this is ${BASH_VERSION}" >&2
  exit 1
fi

kit_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export kit_root

verb=${1:-help}
case "${verb}" in
  (help | -h | --help)
    cat <<'USAGE'
usage: kit <verb> [<argument>…]

  install [<target>…]   mirror the release into the repository, take the named targets, write .kit/manifest
  update                after the pin is bumped: replace unchanged files, three-way merge changed ones
  check                 fail when a delivered file differs from the pinned release
  target <list|add|remove> [<target>…]
                        the targets this repository takes
  issue [<number>…]     start or resume an issue: linked branch, worktree, start commit, draft pull request
  rebase [<path>]       rebase a worktree's branch onto the default branch and push it; never the default branch
  tidy [--dry-run]      remove worktrees whose pull request is merged or closed, and gone branches
  status [--no-fetch]   show every worktree with its branch, pull request, and state
  lint [--all-files]    run the pre-commit hook's linters by hand, over the staged paths or every path
  version               print this release's version

Each verb answers --help.
USAGE
    ;;
  (*)
    if [[ ! -x "${kit_root}/bin/kit-${verb}.sh" ]]
    then
      echo "kit: unknown verb '${verb}'; run: kit help" >&2
      exit 2
    fi
    shift
    exec "${kit_root}/bin/kit-${verb}.sh" "$@"
esac

# ----------------------------------------------------------------------------------------------------------------------
