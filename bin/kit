#!/usr/bin/env bash
# kit - the kit's command: each verb is the executable bin/kit-<verb>.sh beside it (executed entrypoint)
# ----------------------------------------------------------------------------------------------------------------------
#
# The release is the directory above bin/, found through any symlink this file is reached by, as when Homebrew
# links it into its own bin. This file resolves it, exports it as kit_root, moves to the repository root so every
# verb reads and writes the same paths wherever it was typed, and hands the verb its arguments. The directory it
# was typed in is exported as kit_invoked_in for the verbs that take relative paths. Everything else, the usage
# text included, lives with the verb.
#
# see: .kit/1st.md

set -o errexit -o nounset -o pipefail

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) ))
then
  echo "kit needs bash 4.4 or later; this is ${BASH_VERSION}" >&2
  exit 1
fi

# readlink -f needs macOS 12.3 or later, the first with a GNU-compatible readlink; older macOS lacks it.
kit_root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export kit_root
kit_invoked_in=$(pwd -P)
export kit_invoked_in
if repository=$(git rev-parse --show-toplevel 2>/dev/null)
then
  cd "${repository}"
fi

verb=${1:-help}
case "${verb}" in
  (help | -h | --help)
    cat <<'USAGE'
usage: kit <verb> [<argument>…]

  install [<module>…]   activate the default modules and the named ones, place their files, write .kit/manifest
  update                after the pin is bumped: replace unchanged files, three-way merge changed ones
  check                 fail when a delivered file differs from the pinned release
  module <list|add|remove> [<module>…]
                        the modules this repository takes
  context <path>…       name the rules that govern a file, and record the ask
  generate [--check] [<path>…]
                        expand every kit:generate region to what its command makes, or check that it is
  region [--home] [<path>]
                        print the content the active modules deliver as the region at a path
  ci                    the delivered CI job's checks, anywhere: gate, check, and linked, every one reported
  gate                  run the repository's gate, the gate setting or the detected one; refuse when there is none
  linked [<number>]     refuse a pull request not linked to an open issue of this repository
  issue [<number>…]     start or resume an issue: linked branch, worktree, start commit, draft pull request
  rebase [<path>]       rebase a worktree's branch onto the default branch and push it; never the desk
  tidy [--dry-run]      remove worktrees whose pull request is merged or closed, and gone branches
  status [--no-fetch] [--json] [--mine | --all | --owner=<login>…]
                        the desk, the worktrees, and the open pull requests: everyone's, yours, or the named
                        authors'
  lint [--all-files] [<path>…]
                        run each rule's linter over the paths it governs: staged, named, or every tracked one
  release <verify|pack|publish|retire> …
                        the kit's own release: verify a tag, pack a checkout, publish it, retire pre-releases
  version               print this release's version

Each verb answers --help.
USAGE
    ;;
  (*)
    if [[ ! -x "${kit_root}/bin/kit-${verb}.sh" ]]
    then
      echo "kit: unknown verb '${verb}'; run: kit help" >&2
      exit 2
    fi
    shift
    exec "${kit_root}/bin/kit-${verb}.sh" "$@"
esac

# ----------------------------------------------------------------------------------------------------------------------
