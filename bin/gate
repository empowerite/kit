#!/bin/sh
# bin/gate - the gate: formatting, vet, and every package's tests, judged for failures, coverage, and time
set -eu
CDPATH='' cd -- "$(dirname -- "$0")/.."
since=$(date +%s)
# go list names this module's packages alone, so another issue's worktree under worktrees/ is left out.
unformatted=$(go list -f '{{.Dir}}' ./... | xargs gofmt -l)
if [ -n "${unformatted}" ]
then
  echo "gate: format: gofmt would change:"
  echo "${unformatted}"
  exit 1
fi
go vet ./...
work=$(mktemp -d)
trap 'rm -rf "${work:?}"' EXIT
go build -o "${work}/gate" ./tools/gate
# The events go to a file and go test's status is kept, so the judge sees a run that stopped short. No test may
# take the gate's whole budget: one that hangs is ended, and fails.
status=0
go test -json -timeout=3m -coverprofile="${work}/cover.out" ./... > "${work}/events" || status=$?
"${work}/gate" --profile="${work}/cover.out" --since="${since}" --status="${status}" < "${work}/events"
