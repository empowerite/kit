#!/usr/bin/env bash
# bin/gate - the gate: vet, the tools kit.lock pins, shellcheck, and every package's tests, judged for failures,
# coverage, and time
#
# The rules the tree itself keeps (its layers, its formatting, one module, every file in every build) are a test
# among them, in tools/layers.
#
# The gate builds kit, and has it fetch the tools kit.lock pins; the judge then holds each program to the lock
# itself, so the gate does not take kit's word that a tool is the one pinned. --trust=checkout trusts this checkout
# for the run alone: to run the gate is the person's own act.
#
# usage: bin/gate [--keep=<directory>]
#
# --keep=<directory> keeps there what the run made, for a person to read or for CI to attach to its run. The verdict
# is always among it, as verdict.txt: the judge's own lines, or the step the gate stopped at before the judge ran.
# With it, where they were made: go test's events as events.json, its coverage profile as cover.out, and what
# go vet objected to as vet.txt.
set -o errexit -o nounset -o pipefail

keep=''
for arg in "$@"
do
  if [[ "${arg}" == --keep=?* ]]
  then
    keep=${arg#--keep=}
  else
    echo 'usage: bin/gate [--keep=<directory>]' >&2
    exit 2
  fi
done
if [[ -n "${keep}" ]]
then
  # Made, and named in full, before the gate moves to the root: the directory is given from where the person stands.
  mkdir -p -- "${keep}"
  keep=$(CDPATH='' cd -- "${keep}" && pwd)
fi

CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
since=$(date +%s)
work=$(mktemp -d)
made="${work}/made"
mkdir "${made}"
step='its start'

# finish runs however the gate ends. It gives a verdict where no step gave one, as when a step fails in a way the
# gate did not foresee, and keeps what was made where --keep says.
# shellcheck disable=SC2329  # the trap below calls it
finish() {
  local status=$?
  if [[ ! -s "${made}/verdict.txt" ]]
  then
    echo "gate: ${step}: the gate stopped at this step, with status ${status}, before a verdict:" \
      'the lines above say why' | tee "${made}/verdict.txt"
  fi
  if [[ -n "${keep}" ]]
  then
    cp -- "${made}"/* "${keep}/"
  fi
  rm -rf "${work:?}"
}
trap finish EXIT

step='vet'
# vet reads the nightly tier's tests too, so one that no longer compiles is seen here, though the gate never runs it.
if ! go vet -tags=nightly ./... > "${made}/vet.txt" 2>&1
then
  cat "${made}/vet.txt"
  echo 'gate: vet: go vet objects: its lines are above' | tee "${made}/verdict.txt"
  exit 1
fi
rm -f "${made}/vet.txt"

step='the build of the judge'
go build -o "${work}/judge" ./tools/gate

step='the build of kit'
go build -o "${work}/kit" ./cmd/kit

step='the tools'
if ! "${work}/kit" tools check > "${made}/tools.txt" 2>&1 \
  || ! "${work}/kit" tools fetch --trust=checkout >> "${made}/tools.txt" 2>&1 \
  || ! shellcheck=$("${work}/kit" tools path shellcheck --trust=checkout 2>> "${made}/tools.txt")
then
  cat "${made}/tools.txt"
  echo 'gate: tools: kit cannot give the tools kit.lock pins: its lines are above' | tee "${made}/verdict.txt"
  exit 1
fi
if ! "${work}/judge" --program="${shellcheck}" --tool=shellcheck --lock=kit.lock >> "${made}/tools.txt"
then
  tail -n 1 "${made}/tools.txt" | tee "${made}/verdict.txt"
  exit 1
fi

step='shellcheck'
# Every script of the repository's: what bin/ holds, and every .sh file git tracks.
scripts=()
while IFS= read -r script
do
  scripts+=("${script}")
done < <(git ls-files -- bin '*.sh')
version=$("${shellcheck}" --version | sed -n 's/^version: //p')
if ! "${shellcheck}" -- "${scripts[@]}" > "${made}/shellcheck.txt" 2>&1
then
  cat "${made}/shellcheck.txt"
  echo "gate: shellcheck: shellcheck ${version} finds what is above" | tee "${made}/verdict.txt"
  exit 1
fi
rm -f "${made}/shellcheck.txt"
echo "gate: shellcheck: ok: shellcheck ${version}, as kit.lock pins it, finds nothing in ${#scripts[@]} script(s)" \
  >> "${made}/tools.txt"

step='the tests'
# The events go to a file and go test's status is kept, so the judge sees a run that stopped short. No test may
# take the gate's whole budget: one that hangs is ended, and fails.
status=0
go test -json -timeout=3m -coverprofile="${made}/cover.out" ./... > "${made}/events.json" || status=$?

step='the judge'
verdict=0
tail -n 1 "${made}/tools.txt" | tee "${made}/verdict.txt"
"${work}/judge" --profile="${made}/cover.out" --since="${since}" --status="${status}" < "${made}/events.json" \
  | tee -a "${made}/verdict.txt" || verdict=$?
exit "${verdict}"
