#!/usr/bin/env bash
# bin/gate - the gate: vet, and every package's tests, judged for failures, coverage, and time
#
# The rules the tree itself keeps (its layers, its formatting, one module, every file in every build) are a test
# among them, in tools/layers.
#
# usage: bin/gate [--keep=<directory>]
#
# --keep=<directory> keeps there what the run made, for a person to read or for CI to attach to its run: go test's
# events as events.json, its coverage profile as cover.out, and the judge's own lines as verdict.txt.
set -o errexit -o nounset -o pipefail

keep=''
for arg in "$@"
do
  if [[ "${arg}" == --keep=?* ]]
  then
    keep=${arg#--keep=}
  else
    echo 'usage: bin/gate [--keep=<directory>]' >&2
    exit 2
  fi
done
if [[ -n "${keep}" ]]
then
  # Made, and named in full, before the gate moves to the root: the directory is given from where the person stands.
  mkdir -p -- "${keep}"
  keep=$(CDPATH='' cd -- "${keep}" && pwd)
fi

CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
since=$(date +%s)
# vet reads the nightly tier's tests too, so one that no longer compiles is seen here, though the gate never runs it.
go vet -tags=nightly ./...
work=$(mktemp -d)
trap 'rm -rf "${work:?}"' EXIT
go build -o "${work}/gate" ./tools/gate
# The events go to a file and go test's status is kept, so the judge sees a run that stopped short. No test may
# take the gate's whole budget: one that hangs is ended, and fails.
status=0
go test -json -timeout=3m -coverprofile="${work}/cover.out" ./... > "${work}/events.json" || status=$?
verdict=0
"${work}/gate" --profile="${work}/cover.out" --since="${since}" --status="${status}" < "${work}/events.json" \
  | tee "${work}/verdict.txt" || verdict=$?
if [[ -n "${keep}" ]]
then
  cp -- "${work}/events.json" "${work}/verdict.txt" "${keep}/"
  # go test writes no profile when it stops before any package ends.
  if [[ -f "${work}/cover.out" ]]
  then
    cp -- "${work}/cover.out" "${keep}/"
  fi
fi
exit "${verdict}"
