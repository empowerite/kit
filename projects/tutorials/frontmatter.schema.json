{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/empowerite/kit/projects/tutorials/frontmatter.schema.json",
  "title": "the front matter of a page of the tutorials site",
  "description": "Every page has a title. A top-level tutorial, top: true, is one kit lists in its catalogue, so it also has the summary, glyph, and audience kit shows on its button. Each key is described in projects/tutorials/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "top": {
      "type": "boolean",
      "default": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "glyph": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "An id in projects/tutorials/audiences.yml."
      }
    },
    "order": {
      "type": "integer",
      "default": 1000
    }
  },
  "if": {
    "properties": {
      "top": {
        "const": true
      }
    },
    "required": [
      "top"
    ]
  },
  "then": {
    "required": [
      "summary",
      "glyph",
      "audience"
    ]
  }
}
