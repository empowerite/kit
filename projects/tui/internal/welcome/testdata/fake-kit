#!/usr/bin/env bash
# fake-kit - stands in for kit in the welcome screen's tests: answers welcome --checks and --fix, and root (test helper)
# ----------------------------------------------------------------------------------------------------------------------
# welcome --checks --json prints checks.json, in the directory it runs in, else beside this script, with every check
# named in the file FAKE_WELCOME_STATE turned ok, with no fix, as a check that holds has none. welcome --fix=jq,
# toolchain-project, kit-installed, or hooks-installed adds the id to that file, so a later --checks finds it fixed in
# every folder, and exits 0; a --folder= after it is taken and kept in the calls. --fix=gh-auth changes nothing and
# exits 1, as a fix after which the check still fails. --fix=brew-path, a show-only check, and any other id, and the id
# FAKE_WELCOME_REFUSE_FIX names, is a refusal with exit 2. welcome --keep=<id> adds the id to that file, as a kept check
# holds, prints the check kept, its line after kept:, or FAKE_WELCOME_KEPT when it is set, and exits 0, or 2 for an id
# FAKE_WELCOME_REFUSE_KEEP names. Every welcome call is written to the file FAKE_WELCOME_CALLS names, when it is set.
# --checks refuses as kit does when FAKE_WELCOME_REFUSE is set, and sleeps five seconds first when FAKE_WELCOME_SLOW is;
# with --progress, it says on stderr that it checks tool-jq, then that the machine's checks end. root prints
# FAKE_WELCOME_ROOT, else the release directory beside this script, which holds the pages.

set -o errexit -o nounset -o pipefail

here=$(cd "$(dirname "$0")" && pwd)
state=${FAKE_WELCOME_STATE:-/dev/null}

# --workspace=<workspace>, a kit option before the verb, is kept in the calls with the rest
workspace=''
if [[ "${1:-}" == --workspace=* ]]
then
  workspace=$1
  shift
fi

case "${1:-}" in
  (root)
    printf '%s\n' "${FAKE_WELCOME_ROOT:-${here}/release}"
    ;;
  (welcome)
    [[ -z "${FAKE_WELCOME_CALLS:-}" ]] || printf '%s\n' "${workspace:+${workspace} }$*" >> "${FAKE_WELCOME_CALLS}"
    case "${2:-}" in
      (--checks)
        [[ -z "${FAKE_WELCOME_SLOW:-}" ]] || sleep 5
        [[ " $* " != *' --progress '* ]] || printf '⏳ checking tool-jq\n⏳ checked\n' >&2
        if [[ -n "${FAKE_WELCOME_REFUSE:-}" ]]
        then
          echo "❌ kit welcome refuses for the test; run: kit help welcome" >&2
          exit 2
        fi
        fixed=$(cat "${state}" 2>/dev/null || true)
        # a fix's JSON string, escaped quotes and all
        fix_value='"fix": "([^"\\]|\\.)*"'
        while IFS= read -r line
        do
          for id in ${fixed}
          do
            [[ "${line}" == *"\"id\": \"${id}\""* ]] || continue
            line=${line/\"ok\": false/\"ok\": true}
            [[ ! "${line}" =~ ${fix_value} ]] || line=${line/"${BASH_REMATCH[0]}"/\"fix\": null}
          done
          printf '%s\n' "${line}"
        done < "$([[ -f checks.json ]] && echo checks.json || echo "${here}/checks.json")"
        ;;
      (--keep=*)
        id=${2#--keep=}
        if [[ "${id}" == "${FAKE_WELCOME_REFUSE_KEEP:-}" ]]
        then
          echo "❌ ${id} is not a finding of a terminal" >&2
          exit 2
        fi
        printf '%s\n' "${id}" >> "${state}"
        if [[ -n "${FAKE_WELCOME_KEPT:-}" ]]
        then
          printf '%s\n' "${FAKE_WELCOME_KEPT}"
        else
          checks=$([[ -f checks.json ]] && echo checks.json || echo "${here}/checks.json")
          grep --fixed-strings "\"id\": \"${id}\"" "${checks}" \
            | sed -e 's/"ok": false/"ok": true/' -e 's/"line": "/"line": "kept: /' -e 's/},$/}/'
        fi
        ;;
      (--fix=?*)
        id=${2#--fix=}
        if [[ "${id}" == "${FAKE_WELCOME_REFUSE_FIX:-}" ]]
        then
          echo "❌ kit welcome --fix=${id} refuses for the test" >&2
          exit 2
        fi
        case "${id}" in
          (jq | toolchain-project | kit-installed | hooks-installed) printf '%s\n' "${id}" >> "${state}" ;;
          (gh-auth) exit 1 ;;
          (brew-path)
            echo "❌ kit welcome --fix=brew-path: it is shown, not run" >&2
            exit 2
            ;;
          (*)
            echo "❌ kit welcome --fix=${id}: no fix for it" >&2
            exit 2
        esac
        ;;
      (*)
        echo "❌ kit welcome: the fake answers --checks and --fix" >&2
        exit 2
    esac
    ;;
  (*)
    echo "❌ no kit verb '${1:-}' in the welcome fake" >&2
    exit 2
esac

