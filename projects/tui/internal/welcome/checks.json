{
  "stages": [
    {
      "stage": "welcome/checks", "record": "a failed check",
      "fields": [
        {"id": "order", "label": "#", "type": "number", "path": "the check's place, in the order of its step", "sort": true,
         "renderings": ["text"], "dim": true, "right": true, "placement": "hidden"},
        {"id": "check", "label": "check", "type": "text", "path": ".line", "sort": true, "renderings": ["text"],
         "wrap": true, "placement": "column"},
        {"id": "fix", "label": "fix", "one": "fix", "type": "enum", "path": ".fix", "null": "no fix", "sort": true,
         "group": true, "filter": true, "renderings": ["text"], "width": "whole", "placement": "column"},
        {"id": "folder", "label": "folder", "type": "enum", "path": ".repository, .folder, .branch", "sort": true,
         "group": true, "filter": true, "renderings": ["text"], "dim": true, "width": "whole", "placement": "column"},
        {"id": "step", "label": "step", "type": "enum", "path": ".step", "order": "given", "group": true,
         "filter": true, "renderings": ["text"], "width": "whole", "placement": "column"},
        {"id": "note", "label": "note", "type": "text", "path": "what the fix's run said",
         "renderings": ["text"], "dim": true, "placement": "column"}
      ],
      "presets": [
        {"name": "Default", "fields": {"fix": {"placement": "group", "depth": 1},
                                       "order": {"sort": "asc", "priority": 1}}},
        {"name": "By folder", "fields": {"folder": {"placement": "group", "depth": 1},
                                         "order": {"sort": "asc", "priority": 1}}},
        {"name": "By step", "fields": {"step": {"placement": "group", "depth": 1},
                                       "order": {"sort": "asc", "priority": 1}}},
        {"name": "Flat", "fields": {"order": {"sort": "asc", "priority": 1}}}
      ]
    }
  ]
}
