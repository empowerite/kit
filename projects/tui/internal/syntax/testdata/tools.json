{
  "verb": "tools",
  "purpose": "lists, installs, and updates what the chosen toolchain and the dependencies pin",
  "usage": [
    "kit tools [--outdated [--check]] [--toolchain=<name>] [--json | --jq]",
    "kit tools [--toolchain=<name>] (install | update | path | run <command>…)"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "outdated",
              "repeat": false
            },
            {
              "kind": "group",
              "optional": true,
              "alternatives": [
                [
                  {
                    "kind": "flag",
                    "name": "check",
                    "repeat": false
                  }
                ]
              ],
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "option",
              "name": "toolchain",
              "value": "name",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "json",
              "repeat": false
            }
          ],
          [
            {
              "kind": "flag",
              "name": "jq",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ],
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "option",
              "name": "toolchain",
              "value": "name",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": false,
        "alternatives": [
          [
            {
              "kind": "literal",
              "name": "install",
              "repeat": false
            }
          ],
          [
            {
              "kind": "literal",
              "name": "update",
              "repeat": false
            }
          ],
          [
            {
              "kind": "literal",
              "name": "path",
              "repeat": false
            }
          ],
          [
            {
              "kind": "literal",
              "name": "run",
              "repeat": false
            },
            {
              "kind": "operand",
              "name": "command",
              "repeat": true
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "--outdated": {
      "description": "only the tools behind their latest version; reaches the network"
    },
    "--check": {
      "description": "with --outdated: fails when any tool is behind"
    },
    "--toolchain": {
      "description": "uses this toolchain for the run, as KIT_TOOLCHAIN does; kit takes it even after run's command"
    },
    "<name>": {
      "description": "mise, nix, brew, docker, devcontainer, or ambient"
    },
    "--json": {
      "description": "one JSON object per tool: name, pinned, installed, latest with --outdated, and from"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "install": {
      "description": "installs every pinned tool, then every package; ambient, names what else to install"
    },
    "update": {
      "description": "moves every tool and package to its latest, and rewrites the pins"
    },
    "path": {
      "description": "prints the directories that put the tools first on PATH, then the packages'"
    },
    "run": {
      "description": "runs the command with the tools, or in their container"
    },
    "<command>": {
      "description": "the command and its arguments, as typed, dash-words included"
    }
  }
}
