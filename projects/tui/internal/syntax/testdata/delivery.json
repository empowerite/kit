  "arguments": {
    "--text": {
      "description": "prints the stages as text, even on a terminal"
    },
    "--json": {
      "description": "the stages as one JSON object: stages, then each stage's document under its name, null for one that could not be read"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--stages": {
      "description": "prints the stages, one per line, in order, the same over any workspace"
    },
    "--marks": {
      "description": "prints a mark per stage, as one JSON object, which changes when what the stage draws does: the forge's own mark of its runs, as a run makes each; environments' and deployments' also hold the forge's mark of their own kind, as another tool may deploy and a person may edit one"
    },
    "artifacts": {
      "description": "the artifacts the runs kept, the newest 100 at most"
    },
    "environments": {
      "description": "the deployment environments, each with what guards it"
    },
    "deployments": {
      "description": "the deployments, the newest 50 at most"
    },
    "releases": {
      "description": "a tab kit flow prints; on a terminal it opens in kittui, and with a form it is refused"
    },
    "builds": {
      "description": "a tab kit flow prints; on a terminal it opens in kittui, and with a form it is refused"
