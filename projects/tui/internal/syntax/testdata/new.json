        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "option",
              "wildcard": true,
              "name": "hole",
              "value": "value",
              "repeat": false
            }
          ]
        ],
        "repeat": true
      }
    ],
    [
      {
        "kind": "literal",
