  "arguments": {
    "file": {
      "description": "makes a file from a template"
    },
    "kind": {
      "description": "makes a kind of file"
    },
    "rule": {
      "description": "makes a rule for a kind"
    },
    "style": {
      "description": "makes a style for a kind"
    },
    "package": {
      "description": "makes a package of the repository's own"
    },
    "template": {
      "description": "makes a template, listed in its package's rule or style"
    },
    "module": {
      "description": "makes a bash module, or a jq module with --jq"
    },
    "provider": {
      "description": "makes a provider of a seam"
    },
    "verb": {
      "description": "makes a verb of the kit"
    },
    "issue": {
      "description": "opens the page that files a new issue in a tracker"
    },
    "<path>": {
      "description": "the new file, relative to the repository root"
    },
    "--rule": {
      "description": "the rule whose template to use",
      "choices": "closed"
    },
    "--variant": {
      "description": "the template to use",
      "choices": "closed"
    },
    "--<hole>": {
      "description": "the value of a hole, «name», in the template"
    },
    "<name>": {
      "description": "the name: lowercase letters, digits, and dashes"
    },
    "<kind>": {
      "description": "the kind a rule or a style governs"
    },
    "<rule>": {
      "description": "the rule or style whose template it is"
    },
    "<variant>": {
      "description": "the template's name, which kit new file --variant= takes"
    },
    "<seam>": {
      "description": "the seam the provider answers: dependencies, forge, policy, toolchain, or tracker"
    },
    "--package": {
      "description": "the package to put it in"
    },
    "--path": {
      "description": "a glob the kind's paths match; ** matches any depth"
    },
    "--content": {
      "description": "an extended regular expression the first line matches"
    },
    "--kinds": {
      "description": "a kind this kind is made of; several repeat it, or join with :, --kinds=a:b"
    },
    "--embeds": {
      "description": "a kind whose text appears inside this kind's files; several repeat it, or join with :"
    },
    "--lint": {
      "description": "the linter kit lint runs over the files"
    },
    "--description": {
      "description": "the package's one line, which kit packages shows"
    },
    "--depends": {
      "description": "a package this one depends on, beside kit; several repeat it, or join with :"
    },
    "--from": {
      "description": "a file to start the template from"
    },
    "--purpose": {
      "description": "what the module or verb does, for its banner"
    },
    "--jq": {
      "description": "makes a jq module, with its tests"
    },
    "--group": {
      "description": "the heading kit help lists the verb under"
    },
    "<prefix>": {
      "description": "the tracker, by the prefix its references start with: # for the forge's own"
    },
    "--print": {
      "description": "prints the page's URL, opening nothing"
    },
    "--list": {
      "description": "lists the trackers a new issue can be filed in, and each one's page"
    },
    "--json": {
      "description": "prints the list as JSON: an array of {prefix, provider, label, url, error}"
    }
  },
  "extends": true
}
