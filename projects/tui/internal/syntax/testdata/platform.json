{
  "verb": "platform",
  "purpose": "lists the services, toolchains, tools, and settings kit runs with",
  "usage": [
    "kit platform [--text | --json | --jq]",
    "kit platform --stages",
    "kit platform --marks",
    "kit platform services [--text | --json | --jq]",
    "kit platform toolchains [--text | --json | --jq]",
    "kit platform tools [--text | --json | --jq]",
    "kit platform settings [--text | --json | --jq]"
  ],
