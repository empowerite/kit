  ],
  "arguments": {
    "--text": {
      "description": "prints the stages as text, even on a terminal"
    },
    "--json": {
      "description": "the stages as one JSON object: stages, then each stage's document under its name, null for one that could not be read"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--stages": {
      "description": "prints the stages, one per line, in order, the same over any workspace"
    },
    "--marks": {
      "description": "prints a mark per stage, as one JSON object, which changes when what the stage draws does: a hash of kit.yml for settings; for toolchains and tools, of the files the toolchains and the dependency providers pin from and of those that keep kit's choice; and for services, of all of those, the clone's git configuration, which holds its remotes, and .kit/policy"
    },
    "services": {
      "description": "each capability kit fills and the service that answers it: hosting, review, ci, and releases, the primary's forge; tracking, each tracker prefix; the project's tool manager; each dependency provider whose manifest and lock are here; and the policy engine"
    },
    "toolchains": {
      "description": "each toolchain kit can use, one row for each role it fills, as kit toolchains lists them"
    },
    "tools": {
      "description": "each tool the chosen toolchain and the dependency providers pin, as kit tools lists them"
    },
    "settings": {
      "description": "each key the settings schema names: the value kit.yml sets, or the schema's default"
    }
  }
