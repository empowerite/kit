  "arguments": {
    "--text": {
      "description": "prints the stages as text, even on a terminal"
    },
    "--json": {
      "description": "the stages as one JSON object: stages, then each stage's document under its name, null for one that could not be read"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--stages": {
      "description": "prints the stages, one per line, in order, the same over any workspace"
    },
    "--marks": {
      "description": "prints a mark per stage, as one JSON object: null for each, as each is read again only on Refresh, kittui offering no Watch for a tab kit never marks"
    },
    "people": {
      "description": "who has access to the repository, people and bots, each with a role"
    },
    "teams": {
      "description": "the teams with access, 20 at most, each with its members, 100 at most"
    },
    "agents": {
      "description": "the bots that acted in the repository's newest commits, changes, and reviews"
