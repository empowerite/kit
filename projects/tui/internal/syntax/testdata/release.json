{
  "verb": "release",
  "purpose": "tags HEAD as a release and pushes the tag",
  "usage": [
    "kit release <version> [--lower] [--wait=<duration>]"
  ],
  "syntax": [
    [
      {
        "kind": "operand",
        "name": "version",
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "lower",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "option",
              "name": "wait",
              "value": "duration",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "<version>": {
      "description": "the version to release: 0.1.0, or 0.1.0-rc.7 for a pre-release"
    },
    "--lower": {
      "description": "confirms a version not higher than the primary remote's highest release"
    },
    "--wait": {
      "description": "then waits that long, at most, for every pull source to serve it: 30m, 2h, or 1d"
    }
  }
}
