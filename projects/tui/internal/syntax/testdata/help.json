{
  "verb": "help",
  "purpose": "prints kit's overview, a verb's page, or a group's verbs",
  "usage": [
    "kit help [--text] [<verb> | <group>]…"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "text",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "operand",
              "name": "verb",
              "repeat": false
            }
          ],
          [
            {
              "kind": "operand",
              "name": "group",
              "repeat": false
            }
          ]
        ],
        "repeat": true
      }
    ]
  ],
  "arguments": {
    "--text": {
      "description": "prints the help, even on a terminal"
    },
    "<verb>": {
      "description": "a verb's name, or its start: re matches rebase and region",
      "choices": "open"
    },
    "<group>": {
      "description": "a group's name, as kit help heads them"
    }
  }
}
