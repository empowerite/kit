  "arguments": {
    "--text": {
      "description": "prints the stages as text, even on a terminal"
    },
    "--json": {
      "description": "the stages as one JSON object: stages, then each stage's document under its name, null for one that could not be read"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--stages": {
      "description": "prints the stages, one per line, in order, the same over any workspace"
    },
    "--marks": {
      "description": "prints a mark per stage, as one JSON object: evidence's moves with the forge's runs and releases, findings' with its runs and alerts, each scanner's off or refused where it is, policy's with kit.yml and .kit/policy, enforcement's with the files its local rows read; controls and waivers have none, null, as each is read again only on Refresh, kittui offering no Watch for them"
    },
    "evidence": {
      "description": "the attestations of the 5 newest releases' assets and the 20 newest artifacts"
    },
    "findings": {
      "description": "the code scanning, Dependabot, and secret scanning alerts, open and dismissed"
    },
    "controls": {
      "description": "the rulesets and the protection that guard the default branch"
    },
    "waivers": {
      "description": "who may bypass each control, and each alert dismissed"
    },
    "policy": {
      "description": "each rule kit policy judges by, as kit policy --rules lists them"
    },
    "enforcement": {
      "description": "what binds an agent and what is advice, per harness and for the repository, in four tiers"
    }
  }
