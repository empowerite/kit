  "arguments": {
    "--no-fetch": {
      "description": "fetches nothing; incoming says so"
    },
    "--fresh": {
      "description": "reads the open issues and pull requests afresh, not the snapshot of the last minute"
    },
    "--cached": {
      "description": "with --json and a stage, prints what that stage printed last here with the same arguments, whatever its age, and reads nothing; refuses when it has printed nothing yet"
    },
    "--text": {
      "description": "prints the picture as text, even on a terminal"
    },
    "--json": {
      "description": "the picture as one JSON object, each stage under its name"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--mine": {
      "description": "only the caller's: assigned issues, and opened pull requests"
    },
    "--others": {
      "description": "everyone else's; unassigned issues included"
    },
    "--all": {
      "description": "every issue and pull request (the default); it stands alone"
    },
    "--owner": {
      "description": "only the named login's; give it once or more"
    },
    "--stages": {
      "description": "prints the stages the picture draws, one per line, in order"
    },
    "--me": {
      "description": "prints the caller's login on the primary's forge, the login --mine and --others match"
    },
    "--quota": {
      "description": "prints the caller's rate limits on the primary's forge, as one JSON array: each forge's {forge, limits}, each limit {name, limit, remaining, reset}; reading them costs a request at most. A forge without rate limits gives none, and asks nothing"
    },
    "--capabilities": {
      "description": "prints what the primary's forge can do, as one JSON object: {contract, forge, provider, features}, each feature native or none, as modules/bash/forge.sh declares them; it asks nothing"
    },
    "--marks": {
      "description": "prints a mark per stage, as one JSON object, which changes when what the stage draws does: read again, a mark that differs says the stage is stale; on GitHub, nothing changed costs no request"
    },
    "--today": {
      "description": "only the issues opened in the last 24 hours"
    },
    "<number>": {
      "description": "only these pull requests, by number or issue closed: #7"
    },
    "issues": {
      "description": "every open issue, oldest first: in the backlog, which no open pull request closes, or underway, closed by one: who works on each, and where"
    },
    "incoming": {
      "description": "what fetching every remote brought: default-branch commits, branches new and gone"
    },
    "changes": {
      "description": "the open pull requests, each with the issues it closes"
    },
    "builds": {
      "description": "the runs not owned by any pull request: the default branch, tags, schedules"
    },
    "releases": {
      "description": "the releases on the forge, newest first"
    },
    "desk": {
      "description": "no stage of kit flow: kit workspace worktrees draws the root checkout, its first row"
    },
    "worktrees": {
      "description": "no stage of kit flow: kit workspace worktrees draws the linked worktrees"
    },
    "backlog": {
      "description": "no stage of kit flow: issues lists them; on a terminal it opens issues on its Backlog preset"
    },
    "underway": {
      "description": "no stage of kit flow: issues lists them; on a terminal it opens issues on its Underway preset"
    }
  }
}
