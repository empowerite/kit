{
  "verb": "flow",
  "purpose": "shows where the work stands, from the issues to releases",
  "usage": [
    "kit flow [--no-fetch] [--fresh] [--text | --json | --jq] [--all | [--mine] [--others] [--owner=<login>…]]",
    "kit flow --stages",
    "kit flow --me",
    "kit flow --capabilities",
    "kit flow --quota",
    "kit flow --marks",
    "kit flow issues [--json | --jq] [--cached] [--fresh] [--today] [--all | [--mine] [--others] [--owner=<login>…]]",
    "kit flow incoming [--no-fetch] [--json | --jq] [--cached]",
    "kit flow changes [--json | --jq] [--cached] [--fresh] [--all | [--mine] [--others] [--owner=<login>…]] [<number>…]",
    "kit flow builds [--json | --jq] [--cached]",
    "kit flow releases [--json | --jq] [--cached]",
    "kit flow desk [--text | --json | --jq]",
    "kit flow worktrees [--text | --json | --jq]",
    "kit flow backlog [--text | --json | --jq] [--fresh] [--all | [--mine] [--others] [--owner=<login>…]]",
    "kit flow underway [--text | --json | --jq] [--fresh] [--all | [--mine] [--others] [--owner=<login>…]]"
  ],
