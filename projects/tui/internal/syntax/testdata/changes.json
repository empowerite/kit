  "arguments": {
    "--text": {
      "description": "prints the stages as text, even on a terminal"
    },
    "--json": {
      "description": "the stages as one JSON object: stages, then each stage's document under its name, null for one that could not be read"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--stages": {
      "description": "prints the stages, one per line, in order, the same over any workspace"
    },
    "--marks": {
      "description": "prints a mark per stage, as one JSON object, which changes when what the stage draws does: for each, the forge's own marks of its issues, which move with its changes, and of its runs"
    },
    "--fresh": {
      "description": "reviews and checks read the open changes afresh, not the snapshot of the last minute"
    },
    "reviews": {
      "description": "each open change's reviewers: those it asks, and those who reviewed it, by login"
    },
    "checks": {
      "description": "each open change's checks: the latest run of each name on its head commit"
    },
    "merged": {
      "description": "the changes merged last, 50 at most, merged last first"
    },
    "changes": {
      "description": "a tab kit flow prints; on a terminal it opens in kittui, and with a form it is refused"
    }
