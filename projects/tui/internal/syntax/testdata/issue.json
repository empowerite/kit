{
  "verb": "issue",
  "purpose": "starts or resumes an issue",
  "usage": [
    "kit issue (<reference>… | --title <text>)"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": false,
        "alternatives": [
          [
            {
              "kind": "operand",
              "name": "reference",
              "repeat": true
            }
          ],
          [
            {
              "kind": "option",
              "inline": false,
              "name": "title",
              "value": "text",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "<reference>": {
      "description": "the issues, each named with its tracker: 7, #7, or AB#4521"
    },
    "--title": {
      "description": "creates an issue with that title, then starts it"
    }
  }
}
