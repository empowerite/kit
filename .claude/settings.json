{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "kit context --claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git rebase *)",
      "Bash(git worktree add *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git worktree remove *)",
      "Bash(git branch -D *)",
      "Bash(git checkout main *)",
      "Bash(git switch main *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
