// .kit/markdownlint.jsonc - the markdownlint configuration the markdown style's linter reads
// ----------------------------------------------------------------------------------------------------------------------
// Delivered by kit's style-markdown package, not edited by hand. A change is a new release, then kit update. The
// markdown style, .kit/style/markdown.md, is the convention; each setting here is one of its lines the linter can hold.

{
  // MD003 heading-style: ATX headings.
  "MD003": { "style": "atx" },

  // MD013 line-length: prose wraps at 118, 120 being the ceiling; code and tables do not wrap (§Layout 1 and 3).
  "MD013": { "line_length": 120, "code_blocks": false, "tables": false },

  // MD041 first-line-heading: a delivered file opens with its notice, and AGENTS.md with the sentence a harness
  // reads first, as the markdown rule says.
  "MD041": false,

  // MD060 table-column-style: tables use " | " with spaces around each pipe (§Layout 5); the check is stricter
  // than the style and is off.
  "MD060": false
}
