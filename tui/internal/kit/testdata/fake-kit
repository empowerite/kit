#!/usr/bin/env bash
# fake-kit - stands in for kit in the runner's tests: answers syntax and help, and records any other call (test helper)
# ----------------------------------------------------------------------------------------------------------------------
#
# The syntax answers come from the syntax package's fixtures; help is a fixed page; any other verb's arguments and
# working directory are written to the file FAKE_KIT_RECORD names, for the exec test to read.

set -o errexit -o nounset -o pipefail

here=$(cd "$(dirname "$0")" && pwd)
fixtures=${here}/../../syntax/testdata

case "${1:-}" in
  (syntax)
    shift
    if [[ "${1:-}" == --list ]]
    then
      printf 'check\tcompares the repository with the release\n'
      printf 'commit\tcommits what is staged, after the checks a commit'"'"'s rule requires\n'
      printf 'context\tprints the rules that govern a file\n'
      printf 'tui\truns the interactive terminal UI\n'
      printf 'version\tprints this release'"'"'s version\n'
    elif (( $# == 0 ))
    then
      printf '['
      cat "${fixtures}/commit.json"
      printf ','
      cat "${fixtures}/version.json"
      printf ']\n'
    elif [[ "${2:-}" == --choices ]]
    then
      verb=$1 key=$3
      shift 3
      [[ "${1:-}" != -- ]] || shift
      [[ -z "${FAKE_KIT_CALLS:-}" ]] || printf 'choices %s %s %s\n' "${verb}" "${key}" "$*" >> "${FAKE_KIT_CALLS}"
      if [[ -n "${FAKE_KIT_ROWS:-}" ]]
      then
        printf 'docs/guide.md\t\t\t\n'
        for (( i = 1; i < FAKE_KIT_ROWS; i++ ))
        do
          printf 'src/file-%d.go\t\t\t\n' "${i}"
        done
        exit 0
      fi
      printf 'a\tthe first\tactive\t\n'
      printf 'b\t\tactive\tb: kept, c depend(s) on it\n'
      printf 'answers\t%s %s %s\t\t\n' "${verb}" "${key}" "$*"
    elif [[ "${2:-}" == --match ]]
    then
      shift 2
      [[ "${1:-}" != -- ]] || shift
      printf '{"status": 0, "literals": [], "operands": ["x"], "options": {"--message": ["%s"]}, "values": {"--message": ["%s"], "<path>": ["x"]}}\n' "$*" "$*"
    elif [[ "${2:-}" == --extend ]]
    then
      shift 2
      [[ "${1:-}" != -- ]] || shift
      if (( $# == 0 ))
      then
        printf '{}\n'
      else
        printf '{"--title": {"description": "the title", "extended": true}, "--purpose": {"description": "", "extended": true}}\n'
      fi
    elif [[ -f "${fixtures}/$1.json" ]]
    then
      cat "${fixtures}/$1.json"
    else
      echo "❌ no kit verb '$1'; run: kit help" >&2
      exit 2
    fi
    ;;
  (help)
    printf 'kit %s - a purpose for the test\n\nUsage\n  kit %s\n\nDescription\n  Does it.\n' "$2" "$2"
    ;;
  (*)
    printf '%s\n' "$*" > "${FAKE_KIT_RECORD:?}"
    pwd -P >> "${FAKE_KIT_RECORD}"
esac

