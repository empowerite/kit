{
  "verb": "policy",
  "purpose": "refuses a branch, subject, or title the policy forbids",
  "usage": [
    "kit policy [--input | --facts=<file>]"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "input",
              "repeat": false
            }
          ],
          [
            {
              "kind": "option",
              "inline": true,
              "name": "facts",
              "value": "file",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "--input": {
      "description": "prints the facts as JSON instead of judging them"
    },
    "--facts": {
      "description": "judges the facts document in <file>, and gathers nothing; for testing a rule against a fixture"
    }
  }
}
