  "arguments": {
    "file": {
      "description": "makes a file from a template"
    },
    "kind": {
      "description": "makes a kind of file"
    },
    "rule": {
      "description": "makes a rule for a kind"
    },
    "style": {
      "description": "makes a style for a kind"
    },
    "package": {
      "description": "makes a package of the repository's own"
    },
    "template": {
      "description": "makes a template, and lists it in its package's rule or style"
    },
    "module": {
      "description": "makes a bash module, or a jq module with --jq"
    },
    "provider": {
      "description": "makes a provider of a seam: forge, policy, toolchain, or tracker"
    },
    "verb": {
      "description": "makes a verb of the kit"
    },
    "<path>": {
      "description": "the new file, relative to the repository root wherever the command runs. An absolute path inside the repository is accepted. A path outside it is refused."
    },
    "--rule": {
      "description": "the rule whose template to use. Default: the most specific rule that governs the path and has templates. A script with no extension needs this flag.",
      "choices": "closed"
    },
    "--variant": {
      "description": "the template to use. Default: the first variant the rule lists that the path allows.",
      "choices": "closed"
    },
    "--<hole>": {
      "description": "the value of a hole («name») within a line of the template. The holes path, name, and stem default to values taken from the path. Every other hole needs its flag."
    },
    "<name>": {
      "description": "the name of the kind, package, module, provider, or verb: lowercase letters, digits, and dashes, a package's or a module's with / between its parts"
    },
    "<kind>": {
      "description": "the kind a rule or a style governs"
    },
    "<rule>": {
      "description": "the rule or style whose template it is, which names the directory under .kit/templates/"
    },
    "<variant>": {
      "description": "the template's name, which kit new file --variant= takes"
    },
    "<seam>": {
      "description": "the seam the provider answers: forge, policy, toolchain, or tracker"
    },
    "--package": {
      "description": "the package to put it in. Default: the repository's one package under .kit/packages/, or else local"
    },
    "--path": {
      "description": "a glob a path of the kind matches; ** matches any depth"
    },
    "--content": {
      "description": "an extended regular expression the first line of a file of the kind matches"
    },
    "--kinds": {
      "description": "a kind this kind is made of"
    },
    "--embeds": {
      "description": "a kind whose text appears inside this kind's files"
    },
    "--lint": {
      "description": "the linter kit lint runs over the files the rule or style governs"
    },
    "--description": {
      "description": "the package's one line, which kit packages shows"
    },
    "--depends": {
      "description": "a package this one depends on, beside kit"
    },
    "--from": {
      "description": "a file to start the template from; without it the template is one body hole"
    },
    "--purpose": {
      "description": "what the module or verb does, in the indicative, for its banner"
    },
    "--jq": {
      "description": "makes a jq module, with its tests, in place of a bash module"
    },
    "--group": {
      "description": "the heading kit help lists the verb under: workflow, files, checks, installation, interfaces, or help"
    }
  },
  "extends": true
}
