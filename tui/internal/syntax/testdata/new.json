{
  "verb": "new",
  "purpose": "makes a new file, or a kind, rule, style, package, template, module, provider, or verb",
  "usage": [
    "kit new file <path> [--rule=<rule>] [--variant=<variant>] [--<hole>=<value>]…",
    "kit new kind <name> [--path=<glob>…] [--content=<regex>…] [--kinds=<kind>…] [--embeds=<kind>…] [--package=<name>]",
    "kit new rule <kind> [--lint=<command>] [--package=<name>]",
    "kit new style <kind> [--lint=<command>] [--package=<name>]",
    "kit new package <name> [--description=<text>] [--depends=<package>…]",
    "kit new template <rule> <variant> [--from=<path>] [--package=<name>]",
    "kit new module <name> --purpose=<text> [--jq]",
    "kit new provider <seam> <name>",
    "kit new verb <name> --purpose=<text> --group=<group>"
  ],
