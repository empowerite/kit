{
  "verb": "kinds",
  "purpose": "lists the kinds of file the repository defines, and what makes a path of each",
  "usage": [
    "kit kinds [--json | --jq] [<kind>…]"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "json",
              "repeat": false
            }
          ],
          [
            {
              "kind": "flag",
              "name": "jq",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "operand",
              "name": "kind",
              "repeat": true
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "--json": {
      "description": "prints one JSON object per kind instead: name, file, paths, content, kinds, and embeds"
    },
    "--jq": {
      "description": "prints the same JSON as --json, formatted by jq for a person to read"
    },
    "<kind>": {
      "description": "only the kinds with these names"
    }
  }
}
