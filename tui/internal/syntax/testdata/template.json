{
  "verb": "template",
  "purpose": "rewrites a template's holes typed in ASCII into the language's guillemets",
  "usage": [
    "kit template fix <path>…"
  ],
  "syntax": [
    [
      {
        "kind": "literal",
        "name": "fix",
        "repeat": false
      },
      {
        "kind": "operand",
        "name": "path",
        "repeat": true
      }
    ]
  ],
  "arguments": {
    "fix": {
      "description": "rewrites the ASCII holes in each file"
    },
    "<path>": {
      "description": "the template files to rewrite"
    }
  }
}
