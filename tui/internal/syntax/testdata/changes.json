{
  "verb": "changes",
  "purpose": "lists the open changes, each with the issues it closes, as kit status draws them",
  "usage": [
    "kit changes [--json | --jq] [--all | [--mine] [--others] [--owner=<login>…]] [<number>…]"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "json",
              "repeat": false
            }
          ],
          [
            {
              "kind": "flag",
              "name": "jq",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "all",
              "repeat": false
            }
          ],
          [
            {
              "kind": "group",
              "optional": true,
              "alternatives": [
                [
                  {
                    "kind": "flag",
                    "name": "mine",
                    "repeat": false
                  }
                ]
              ],
              "repeat": false
            },
            {
              "kind": "group",
              "optional": true,
              "alternatives": [
                [
                  {
                    "kind": "flag",
                    "name": "others",
                    "repeat": false
                  }
                ]
              ],
              "repeat": false
            },
            {
              "kind": "group",
              "optional": true,
              "alternatives": [
                [
                  {
                    "kind": "option",
                    "inline": true,
                    "name": "owner",
                    "value": "login",
                    "repeat": true
                  }
                ]
              ],
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "operand",
              "name": "number",
              "repeat": true
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "--json": {
      "description": "prints the same facts as one JSON array, one document per change with its issues under closes"
    },
    "--jq": {
      "description": "prints the same JSON as --json, formatted by jq for a person to read"
    },
    "--mine": {
      "description": "the changes the caller opened; alone, without the author column"
    },
    "--others": {
      "description": "the changes anyone but the caller opened"
    },
    "--all": {
      "description": "every open change (the default); it stands alone"
    },
    "--owner": {
      "description": "the changes the named author opened; give it once or more. The three filters combine: --mine --owner=bob shows the caller's and bob's"
    },
    "<number>": {
      "description": "only the changes numbered so, or that close an issue numbered so, each with or without its #: 7 or #7, since # starts a comment in many shells"
    }
  }
}
