{
  "verb": "install",
  "purpose": "mirrors the release into the repository and the home directory",
  "usage": [
    "kit install [<package>…]"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "operand",
              "name": "package",
              "repeat": true
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "<package>": {
      "description": "more packages to activate, by name or glob such as 'style/*'",
      "choices": "closed"
    }
  }
}
