    "kit status --stages",
    "kit status backlog [--json | --jq] [--today] [--all | [--mine] [--others] [--owner=<login>…]]",
    "kit status incoming [--no-fetch] [--json | --jq]",
    "kit status desk [--json | --jq]",
    "kit status worktrees [--json | --jq]",
    "kit status changes [--json | --jq] [--all | [--mine] [--others] [--owner=<login>…]] [<number>…]",
    "kit status releases [--json | --jq]"
