  "arguments": {
    "--no-fetch": {
      "description": "skips the git fetch; incoming says so"
    },
    "--text": {
      "description": "prints the picture as text, even on a terminal"
    },
    "--json": {
      "description": "the picture as one JSON object, each stage under its name"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--mine": {
      "description": "only the caller's: assigned issues, and opened pull requests"
    },
    "--others": {
      "description": "everyone else's; unassigned issues included"
    },
    "--all": {
      "description": "every issue and pull request (the default); it stands alone"
    },
    "--owner": {
      "description": "only the named login's; give it once or more"
    },
    "--stages": {
      "description": "prints the stages the picture draws, one per line, in order"
    },
    "--today": {
      "description": "only the issues opened in the last 24 hours"
    },
    "<number>": {
      "description": "only these pull requests, by number or issue closed: #7"
    },
    "backlog": {
      "description": "the open issues no pull request closes, oldest first"
    },
    "incoming": {
      "description": "what the fetch brought: default-branch commits, branches new and gone"
    },
    "desk": {
      "description": "the root checkout: branch, ahead and behind, uncommitted paths"
    },
    "worktrees": {
      "description": "every linked worktree: branch, ahead and behind, uncommitted paths"
    },
    "changes": {
      "description": "the open pull requests, each with the issues it closes"
    },
    "releases": {
      "description": "the releases on the forge, newest first"
    }
  }
}
