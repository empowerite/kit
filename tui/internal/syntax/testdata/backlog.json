{
  "verb": "backlog",
  "purpose": "lists the open issues nothing is in flight for, oldest first",
  "usage": [
    "kit backlog [--json] [--today] [--all | [--mine] [--others] [--owner=<login>…]]"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "json",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "today",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "all",
              "repeat": false
            }
          ],
          [
            {
              "kind": "group",
              "optional": true,
              "alternatives": [
                [
                  {
                    "kind": "flag",
                    "name": "mine",
                    "repeat": false
                  }
                ]
              ],
              "repeat": false
            },
            {
              "kind": "group",
              "optional": true,
              "alternatives": [
                [
                  {
                    "kind": "flag",
                    "name": "others",
                    "repeat": false
                  }
                ]
              ],
              "repeat": false
            },
            {
              "kind": "group",
              "optional": true,
              "alternatives": [
                [
                  {
                    "kind": "option",
                    "inline": true,
                    "name": "owner",
                    "value": "login",
                    "repeat": true
                  }
                ]
              ],
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "--json": {
      "description": "prints the same facts as one JSON array; each issue carries branch, a name or null"
    },
    "--today": {
      "description": "only the issues opened in the last 24 hours; combines with the flags below"
    },
    "--mine": {
      "description": "the issues assigned to the caller; alone, without the assignee column"
    },
    "--others": {
      "description": "the issues not assigned to the caller, unassigned ones included"
    },
    "--all": {
      "description": "every open issue no change closes (the default); it stands alone"
    },
    "--owner": {
      "description": "the issues assigned to the named login; give it once or more. The three filters combine: --mine --owner=bob lists the caller's and bob's"
    }
  }
}
