#!/usr/bin/env bash
# fake-kit - stands in for kit in the status tests: answers status --stages and status <stage> --json (test helper)
# ----------------------------------------------------------------------------------------------------------------------
#
# Each stage's JSON is the fixture beside this file, <stage>.json. FAKE_STATUS_CALLS names a file every call's words
# are appended to, one line each, so a test reads the order the stages ran in. FAKE_STATUS_STAGES is what --stages
# prints, space-separated; unset, it prints the eight. FAKE_STATUS_REFUSE names a stage whose --json answer is a
# refusal, exit 1, or stages to refuse --stages with exit 2. FAKE_STATUS_SILENT names a stage that exits 1 with
# nothing on stderr. FAKE_STATUS_SLOW names a stage that sleeps five seconds before it answers. FAKE_STATUS_ABOVE
# names a stage that answers as kit does above repositories: an array of {path, status}, one per desk. With
# --no-fetch, incoming answers incoming-no-fetch.json: fetched false, and the remotes without what a fetch brings.

set -o errexit -o nounset -o pipefail

here=$(cd "$(dirname "$0")" && pwd)
[[ -z "${FAKE_STATUS_CALLS:-}" ]] || printf '%s\n' "$*" >> "${FAKE_STATUS_CALLS}"

if [[ "${1:-}" != status ]]
then
  echo "❌ no kit verb '${1:-}'; run: kit help" >&2
  exit 2
fi
shift

case "${1:-}" in
  (--stages)
    if [[ "${FAKE_STATUS_REFUSE:-}" == stages ]]
    then
      echo "❌ kit status refuses for the test; run: kit help status" >&2
      exit 2
    fi
    for stage in ${FAKE_STATUS_STAGES-backlog underway incoming desk worktrees changes builds releases}
    do
      printf '%s\n' "${stage}"
    done
    ;;
  (backlog | underway | incoming | desk | worktrees | changes | builds | releases)
    stage=$1
    shift
    if [[ "${1:-}" != --json ]]
    then
      echo "❌ kit status ${stage} takes --json in the test; run: kit help status" >&2
      exit 2
    fi
    shift
    if [[ "${FAKE_STATUS_REFUSE:-}" == "${stage}" ]]
    then
      echo "❌ kit status ${stage}: the forge cannot be read; run: kit help status" >&2
      exit 1
    fi
    [[ "${FAKE_STATUS_SILENT:-}" != "${stage}" ]] || exit 1
    [[ "${FAKE_STATUS_SLOW:-}" != "${stage}" ]] || sleep 5
    if [[ "${FAKE_STATUS_ABOVE:-}" == "${stage}" ]]
    then
      printf '[{"path": "kit", "status": %s}, {"path": "jig", "status": null}]\n' "$(cat "${here}/${stage}.json")"
    elif [[ "${stage}" == incoming && " $* " == *" --no-fetch "* ]]
    then
      cat "${here}/incoming-no-fetch.json"
    else
      cat "${here}/${stage}.json"
    fi
    ;;
  (*)
    echo "❌ kit status: no stage '${1:-}'; run: kit help status" >&2
    exit 2
esac

# ----------------------------------------------------------------------------------------------------------------------
