#!/usr/bin/env bash
# ci - this repository's gate: kit lint, the schemas, the links, bats, kit check
# ----------------------------------------------------------------------------------------------------------------------
#
# The gate setting in .kit/settings.yml names this script, so kit gate runs it, with the toolchain's tools on PATH,
# and kit ci runs it in CI. It runs, in order:
#
#   - kit lint over every tracked path
#   - ajv: every module.yml and .kit/settings.yml against its schema
#   - lychee: every link in the markdown, offline, including fragments
#   - the bats suite
#   - kit/bin/kit check over this repository's installed copy of its own kit
#
# The pre-commit hook is a faster check over the staged paths only.
#
#   kit gate

set -o errexit -o nounset -o pipefail

cd "$(git rev-parse --show-toplevel)"
kit/bin/kit lint --all-files
ajv validate --spec=draft2020 -s kit/modules/module.schema.json -d 'kit/modules/*/module.yml'
ajv validate --spec=draft2020 -s .kit/settings.schema.json -d .kit/settings.yml
lychee --offline --include-fragments --no-progress README.md AGENTS.md docs kit/modules .kit
bats --timing --print-output-on-failure tests/
kit/bin/kit check
echo "✅ ci passed"

# ----------------------------------------------------------------------------------------------------------------------
