            "displayName": "Build",
            "url": null
          },
          "settings": {
            "buildDefinitionId": 1,
            "displayName": null
          }
        },
        "context": {
          "buildId": 103,
          "buildDefinitionId": 1,
          "buildDefinitionName": "a"
        },
        "startedDate": "2026-10-01T10:00:00.120000+00:00",
        "completedDate": "2026-10-01T10:00:30+00:00"
      },
      {
        "evaluationId": "7c6f3d2b-4a5e-4f9c-8b0d-1e2f3a4b5c6d",
