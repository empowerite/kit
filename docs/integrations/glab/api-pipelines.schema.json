{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "glab api projects/${project}/pipelines?per_page=${n}",
  "description": "The project's newest pipelines, ${project} its path URL-encoded: 50, which kit draws as the builds stage's runs in `modules/bash/forge/gitlab.sh` (forge/gitlab:runs, with `modules/jq/forge.jq` forge::gitlab_builds), and 10, whose id, status, and updated_at make a mark (forge/gitlab:marks, with forge::gitlab_marks). The types are APIEntitiesCiPipelineBasic of GET /api/v4/projects/{id}/pipelines in GitLab's REST OpenAPI, https://gitlab.com/gitlab-org/gitlab/-/raw/master/doc/api/openapi/openapi_v3.yaml, with name, and the status's values, from https://docs.gitlab.com/api/pipelines/; started_at, finished_at, and tag, which kit reads when given, are a single pipeline's, not the list's.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "iid": {
        "type": "integer",
        "description": "The pipeline's number in its project."
      },
      "name": {
        "type": ["string", "null"],
        "description": "The pipeline's name, null unless the project's CI file gives one."
      },
      "ref": {
        "type": "string",
        "description": "The branch or tag the pipeline runs for."
      },
      "sha": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "description": "What started the pipeline, as CI_PIPELINE_SOURCE names it: push, web, schedule, merge_request_event, api, trigger, and others."
      },
      "status": {
        "type": "string",
        "enum": [
          "created",
          "waiting_for_resource",
          "preparing",
          "waiting_for_callback",
          "pending",
          "running",
          "success",
          "failed",
          "canceling",
          "canceled",
          "skipped",
          "manual",
          "scheduled"
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      },
      "web_url": {
        "type": "string",
        "format": "uri"
      },
      "started_at": {
        "type": ["string", "null"],
        "format": "date-time"
      },
      "finished_at": {
        "type": ["string", "null"],
        "format": "date-time"
      },
      "tag": {
        "type": "boolean",
        "description": "Whether ref is a tag."
      }
    },
    "required": ["id", "iid", "ref", "sha", "source", "status", "created_at", "updated_at", "web_url"],
    "additionalProperties": true
  },
  "examples": [
    [
      {
        "id": 104,
        "iid": 50,
        "sha": "aaaaaaa0000000000",
        "name": "kit",
        "ref": "7-fix-the-thing",
        "source": "merge_request_event",
        "status": "success",
        "created_at": "2026-10-01T11:00:00.000Z",
        "updated_at": "2026-10-01T11:03:00.000Z",
        "web_url": "https://gl.com/p/104"
      },
      {
        "id": 103,
        "iid": 49,
        "sha": "8e817bf0000000000",
        "name": "kit",
        "ref": "main",
        "source": "push",
        "status": "success",
        "created_at": "2026-10-01T10:00:00.000Z",
        "updated_at": "2026-10-01T10:03:36.000Z",
        "web_url": "https://gl.com/p/103"
      },
      {
        "id": 102,
        "iid": 48,
        "sha": "1a2b3c40000000000",
        "name": "kit",
        "ref": "release/0.1.0",
        "source": "push",
        "status": "failed",
        "tag": true,
        "created_at": "2026-10-01T09:00:00.000Z",
        "updated_at": "2026-10-01T09:04:02.000Z",
        "web_url": "https://gl.com/p/102"
      },
      {
        "id": 101,
        "iid": 47,
        "sha": "8e817bf0000000000",
        "name": "kit",
        "ref": "main",
        "source": "schedule",
        "status": "running",
        "created_at": "2026-10-01T08:00:00.000Z",
        "updated_at": "2026-10-01T08:01:00.000Z",
        "web_url": "https://gl.com/p/101"
      },
      {
        "id": 100,
        "iid": 46,
        "sha": "bbbbbbb0000000000",
        "name": "kit",
