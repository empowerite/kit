{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gh api graphql --field owner=${owner} --field name=${name} --raw-field query=${query}",
  "description": "The repository's rulesets of branches, its own and its organization's, rulesets(first: 100, includeParents: true, targets: [BRANCH]), each with its conditions, rules(first: 100), and bypassActors(first: 100), and the default branch, which kit asks for in `modules/bash/forge/github.sh` (forge/github:controls) and folds in `modules/jq/forge.jq` (forge::github_rulesets, forge::github_bypasses); a totalCount past the nodes fails the read. A point of the GraphQL rate limit. The types are the RepositoryRuleset, RepositoryRule, and RepositoryRulesetBypassActor objects of GitHub's GraphQL schema, https://docs.github.com/public/fpt/schema.docs.graphql, introspected: enforcement is ACTIVE, EVALUATE, or DISABLED; bypassMode ALWAYS, PULL_REQUEST, or EXEMPT; actor App, EnterpriseTeam, Team, or User; Enterprise's slug needs read:enterprise, so kit asks for none. A caller who may not edit a ruleset gets its bypass actors as null nodes, checked live on cli/cli.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "repository": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "defaultBranchRef": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "rulesets": {
              "type": "object",
              "properties": {
                "totalCount": {
                  "type": "integer"
                },
                "nodes": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "databaseId": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "enforcement": {
                        "type": "string"
                      },
                      "conditions": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "refName": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "include": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "exclude": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "additionalProperties": true
                          }
                        },
                        "additionalProperties": true
                      },
                      "rules": {
                        "type": "object",
                        "properties": {
                          "totalCount": {
                            "type": "integer"
                          },
                          "nodes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string"
                                }
                              },
                              "additionalProperties": true
                            }
                          }
                        },
                        "additionalProperties": true
                      },
                      "bypassActors": {
                        "type": "object",
                        "properties": {
                          "totalCount": {
                            "type": "integer"
                          },
                          "nodes": {
                            "type": "array",
                            "items": {
                              "type": [
                                "object",
                                "null"
                              ],
                              "properties": {
                                "bypassMode": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "organizationAdmin": {
                                  "type": [
                                    "boolean",
                                    "null"
                                  ]
                                },
                                "repositoryRoleName": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "deployKey": {
                                  "type": [
                                    "boolean",
                                    "null"
                                  ]
                                },
                                "enterpriseOwner": {
                                  "type": [
                                    "boolean",
                                    "null"
                                  ]
                                },
                                "actor": {
                                  "type": [
                                    "object",
                                    "null"
                                  ],
                                  "properties": {
                                    "__typename": {
                                      "type": "string"
                                    }
                                  },
                                  "additionalProperties": true
                                }
                              },
                              "additionalProperties": true
                            }
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "data": {
        "repository": {
          "url": "https://github.com/o/r",
          "defaultBranchRef": {
            "name": "main"
          },
          "rulesets": {
            "totalCount": 1,
            "nodes": [
              {
                "databaseId": 7,
                "name": "main",
                "enforcement": "ACTIVE",
                "conditions": {
                  "refName": {
                    "include": [
                      "~DEFAULT_BRANCH"
                    ],
                    "exclude": []
                  }
                },
                "rules": {
                  "totalCount": 2,
                  "nodes": [
                    {
                      "type": "DELETION"
                    },
                    {
                      "type": "PULL_REQUEST"
                    }
                  ]
                },
                "bypassActors": {
                  "totalCount": 2,
                  "nodes": [
                    {
                      "bypassMode": "ALWAYS",
                      "organizationAdmin": false,
                      "repositoryRoleName": null,
                      "deployKey": false,
                      "enterpriseOwner": false,
                      "actor": {
                        "__typename": "Team",
                        "slug": "release"
                      }
                    },
                    null
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
